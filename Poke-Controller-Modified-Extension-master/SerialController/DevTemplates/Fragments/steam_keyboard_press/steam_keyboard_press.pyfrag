def steam_keyboard_press(
        self,
        key1='',
        key2='',
        key3='',
        key4='',
        key5='',
        duration=0.1,
        wait=0.1):
    """Windows SendInputで最大5キーをまとめて押下・解放する。

    使用例:
        self.steam_keyboard_press('left', 'up')
        self.steam_keyboard_press('ctrl', 'shift', 'a')
        self.steam_keyboard_press('w', 'a', duration=0.5)
        self.steam_keyboard_press('space')
        self.steam_keyboard_press('f12')
        self.steam_keyboard_press('@')

    複数キーは1回のSendInput呼び出しでまとめて押下し、
    duration秒後に1回のSendInput呼び出しでまとめて解放する。

    単一文字は現在のWindowsキーボード配列で変換する。
    大文字や記号にShift等が必要な場合は自動的に追加する。
    """

    class KEYBDINPUT(ctypes.Structure):
        _fields_ = [
            ('wVk', ctypes.c_ushort),
            ('wScan', ctypes.c_ushort),
            ('dwFlags', ctypes.c_ulong),
            ('time', ctypes.c_ulong),
            ('dwExtraInfo', ctypes.c_void_p),
        ]

    class INPUTUNION(ctypes.Union):
        _fields_ = [
            ('ki', KEYBDINPUT),
            ('padding', ctypes.c_ubyte * 32),
        ]

    class INPUT(ctypes.Structure):
        _anonymous_ = ('union',)
        _fields_ = [
            ('type', ctypes.c_ulong),
            ('union', INPUTUNION),
        ]

    INPUT_KEYBOARD = 1
    KEYEVENTF_EXTENDEDKEY = 0x0001
    KEYEVENTF_KEYUP = 0x0002
    KEYEVENTF_SCANCODE = 0x0008
    MAPVK_VK_TO_VSC = 0

    key_codes = {
        'backspace': 0x08,
        'bksp': 0x08,
        'tab': 0x09,
        'clear': 0x0C,
        'enter': 0x0D,
        'return': 0x0D,
        'shift': 0x10,
        'ctrl': 0x11,
        'control': 0x11,
        'alt': 0x12,
        'menu': 0x12,
        'pause': 0x13,
        'capslock': 0x14,
        'caps_lock': 0x14,
        'kana': 0x15,
        'hangul': 0x15,
        'ime_on': 0x16,
        'junja': 0x17,
        'final': 0x18,
        'hanja': 0x19,
        'kanji': 0x19,
        'ime_off': 0x1A,
        'esc': 0x1B,
        'escape': 0x1B,
        'convert': 0x1C,
        'henkan': 0x1C,
        'nonconvert': 0x1D,
        'muhenkan': 0x1D,
        'accept': 0x1E,
        'modechange': 0x1F,
        'space': 0x20,
        'spacebar': 0x20,

        'pageup': 0x21,
        'page_up': 0x21,
        'pgup': 0x21,
        'pagedown': 0x22,
        'page_down': 0x22,
        'pgdn': 0x22,
        'end': 0x23,
        'home': 0x24,
        'left': 0x25,
        'up': 0x26,
        'right': 0x27,
        'down': 0x28,
        'select': 0x29,
        'print': 0x2A,
        'execute': 0x2B,
        'printscreen': 0x2C,
        'print_screen': 0x2C,
        'snapshot': 0x2C,
        'insert': 0x2D,
        'ins': 0x2D,
        'delete': 0x2E,
        'del': 0x2E,
        'help': 0x2F,

        'lwin': 0x5B,
        'leftwin': 0x5B,
        'left_win': 0x5B,
        'win': 0x5B,
        'windows': 0x5B,
        'rwin': 0x5C,
        'rightwin': 0x5C,
        'right_win': 0x5C,
        'apps': 0x5D,
        'application': 0x5D,
        'sleep': 0x5F,

        'lshift': 0xA0,
        'leftshift': 0xA0,
        'left_shift': 0xA0,
        'rshift': 0xA1,
        'rightshift': 0xA1,
        'right_shift': 0xA1,
        'lctrl': 0xA2,
        'leftctrl': 0xA2,
        'left_ctrl': 0xA2,
        'rctrl': 0xA3,
        'rightctrl': 0xA3,
        'right_ctrl': 0xA3,
        'lalt': 0xA4,
        'leftalt': 0xA4,
        'left_alt': 0xA4,
        'ralt': 0xA5,
        'rightalt': 0xA5,
        'right_alt': 0xA5,
        'altgr': 0xA5,

        'numlock': 0x90,
        'num_lock': 0x90,
        'scrolllock': 0x91,
        'scroll_lock': 0x91,

        'multiply': 0x6A,
        'numpad_multiply': 0x6A,
        'add': 0x6B,
        'numpad_add': 0x6B,
        'separator': 0x6C,
        'subtract': 0x6D,
        'numpad_subtract': 0x6D,
        'decimal': 0x6E,
        'numpad_decimal': 0x6E,
        'divide': 0x6F,
        'numpad_divide': 0x6F,

        'browser_back': 0xA6,
        'browser_forward': 0xA7,
        'browser_refresh': 0xA8,
        'browser_stop': 0xA9,
        'browser_search': 0xAA,
        'browser_favorites': 0xAB,
        'browser_home': 0xAC,
        'volume_mute': 0xAD,
        'volume_down': 0xAE,
        'volume_up': 0xAF,
        'media_next': 0xB0,
        'media_previous': 0xB1,
        'media_prev': 0xB1,
        'media_stop': 0xB2,
        'media_play_pause': 0xB3,

        'hankaku': 0xF3,
        'hankaku_zenkaku': 0xF3,
        'zenkaku_hankaku': 0xF3,
        'eisu': 0xF0,
        'katakana': 0xF1,
        'hiragana': 0xF2,
        'katakana_hiragana': 0xF2,

        'semicolon': 0xBA,
        'plus': 0xBB,
        'comma': 0xBC,
        'minus': 0xBD,
        'period': 0xBE,
        'slash': 0xBF,
        'backquote': 0xC0,
        'grave': 0xC0,
        'leftbracket': 0xDB,
        'left_bracket': 0xDB,
        'backslash': 0xDC,
        'rightbracket': 0xDD,
        'right_bracket': 0xDD,
        'quote': 0xDE,
        'apostrophe': 0xDE,
        'oem_102': 0xE2,
    }

    for character_code in range(ord('a'), ord('z') + 1):
        character = chr(character_code)
        key_codes[character] = ord(character.upper())

    for number in range(10):
        key_codes[str(number)] = 0x30 + number
        key_codes['numpad{}'.format(number)] = 0x60 + number
        key_codes['numpad_{}'.format(number)] = 0x60 + number

    for function_number in range(1, 25):
        key_codes['f{}'.format(function_number)] = (
            0x70 + function_number - 1
        )

    extended_keys = {
        0x21,
        0x22,
        0x23,
        0x24,
        0x25,
        0x26,
        0x27,
        0x28,
        0x2D,
        0x2E,
        0x5B,
        0x5C,
        0x5D,
        0x6F,
        0x90,
        0xA3,
        0xA5,
        0xA6,
        0xA7,
        0xA8,
        0xA9,
        0xAA,
        0xAB,
        0xAC,
        0xAD,
        0xAE,
        0xAF,
        0xB0,
        0xB1,
        0xB2,
        0xB3,
    }

    requested_keys = [key1, key2, key3, key4, key5]
    requested_keys = [
        key
        for key in requested_keys
        if key is not None and str(key) != ''
    ]

    if not requested_keys:
        raise ValueError(
            '少なくとも1つのキーを指定してください。'
        )

    resolved_keys = []
    automatic_modifiers = []

    for requested_key in requested_keys:
        key_text = str(requested_key)
        normalized_key = key_text.strip().lower()

        if normalized_key in key_codes:
            virtual_key = key_codes[normalized_key]

        elif len(key_text) == 1:
            virtual_key_result = (
                ctypes.windll.user32.VkKeyScanW(ord(key_text))
            )

            if virtual_key_result == -1:
                raise ValueError(
                    '現在のキーボード配列で変換できない文字です: '
                    '{!r}'.format(key_text)
                )

            virtual_key = virtual_key_result & 0xFF
            modifier_state = (
                virtual_key_result >> 8
            ) & 0xFF

            if modifier_state & 0x01:
                automatic_modifiers.append(0x10)

            if modifier_state & 0x02:
                automatic_modifiers.append(0x11)

            if modifier_state & 0x04:
                automatic_modifiers.append(0x12)

        else:
            raise ValueError(
                '未対応のキー名です: {!r}'.format(
                    key_text
                )
            )

        resolved_keys.append(virtual_key)

    unique_modifiers = []

    for modifier_key in automatic_modifiers:
        if modifier_key not in unique_modifiers:
            unique_modifiers.append(modifier_key)

    for modifier_key in reversed(unique_modifiers):
        if modifier_key not in resolved_keys:
            resolved_keys.insert(0, modifier_key)

    unique_keys = []

    for virtual_key in resolved_keys:
        if virtual_key not in unique_keys:
            unique_keys.append(virtual_key)

    if len(unique_keys) > 5:
        raise ValueError(
            '自動追加された修飾キーを含め、'
            '同時押しは最大5キーです。'
        )

    send_input = ctypes.windll.user32.SendInput
    send_input.argtypes = (
        ctypes.c_uint,
        ctypes.POINTER(INPUT),
        ctypes.c_int,
    )
    send_input.restype = ctypes.c_uint

    map_virtual_key = ctypes.windll.user32.MapVirtualKeyW
    map_virtual_key.argtypes = (
        ctypes.c_uint,
        ctypes.c_uint,
    )
    map_virtual_key.restype = ctypes.c_uint

    key_down_inputs = (
        INPUT * len(unique_keys)
    )()

    for index, virtual_key in enumerate(unique_keys):
        scan_code = map_virtual_key(
            virtual_key,
            MAPVK_VK_TO_VSC
        )

        flags = KEYEVENTF_SCANCODE

        if virtual_key in extended_keys:
            flags |= KEYEVENTF_EXTENDEDKEY

        key_down_inputs[index].type = INPUT_KEYBOARD
        key_down_inputs[index].ki = KEYBDINPUT(
            0,
            scan_code,
            flags,
            0,
            None,
        )

    sent_count = send_input(
        len(unique_keys),
        key_down_inputs,
        ctypes.sizeof(INPUT),
    )

    if sent_count != len(unique_keys):
        raise ctypes.WinError(
            ctypes.get_last_error()
        )

    try:
        if duration > 0:
            try:
                self.wait(duration)
            except Exception:
                time.sleep(duration)

    finally:
        release_keys = list(reversed(unique_keys))
        key_up_inputs = (
            INPUT * len(release_keys)
        )()

        for index, virtual_key in enumerate(release_keys):
            scan_code = map_virtual_key(
                virtual_key,
                MAPVK_VK_TO_VSC
            )

            flags = (
                KEYEVENTF_SCANCODE |
                KEYEVENTF_KEYUP
            )

            if virtual_key in extended_keys:
                flags |= KEYEVENTF_EXTENDEDKEY

            key_up_inputs[index].type = INPUT_KEYBOARD
            key_up_inputs[index].ki = KEYBDINPUT(
                0,
                scan_code,
                flags,
                0,
                None,
            )

        released_count = send_input(
            len(release_keys),
            key_up_inputs,
            ctypes.sizeof(INPUT),
        )

        if released_count != len(release_keys):
            raise ctypes.WinError(
                ctypes.get_last_error()
            )

    if wait > 0:
        try:
            self.wait(wait)
        except Exception:
            time.sleep(wait)
