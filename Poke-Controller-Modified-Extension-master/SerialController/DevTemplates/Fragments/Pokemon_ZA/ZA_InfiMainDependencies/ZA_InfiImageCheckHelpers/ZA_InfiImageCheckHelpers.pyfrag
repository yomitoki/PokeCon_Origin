def _image_check_target(self, targetimage):
    variants = self.IMAGE_DETECTION_TARGETS.get(str(targetimage), [])
    if not hasattr(self, '_image_similarity_history'):
        self._image_similarity_history = SimilarityHistory()
    results = []
    for settings in variants:
        detect_settings = dict(settings)
        detect_settings.pop('health_ignored_warnings', None)
        output_panel = getattr(self, 'IMAGE_DETECTION_OUTPUT_PANEL', None)
        show_value = bool(detect_settings.get('show_value', False) or getattr(self, 'show_value_bool', False))
        if output_panel and show_value:
            detect_settings['show_value'] = False
        try:
            result = detect_image(
                self, name=targetimage,
                history=self._image_similarity_history,
                **detect_settings)
        except RuntimeError as error:
            if "Cameraの新しい映像を取得できません" not in str(error):
                raise
            if not getattr(self, '_camera_frame_unavailable_logged', False):
                message = "Cameraの新しい映像がないため画像検知を待機します。"
                print(message)
                logger = getattr(self, '_logger', None)
                if logger is not None:
                    logger.warning(message)
                self._camera_frame_unavailable_logged = True
            return False
        if getattr(self, '_camera_frame_unavailable_logged', False):
            logger = getattr(self, '_logger', None)
            if logger is not None:
                logger.info("Cameraの映像入力が復帰しました。画像検知を再開します。")
            self._camera_frame_unavailable_logged = False
        self.last_image_detection = result
        if output_panel and show_value:
            self.show_output(output_panel, text=("{} ZNCC value: {:.6f} / threshold: {:.6f} {}".format(
                targetimage, result['score'], result['threshold'], 'MATCH' if result['matched'] else 'NO MATCH')))
        results.append(bool(result['matched']))
    if not results:
        return False
    operator = self.IMAGE_DETECTION_OPERATORS.get(str(targetimage), 'OR')
    if str(operator).startswith('AT_LEAST_'):
        try:
            minimum_matches = int(str(operator).rsplit('_', 1)[1])
        except (TypeError, ValueError):
            minimum_matches = len(results) + 1
        return sum(bool(value) for value in results) >= minimum_matches
    return all(results) if operator == 'AND' else any(results)


def _image_check_set(self, set_name):
    settings = self.IMAGE_DETECTION_SETS[str(set_name)]
    results = []
    for member in settings.get('members', []):
        if member.get('type') == 'list':
            results.append(self._image_check_set(member['id']))
        else:
            results.append(self._image_check_target(member['id']))
    if not results:
        return False
    return all(results) if settings.get('operator', 'OR') == 'AND' else any(results)


def image_check(self, targetimage, nocheckflag=1):
    # nocheckflag=0 is the test-output skip used by existing commands.
    if nocheckflag == 0:
        return False
    if str(targetimage) in (
            "POKEMON_ZA_IN_MARKER", "POKEMON_ZA_OUT_MARKER",
            "POKEMON_ZA_CHAT_MARKER", "POKEMON_ZA_HASHIGO_ICON",
            "POKEMON_ZA_INVESTIGATE_MARKER", "POKEMON_ZA_DOOR_A",
            "POKEMON_ZA_OTHER_A_MARKER", "ZA_RESEARCH_A", "ZA_STORY_COMMON_ZA_RESEARCH_A") or str(targetimage).startswith("ZA_ACTION_PROMPT_"):
        try:
            from Commands.PythonCommands.LocalFunction import ActionPromptCheck as action_prompt
        except ModuleNotFoundError as error:
            if error.name not in ("Commands", "Commands.PythonCommands",
                                  "Commands.PythonCommands.LocalFunction",
                                  "Commands.PythonCommands.LocalFunction.ActionPromptCheck"):
                raise
            from LocalFunction import ActionPromptCheck as action_prompt
        return action_prompt.check_action_prompt(self, (str(targetimage),), count_attempt=True)
    if str(targetimage) in self.IMAGE_DETECTION_TARGETS:
        matched = bool(self._image_check_target(str(targetimage)))
    else:
        matched = bool(self.image_check_exception(targetimage))
    if matched:
        confirmation = getattr(self, 'image_check_confirmation', None)
        if callable(confirmation):
            return bool(confirmation(targetimage, first_match=True))
    return matched


def ZA_wild_zone_number_detail_check(self, targetimage, frame=None):
    """Confirm 10/18 from equal-size digit crops after the whole-card check."""
    import cv2
    import os
    try:
        import Commands.PythonCommands.LocalFunction.ImageDetection as image_detection
    except ModuleNotFoundError as error:
        if error.name not in (
                "Commands", "Commands.PythonCommands",
                "Commands.PythonCommands.LocalFunction",
                "Commands.PythonCommands.LocalFunction.ImageDetection"):
            raise
        import LocalFunction.ImageDetection as image_detection

    targets = (
        "POKEMON_ZA_MOVEPOINT_PIC_W_ZONE10",
        "POKEMON_ZA_MOVEPOINT_PIC_W_ZONE18",
    )
    # The source PNGs have different top margins. Both cutouts are 39x39
    # and contain only the two digits, with one pixel of white padding.
    digit_crops = ((169, 4, 208, 43), (168, 0, 207, 39))
    template_shapes = ((45, 208), (40, 208))
    self.last_wild_zone_number_detection = {"matched": False}
    if str(targetimage) not in targets:
        return False
    expected = targets.index(str(targetimage))
    if frame is None:
        try:
            frame = image_detection.read_command_frame(self)
        except RuntimeError:
            return False
    if (frame is None or getattr(frame, "size", 0) == 0
            or len(frame.shape) != 3 or frame.shape[2] not in (3, 4)):
        return False
    gray = cv2.cvtColor(frame[:, :, :3], cv2.COLOR_BGR2GRAY)
    serial_root = os.path.abspath(os.path.join(
        os.path.dirname(image_detection.__file__), ".."))
    if os.path.basename(serial_root) == "PythonCommands":
        serial_root = os.path.abspath(os.path.join(serial_root, "..", ".."))
    cache = getattr(self, "_za_wild_zone_number_templates", {})
    templates, settings = [], []
    for index, target in enumerate(targets):
        variants = self.IMAGE_DETECTION_TARGETS.get(target, [])
        if not variants and index != expected:
            # A composed sample may register only its requested zone.
            # The competing PNG is shipped beside it in the same bundle.
            own = self.IMAGE_DETECTION_TARGETS.get(targets[expected], [])
            if len(own) == 1:
                peer = dict(own[0])
                peer["template_path"] = os.path.join(
                    os.path.dirname(str(peer.get("template_path", ""))),
                    "W_ZONE{}_pic.png".format(10 if index == 0 else 18))
                variants = [peer]
        if len(variants) != 1:
            return False
        config = variants[0]
        # These calibrated crops belong to the original grayscale PNGs.
        if (not config.get("use_gray", True)
                or any(config.get("template_crop") or [])
                or config.get("exclude_regions")):
            return False
        path = str(config.get("template_path", ""))
        if not os.path.isabs(path):
            path = os.path.join(serial_root, path)
        try:
            stat = os.stat(path)
        except OSError:
            return False
        signature = (path, stat.st_mtime_ns, stat.st_size)
        cached = cache.get(target)
        if cached is None or cached[0] != signature:
            template = cv2.imread(path, cv2.IMREAD_GRAYSCALE)
            if template is None or template.shape != template_shapes[index]:
                return False
            x1, y1, x2, y2 = digit_crops[index]
            digits = template[y1:y2, x1:x2]
            if float(cv2.meanStdDev(digits)[1][0, 0]) < 1.0:
                return False
            cached = (signature, template, digits)
            cache[target] = cached
        templates.append(cached)
        settings.append(config)
    self._za_wild_zone_number_templates = cache

    config = settings[expected]
    x1, y1, x2, y2 = config.get("crop", (0, 0, 0, 0))
    height, width = gray.shape
    x1, y1 = max(0, int(x1)), max(0, int(y1))
    x2 = width if int(x2) <= 0 else min(width, int(x2))
    y2 = height if int(y2) <= 0 else min(height, int(y2))
    region = gray[y1:y2, x1:x2]
    template = templates[expected][1]
    if (region.shape[0] < template.shape[0]
            or region.shape[1] < template.shape[1]):
        return False
    _, whole_score, _, position = cv2.minMaxLoc(cv2.matchTemplate(
        region, template, cv2.TM_CCOEFF_NORMED))
    # Recheck the original card on this fresh frame too: a menu change
    # between image_check() and this confirmation cannot reuse old proof.
    if whole_score < float(config.get("threshold", 0.9)):
        return False
    dx1, dy1, dx2, dy2 = digit_crops[expected]
    left = x1 + position[0] + dx1 - 2
    top = y1 + position[1] + dy1 - 2
    right = x1 + position[0] + dx2 + 2
    bottom = y1 + position[1] + dy2 + 2
    if left < 0 or top < 0 or right > width or bottom > height:
        return False
    digits = gray[top:bottom, left:right]
    # Both candidates search the SAME 43x43 pixels, allowing only +/-2px.
    scores = [float(cv2.minMaxLoc(cv2.matchTemplate(
        digits, cached[2], cv2.TM_CCOEFF_NORMED))[1])
        for cached in templates]
    margin = scores[expected] - scores[1 - expected]
    matched = scores[expected] >= 0.90 and margin >= 0.03
    self.last_wild_zone_number_detection = {
        "matched": bool(matched), "target": str(targetimage),
        "whole_score": float(whole_score),
        "scores": {"10": scores[0], "18": scores[1]},
        "score": scores[expected], "margin": margin,
        "threshold": 0.90, "margin_threshold": 0.03,
        "crop": (left, top, right, bottom),
    }
    if config.get("show_value", False) or getattr(self, "show_value_bool", False):
        print("[WILD_ZONE_DIGITS] {} 10={:.6f} 18={:.6f} gap={:.6f} {}".format(
            str(targetimage), scores[0], scores[1], margin,
            "MATCH" if matched else "NO MATCH"))
    return bool(matched)


def ZA_wild_zone_preview_competition_check(self, targetimage, frame=None):
    """Compare 8/18 previews on one frame, also excluding the similar zone 5."""
    import cv2
    import math
    import os
    try:
        import Commands.PythonCommands.LocalFunction.ImageDetection as image_detection
    except ModuleNotFoundError as error:
        if error.name not in (
                "Commands", "Commands.PythonCommands",
                "Commands.PythonCommands.LocalFunction",
                "Commands.PythonCommands.LocalFunction.ImageDetection"):
            raise
        import LocalFunction.ImageDetection as image_detection

    prefix = "POKEMON_ZA_MOVEPOINT_PIC_W_ZONE"
    expected = str(targetimage)
    self.last_wild_zone_preview_detection = {"matched": False, "target": expected}
    if expected not in (prefix + "8", prefix + "18"):
        return False
    if frame is None:
        try:
            frame = image_detection.read_command_frame(self)
        except RuntimeError:
            return False
    if (frame is None or getattr(frame, "size", 0) == 0
            or len(frame.shape) != 3 or frame.shape[2] not in (3, 4)):
        return False
    gray = cv2.cvtColor(frame[:, :, :3], cv2.COLOR_BGR2GRAY)
    own = self.IMAGE_DETECTION_TARGETS.get(expected, [])
    if len(own) != 1:
        return False
    bounds = own[0].get("crop", (0, 0, 0, 0))
    if len(bounds) != 4:
        return False
    x1, y1, x2, y2 = map(int, bounds)
    height, width = gray.shape
    if x1 < 0 or y1 < 0 or x2 > width or y2 > height or x2 <= x1 or y2 <= y1:
        return False
    region = gray[y1:y2, x1:x2]
    serial_root = os.path.abspath(os.path.join(
        os.path.dirname(image_detection.__file__), ".."))
    if os.path.basename(serial_root) == "PythonCommands":
        serial_root = os.path.abspath(os.path.join(serial_root, "..", ".."))
    cache = getattr(self, "_za_wild_zone_preview_templates", {})
    scores = {}
    positions = {}
    # Zone 5 is needed too: the zone 8 preview exceeds .90 on saved zone 3/5
    # cards, while zone 5's preview scores higher. Never infer the place name
    # from the left-hand spot-name similarity scores.
    for number in (8, 18, 5):
        target = prefix + str(number)
        variants = self.IMAGE_DETECTION_TARGETS.get(target, [])
        if not variants and target != expected:
            # Composed samples may register only the requested target. All
            # three reference PNGs are shipped in the same MovePoint folder.
            peer = dict(own[0])
            peer["template_path"] = os.path.join(
                os.path.dirname(str(peer.get("template_path", ""))),
                "W_ZONE{}_pic.png".format(number))
            variants = [peer]
        if len(variants) != 1:
            return False
        config = variants[0]
        if (not config.get("use_gray", True)
                or tuple(config.get("crop", ())) != tuple(bounds)
                or any(config.get("template_crop") or [])
                or config.get("exclude_regions")):
            return False
        path = str(config.get("template_path", ""))
        if not os.path.isabs(path):
            path = os.path.join(serial_root, path)
        try:
            stat = os.stat(path)
        except OSError:
            return False
        signature = (path, stat.st_mtime_ns, stat.st_size)
        cached = cache.get(target)
        if cached is None or cached[0] != signature:
            template = cv2.imread(path, cv2.IMREAD_GRAYSCALE)
            if template is None or float(cv2.meanStdDev(template)[1][0, 0]) < 1.0:
                return False
            cached = (signature, template)
            cache[target] = cached
        template = cached[1]
        if region.shape[0] < template.shape[0] or region.shape[1] < template.shape[1]:
            return False
        _, score, _, position = cv2.minMaxLoc(cv2.matchTemplate(
            region, template, cv2.TM_CCOEFF_NORMED))
        if not math.isfinite(score):
            return False
        scores[str(number)] = float(score)
        positions[str(number)] = (x1 + position[0], y1 + position[1])
    self._za_wild_zone_preview_templates = cache
    number = expected[len(prefix):]
    threshold = float(own[0].get("threshold", .90))
    margin = scores[number] - max(score for key, score in scores.items() if key != number)
    matched = scores[number] >= threshold and margin >= .03
    self.last_wild_zone_preview_detection = {
        "matched": bool(matched), "target": expected, "scores": scores,
        "positions": positions, "score": scores[number], "threshold": threshold,
        "margin": margin, "margin_threshold": .03, "crop": tuple(bounds),
    }
    if own[0].get("show_value", False) or getattr(self, "show_value_bool", False):
        print("[WILD_ZONE_PREVIEWS] {} 8={:.6f} 18={:.6f} 5={:.6f} gap={:.6f} {}".format(
            expected, scores["8"], scores["18"], scores["5"], margin,
            "MATCH" if matched else "NO MATCH"))
    return bool(matched)


def image_check_confirmation(self, targetimage, first_match=False):
    """Disambiguate zone previews/digits and reject SELECT on field/battle UI."""
    del first_match  # image_check hook compatibility
    if str(targetimage) in (
            "POKEMON_ZA_MOVEPOINT_PIC_W_ZONE8",
            "POKEMON_ZA_MOVEPOINT_PIC_W_ZONE18"):
        try:
            import Commands.PythonCommands.LocalFunction.ImageDetection as image_detection
        except ModuleNotFoundError as error:
            if error.name not in (
                    "Commands", "Commands.PythonCommands",
                    "Commands.PythonCommands.LocalFunction",
                    "Commands.PythonCommands.LocalFunction.ImageDetection"):
                raise
            import LocalFunction.ImageDetection as image_detection
        try:
            frame = image_detection.read_command_frame(self)
        except RuntimeError:
            return False
        if frame is None:
            return False
        if not self.ZA_wild_zone_preview_competition_check(targetimage, frame=frame):
            return False
        if str(targetimage) == "POKEMON_ZA_MOVEPOINT_PIC_W_ZONE18":
            return self.ZA_wild_zone_number_detail_check(targetimage, frame=frame)
        return True
    if str(targetimage) == "POKEMON_ZA_MOVEPOINT_PIC_W_ZONE10":
        return self.ZA_wild_zone_number_detail_check(targetimage)
    select_targets = {
        "POKEMON_ZA_1_SELECT",
        "POKEMON_ZA_2_SELECT",
        "POKEMON_ZA_2_SELECT_TUTORIAL",
        "POKEMON_ZA_3_SELECT",
        "POKEMON_ZA_3_SELECT_SELECT",
        "POKEMON_ZA_3_SELECT_TUTORIAL",
        "POKEMON_ZA_4_SELECT",
    }
    if str(targetimage) not in select_targets:
        return True

    # FIELD_W／FIELD_BACK_Wは前後向きと手持ち番号を包含する。
    # さらに戦闘中の固定Lv.表示やRPush表示がある画面も選択肢では
    # ないため、いずれか一つでも存在する間はSELECT一致を採用しない。
    return not (
        self.image_check("POKEMON_ZA_FIELD_W")
        or self.image_check("POKEMON_ZA_FIELD_BACK_W")
        or self.image_check("POKEMON_ZA_BATTLE_ACTIVE_LEVEL")
        or self.image_check("POKEMON_ZA_R_push")
    )


def image_check_exception(self, targetimage):
    """Handle Pokemon ZA checks that do not use a template image."""
    if targetimage in ("POKEMON_ZA_TRUE_RETURN", "TRUE_RETURN", "RETURN_TRUE", "RETURN TRUE"):
        return True
    if targetimage in ("POKEMON_ZA_FALSE_RETURN", "FALSE_RETURN", "RETURN_FALSE", "RETURN FALSE"):
        return False
    if targetimage == "POKEMON_ZA_FILED_HARD_CHECK_0":
        return bool(self.ZA_story_Template_Field_HardGaurd())
    if targetimage == "POKEMON_ZA_FILED_HARD_CHECK_1":
        return bool(self.ZA_story_Template_Field_HardGaurd(mode=1))
    if targetimage == "POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK":
        return bool(self.ZA_no_battle_filed_check_HardGaurd())
    if targetimage == "POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK_0":
        return bool(self.ZA_no_battle_filed_check_HardGaurd())
    if targetimage == "POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK_1":
        return bool(self.ZA_no_battle_filed_check_HardGaurd(mode=1))
    if targetimage == "POKEMON_ZA_ZONE12":
        return True
    # POKECON_IMAGE_CHECK_EXCEPTION_USER_BEGIN
    # Add command-specific non-image checks here.
    # POKECON_IMAGE_CHECK_EXCEPTION_USER_END
    return False
