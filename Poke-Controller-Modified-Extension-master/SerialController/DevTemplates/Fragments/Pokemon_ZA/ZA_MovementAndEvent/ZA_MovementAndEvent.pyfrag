    self._za_mega_z_guard_holding=False
    self._za_mega_z_guard_last_seen=0.0
    self._za_mega_z_guard_hold_until=0.0
    self._za_mega_z_guard_hold_until_disappears=False
    self._za_mega_z_guard_normal_hold_completed=False
    self._za_mega_z_guard_on_green_count=0
    self._za_mega_z_guard_skip_current_floor=False
    self._za_mega_z_guard_skip_last_seen=0.0
    self._za_mega_z_guard_direction=None
    self._za_mega_z_guard_direction_until=0.0
    if last_battle_mode:
        self.ZA_mega_mode5_set_start_flag(
            0, "MODE5_START", "reset and wait for FIELD check")
    if self._za_mega_movemode == 1:
        # 最終戦は緑床を先に確認し、床がなければ90度で初期移動する。
        # 黄色低HPは初期角度ではなく、ロックオン後の距離維持へ使う。
        # 既存のmode 5指定は3秒、直接呼び出し時は渡された秒数を使う。
        self._za_mega_dir5=90
        field_resume_dir5_seconds=max(
            0.0, float(field_resume_dir5_seconds))
    select2_picture = (
        "POKEMON_ZA_3_SELECT" if last_battle_mode
        else "POKEMON_ZA_2_SELECT")
    select3_picture = (
        "POKEMON_ZA_4_SELECT" if last_battle_mode
        else "POKEMON_ZA_3_SELECT")
    # mode 5はAだけが有効。それ以外のMEGA戦は従来順を維持する。
    attack_order=(0,3,1,2) if last_battle_mode else (0,1,2,3)

    def advance_attack_count(current):
        try:
            current_position=attack_order.index(current)
        except ValueError:
            return attack_order[0]
        return attack_order[(current_position + 1) % len(attack_order)]

    if mode4_view_nudge:
        self.ZA_mega_mode4_view_nudge()
    
    while True:
        if last_battle_mode:
            if int(getattr(
                    self, "_za_mega_mode5_start_flag", 0)) == 0:
                self.ZA_mega_mode5_set_start_flag(
                    1, "LOOP_START", "check FIELD/green/battle screen")
            # mode 5の検知優先順は専用関数だけで管理する。
            mode5_screen=self.ZA_mega_mode5_detect_screen_state(nofiled)
            field_w_detected=mode5_screen["field_w"]
            field_back_w_detected=mode5_screen["field_back_w"]
            field_screen_detected=mode5_screen["field_screen"]
            green_resume_detected=mode5_screen["green_resume"]
            battle_screen_detected=mode5_screen["battle_screen"]
            event_attack_picture=mode5_screen[
                "event_attack_picture"]
            resume_screen_detected=mode5_screen["resume_screen"]
            choice_input_guard=mode5_screen["choice_guard"]
            detected_state=(
                "CHOICE_OR_BLACK_COMMENT" if choice_input_guard
                else "EVENT_ATTACK_UI" if event_attack_picture
                else mode5_screen["resume_reason"].upper())
            self.ZA_mega_mode5_trace(
                detected_state, "screen-state check")
        else:
            # mode 0～4はmode 5追加前の順序へ戻す。選択画面を先に
            # 確認し、選択中はFIELD画像の追加照合を行わない。
            choice_input_guard = self.ZA_mega_choice_input_guard()
            field_w_detected = bool(
                not choice_input_guard
                and self.image_check("POKEMON_ZA_FIELD_W"))
            field_back_w_detected = bool(
                not choice_input_guard
                and self.image_check("POKEMON_ZA_FIELD_BACK_W"))
            field_screen_detected = (
                field_w_detected or field_back_w_detected)
            battle_screen_detected = False
            event_attack_picture = ""
            resume_screen_detected = field_screen_detected
        if choice_input_guard:
            # 選択画面へ方向入力を持ち越さないよう、ループの最初に停止する。
            self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
            self.ZA_MOVE_SEE(action = "END",in_see_r=see_r)
            if last_battle_mode:
                self.ZA_mega_mode5_transition(
                    "RETRY_SELECTION",
                    "selection/comment guard detected")
                self._za_mega_mode5_battle_active=False
                self._za_mega_mode5_post_move_wait_until=0.0
                self._za_mega_mode5_lockon_confirmed_until=0.0
                self._za_mega_mode5_visual_lockon_until=0.0
                self._za_mega_colored_enemy_track_position=None
                self._za_mega_colored_enemy_track_seen_at=0.0
                if self._za_mega_testmode1_enabled:
                    self.ZA_mega_mode5_testmode1_reset_for_selection(
                        "BLACK_COMMENT_OR_SELECT")
                # 次ターゲット選択ではBACK_Wを経由しない場合もあるため、
                # 前のターゲットで消費した上入力回数をここで破棄する。
                if getattr(self, "_za_mega_field_w_up_attempts", 0):
                    print(
                        "[MEGA_FIELD_W] target selection; "
                        "reset up retry")
                self._za_mega_field_w_up_attempts=0
                self._za_mega_field_w_up_retry_at=0.0
                self._za_mega_field_w_up_latched=False
                self.ZA_mega_mode5_set_start_flag(
                    0, "CHOICE_OR_BLACK_COMMENT",
                    "stop movement; reset HP/test phase before retry")

        if endpicture != "" or end2picture != "":
            if self.image_check(endpicture):
                self._za_mega_rclick_dir3_until=0.0
                self._za_mega_field_dir5_until=0.0
                self._za_mega_field_dir4_until=0.0
                self.ZA_ZL_ACTION("END")
                self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
                self.ZA_MOVE_SEE(action = "END",in_see_r=see_r)
                return True
            if self.image_check(end2picture):
                self._za_mega_rclick_dir3_until=0.0
                self._za_mega_field_dir5_until=0.0
                self._za_mega_field_dir4_until=0.0
                self.ZA_ZL_ACTION("END")
                self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
                self.ZA_MOVE_SEE(action = "END",in_see_r=see_r)
                return True

        field_resume_detected = nofiled==1 and resume_screen_detected
        if field_resume_detected and last_battle_mode:
            self.ZA_mega_mode5_begin_resume(
                Z_Gaurd,
                field_resume_dir5_seconds,
                see_r,
                mode5_screen["resume_reason"])
            # dir5が設定済みなら開始専用方向を使い、dir4は消費しない。
            if dir5 >= 0:
                # mode 5は同じ周回の緑床判定を先に通し、床がない場合だけ
                # その時点から固定方向移動の実時間を開始する。
                self._za_mega_field_dir5_until = (
                    0.0 if last_battle_mode else
                    time.monotonic()
                    + max(0.0, field_resume_dir5_seconds))
                self._za_mega_field_dir4_until = 0.0
                field_resume_dirnum = 5
            else:
                self._za_mega_field_dir5_until = 0.0
                self._za_mega_field_dir4_until = (
                    time.monotonic()
                    + max(0.0, field_resume_dir4_seconds))
                field_resume_dirnum = 4
            # 緑床を入口として復帰できた場合は、この直後の床移動で
            # ZLを解除する。FIELD/BATTLE復帰時だけ保持を開始する。
            if not (last_battle_mode and green_resume_detected):
                self.ZA_ZL_ACTION("")
            # 上／左入力より先に開始フラグ2の緑床・固定移動へ入る。
            nofiled=0

        if nofiled==0 and not last_battle_mode and field_w_detected:
            # mode 0～4は従来どおり、FIELD_Wが残る各周回で上を送る。
            # 1回だけのラッチ式では最初の入力欠落後に再試行できない。
            self.etc_sendCommand("Lbutton_up")

        # mode 5固有の「緑床→初期接近」は専用状態処理だけで進める。
        if (last_battle_mode and not choice_input_guard and nofiled==0
                and int(getattr(
                    self, "_za_mega_mode5_start_flag", 0)) == 2
                and self.ZA_mega_mode5_green_and_initial_update(
                    dir1,dir2,dir3,dir4,see_r,
                    field_resume_dir5_seconds)):
            continue

        if (last_battle_mode and not choice_input_guard and nofiled==0
                and int(getattr(
                    self, "_za_mega_mode5_start_flag", 0)) == 3):
            if field_w_detected:
                field_w_action=self.ZA_mega_mode5_field_w_up_retry(
                    True, False,
                    before_recovery=lambda: self.ZA_MOVE_LStick(
                        dir1,dir2,dir3,dir4,1,"END"))
                if field_w_action == "menu_recovery":
                    continue
                self.ZA_mega_mode5_trace(
                    "POKEMON_ZA_FIELD_W",
                    "Lbutton_up retry; wait for FIELD change", force=True)
                # 上入力が受付される前にロックオン・移動・攻撃で
                # 上書きしない。FIELD_Wが消えた次周回で先へ進む。
                self.wait(0.1)
                continue
            elif field_back_w_detected or battle_screen_detected:
                self.ZA_mega_mode5_field_w_up_retry(
                    False, field_back_w_detected)
                self.ZA_mega_mode5_trace(
                    "POKEMON_ZA_FIELD_BACK_W" if field_back_w_detected
                    else "POKEMON_ZA_BATTLE",
                    "FIELD_W not required; begin battle processing",
                    force=True)
            elif self.image_check(
                    "POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK"):
                now=time.monotonic()
                attempts=int(getattr(
                    self, "_za_mega_mode5_field_left_attempts", 0))
                if (attempts < 5 and now >= float(getattr(
                        self,
                        "_za_mega_mode5_field_left_retry_at", 0.0))):
                    self.etc_sendCommand("Lbutton_left", wait=0.10)
                    self.keys.input([])
                    self._za_mega_mode5_field_left_attempts=attempts + 1
                    self._za_mega_mode5_field_left_retry_at=now + 0.3
                    self.ZA_mega_mode5_trace(
                        "FIELD_WITHOUT_FIELD_W",
                        "Lbutton_left {}/5; recheck FIELD_W".format(
                            attempts + 1), force=True)
                    self.wait(0.1)
                    continue
                if attempts < 5:
                    self.wait(0.1)
                    continue
                # FIELD自体は確認できているため、左を5回送っても
                # FIELD_Wだけ取れない場合は攻撃可能フェーズへ進める。
                self.ZA_mega_mode5_trace(
                    "FIELD_W_MISSED_AFTER_LEFT_RETRY",
                    "begin battle with generic FIELD confirmation",
                    force=True)
            else:
                self.ZA_mega_mode5_trace(
                    "NO_FIELD_CONFIRMATION",
                    "wait without attack/input")
                self.wait(0.1)
                continue
            self._za_mega_mode5_field_left_attempts=0
            self._za_mega_mode5_field_left_retry_at=0.0
            self._za_mega_mode5_battle_active=True
            self.ZA_mega_mode5_transition(
                "TARGET_ATTACK", "FIELD input phase complete")
            self.ZA_mega_mode5_set_start_flag(
                4, "FIELD_INPUT_COMPLETE",
                "continuous movement, target search and attacks")

        # フラグ4でFIELD_Wが再表示された場合は、やられた次の
        # ターゲット選択として0.3秒間隔・最大5回まで上を再送する。
        if (last_battle_mode and nofiled==0
                and int(getattr(
                    self, "_za_mega_mode5_start_flag", 0)) == 4):
            if field_w_detected:
                # 戦闘処理中に倒れた場合もFIELD_Wを最優先する。
                # BACK_Wが重なっても上入力を省略せず、表示が消えるまで
                # 攻撃・移動・ロックオン処理へ流さない。
                field_w_action=self.ZA_mega_mode5_field_w_up_retry(
                    True, False,
                    before_recovery=lambda: self.ZA_MOVE_LStick(
                        dir1,dir2,dir3,dir4,1,"END"))
                if field_w_action == "menu_recovery":
                    continue
                self.ZA_mega_mode5_trace(
                    "POKEMON_ZA_FIELD_W",
                    "battle interrupted; retry Lbutton_up and wait",
                    force=True)
                self.wait(0.1)
                continue
            self.ZA_mega_mode5_field_w_up_retry(
                False, field_back_w_detected)

        # 最終戦の即死攻撃予兆は、通常の接近・攻撃・復旧判定より先に
        # 処理する。近い緑床なら移動し、遠い／間に合わない場合だけ
        # ロックオンを解除したY回避へ切り替える。
        charge_result=self.ZA_mega_last_battle_charge_update(
            dir1,dir2,dir3,dir4,see_r,
            endpicture=endpicture, end2picture=end2picture,
            active=(last_battle_mode and not choice_input_guard
                    and nofiled==0 and int(getattr(
                        self, "_za_mega_mode5_start_flag", 0)) == 4))
        if charge_result == "endpicture":
            self._za_mega_rclick_dir3_until=0.0
            self._za_mega_field_dir5_until=0.0
            self._za_mega_field_dir4_until=0.0
            self.ZA_ZL_ACTION("END")
            self.ZA_MOVE_LStick(
                dir1,dir2,dir3,dir4,1,"END")
            self.ZA_MOVE_SEE(action="END", in_see_r=see_r)
            return True
        if charge_result in {
                "search", "green", "dodge", "guard", "complete"}:
            if self._za_mega_testmode1_enabled:
                if charge_result in {"search", "green"}:
                    if not getattr(
                            self,
                            "_za_mega_testmode1_legacy_until_reset",
                            False):
                        self._za_mega_testmode1_phase="EXISTING_CHARGE"
                    self.ZA_mega_mode5_trace(
                        "CHARGE_" + charge_result.upper(),
                        "testmode1 suspended; existing charge/green action",
                        force=True)
                elif charge_result in {"dodge", "complete"}:
                    if not getattr(
                            self,
                            "_za_mega_testmode1_legacy_until_reset",
                            False):
                        self._za_mega_testmode1_phase=str(getattr(
                            self,
                            "_za_mega_testmode1_phase_before_charge",
                            "COVER_ATTACK"))
                    nofiled=1
                    self.ZA_mega_mode5_set_start_flag(
                        0, "CHARGE_" + charge_result.upper(),
                        "existing charge action complete; retain phase until "
                        "BLACK_COMMENT/SELECT")
            continue

        testmode1_action="none"
        if self._za_mega_testmode1_enabled:
            testmode1_action=self.ZA_mega_mode5_testmode1_combat_update(
                dir1,dir2,dir3,dir4,see_r)
        if testmode1_action == "restart":
            nofiled=1
            continue
        if testmode1_action == "handled":
            continue

        # mode 5の専用4技画面はC+を表示しない。緑床をもう一度
        # 優先確認したうえで、通常C+分岐へ入らずZL+A/X/B/Yを送る。
        if (last_battle_mode and event_attack_picture and nofiled==0
                and int(getattr(
                    self, "_za_mega_mode5_start_flag", 0)) == 4):
            if (self._za_mega_z_guard_enabled
                    and not self.ZA_mega_mode5_testmode1_controls_cover()
                    and self.ZA_mega_z_guard_update(
                        dir1,dir2,dir3,dir4)):
                self.ZA_mega_mode5_trace(
                    "GREEN_FLOOR",
                    "green floor before event attack; defer A/X/B/Y",
                    force=True)
                continue
            if self.ZA_mega_mode5_event_attack_axby(
                    event_attack_picture):
                continue

        # 攻撃できる場合は復旧判定より攻撃処理を優先する。
        loop_attack_ready = (
            not choice_input_guard
            and (not last_battle_mode or int(getattr(
                self, "_za_mega_mode5_start_flag", 0)) == 4)
            and (self.ZA_mega_mode5_a_attack_ready(
                     choice_guard_checked=True)
                 if last_battle_mode
                 else self.ZA_mega_attack_ready()))
        if self.ZA_battle_missing_field_recovery(
                "mega",
                enabled=not choice_input_guard,
                attack_ready=loop_attack_ready,
                before_recovery=lambda: self.ZA_MOVE_LStick(
                    dir1,dir2,dir3,dir4,1,"END")):
            self._za_mega_rclick_dir3_until=0.0
            self._za_mega_field_dir5_until=0.0
            self._za_mega_field_dir4_until=0.0
            continue

        if field_resume_detected and not last_battle_mode:
            # mode 0～4はmode 5追加前と同じ位置で開始方向を準備する。
            # 復旧・攻撃可否判定より前へ移すと既存の再ロック周期が変わる。
            if dir5 >= 0:
                self._za_mega_field_dir5_until=(
                    time.monotonic()
                    + max(0.0, field_resume_dir5_seconds))
                self._za_mega_field_dir4_until=0.0
                field_resume_dirnum=5
            else:
                self._za_mega_field_dir5_until=0.0
                self._za_mega_field_dir4_until=(
                    time.monotonic()
                    + max(0.0, field_resume_dir4_seconds))
                field_resume_dirnum=4
            self.ZA_MOVE_LStick(
                dir1,dir2,dir3,dir4,
                field_resume_dirnum,"RELOAD")

        if (not choice_input_guard and nofiled==0
                and not (last_battle_mode
                         and self._za_mega_movemode == 1)
                and not (last_battle_mode
                         and self._za_mega_testmode1_enabled
                         and self.ZA_mega_mode5_testmode1_controls_cover())):
            # mode 5以外は従来の保持移動を維持する。mode 5は下の
            # movemode処理で有限パルスを送るため、先に保持を再送しない。
            self.ZA_mega_keep_left_moving(dir1,dir2,dir3,dir4)
            
        if (not choice_input_guard
                and self.image_check("POKEMON_ZA_HELP_MARKER")):
            self.pressRep(Button.A, repeat=1, duration=0.04, wait=0.0, interval=0.1)
            
        r_push_ready=(
            not choice_input_guard
            and self.image_check("POKEMON_ZA_R_push"))
        if lockon_rclick:
            now=time.monotonic()
            attack_ready=loop_attack_ready
            lockon_active=getattr(self,"ZL_state",0)==1
            if (lockon_active and attack_ready
                    and now>=rclick_retry_at
                    and (r_push_ready or not rclick_lockon_used)):
                self.ZA_MOVE_SEE(action = "END",in_see_r=see_r)
                self.press(Button.RCLICK,0.05,0.1)
                rclick_lockon_used=True
                rclick_retry_at=now+3.0
                self._za_mega_rclick_dir3_until=time.monotonic()+35.0
                # 演出待ち中から35秒間dir3で前進し、そのまま攻撃ループへ入る。
                if (last_battle_mode
                        and self._za_mega_testmode1_enabled
                        and self.ZA_mega_mode5_testmode1_controls_cover()):
                    self.ZA_MOVE_LStick(
                        dir1,dir2,dir3,dir4,1,"END")
                    self.ZA_MOVE_SEE(
                        action="END", in_see_r=see_r)
                else:
                    self.ZA_MOVE_LStick(
                        dir1,dir2,dir3,dir4,3,"RELOAD")
                self.wait(1.0)
                self.ZA_MOVE_SEE(
                    action=("END" if self._za_mega_movemode == 1 else ""),
                    in_see_r=see_r)
        elif r_push_ready:
            # 引数で無効化した場合は従来のR_push画像判定だけを使う。
            self.ZA_MOVE_SEE(action = "END",in_see_r=see_r)
            self.press(Button.RCLICK,0.15,0.1)
            self.wait(1.0)
            self.ZA_MOVE_SEE(
                action=("END" if self._za_mega_movemode == 1 else ""),
                in_see_r=see_r)

        if field_resume_detected and not last_battle_mode:
            # mode 0～4の従来動作：RPush判定後にZLと開始方向を再送し、
            # usenum位置が合えば上、合わなければ左で再判定する。
            self.ZA_ZL_ACTION("")
            self.ZA_MOVE_LStick(
                dir1,dir2,dir3,dir4,
                field_resume_dirnum,"RELOAD")
            if self._ZA_mega_field_position_matches(usenum):
                self.etc_sendCommand("Lbutton_up")
                self.keys.input([])
                nofiled=0
            else:
                self.etc_sendCommand("Lbutton_left")
                self.keys.input([])
                self.wait(0.5)
                continue

        if (not choice_input_guard and nofiled==0
                and last_battle_mode
                and self._za_mega_movemode == 1
                and (not self._za_mega_testmode1_enabled
                     or not self.ZA_mega_mode5_testmode1_controls_cover())):
            # 初期90度移動後は、ターゲットへ接近または周回しながら攻撃する。
            self.ZA_mega_movemode_update(
                dir1,dir2,dir3,dir4,
                include_upper=mode4_view_nudge)

        # マーカー未検出の連続視点は、画像処理の途中で攻撃経路に
        # 即座停止されないよう、最低0.70秒の回転時間を確保する。
        if (self._za_mega_movemode == 1
                and getattr(
                    self, "_za_mega_marker_search_view_holding", False)
                and time.monotonic() < getattr(
                    self, "_za_mega_marker_search_retry_at", 0.0)
                and not (last_battle_mode and loop_attack_ready)):
            self.wait(0.1)
            continue

        red_edge_result = self.ZA_mega_red_edge_dodge_if_needed(
            red_edge_y_renda_seconds,
            dir1,dir2,dir3,dir4,see_r,
            endpicture=endpicture, end2picture=end2picture,
            active=not choice_input_guard and nofiled == 0,
            repeat_count=red_edge_y_repeat)
        if red_edge_result == "endpicture":
            self._za_mega_rclick_dir3_until=0.0
            self._za_mega_field_dir5_until=0.0
            self._za_mega_field_dir4_until=0.0
            self.ZA_ZL_ACTION("END")
            self.ZA_MOVE_LStick(
                dir1,dir2,dir3,dir4,1,"END")
            self.ZA_MOVE_SEE(action="END", in_see_r=see_r)
            return True
        if red_edge_result in {
                "complete", "guard", "green_priority"}:
            continue

        effective_attack_ready = (
            loop_attack_ready
            or time.monotonic() < getattr(
                self, "_za_mega_rclick_dir3_until", 0.0))
        if (not choice_input_guard and nofiled == 0
                and attack_unavailable_y_dodge):
            if effective_attack_ready:
                attack_unavailable_since = None
            else:
                now = time.monotonic()
                if attack_unavailable_since is None:
                    attack_unavailable_since = now
                elif (now - attack_unavailable_since >= 0.25
                        and self.ZA_mega_attack_unavailable_y_dodge(
                            dir1, dir2, dir3, dir4, see_r,
                            post_l_view_nudge=mode4_view_nudge,
                            include_upper_marker=mode4_view_nudge)):
                    continue
        else:
            attack_unavailable_since = None

        attack_loop_count = (
            10 if time.monotonic() < getattr(
                self, "_za_mega_rclick_dir3_until", 0.0)
            else 5)
        red_edge_interrupted = False
        z_guard_interrupted = False
        charge_interrupted = False
        for i in range(attack_loop_count):
            if (choice_input_guard
                    or self.ZA_mega_choice_input_guard()):
                self.ZA_MOVE_LStick(
                    dir1,dir2,dir3,dir4,1,"END")
                self.ZA_MOVE_SEE(action = "END",in_see_r=see_r)
                break
            charge_result=self.ZA_mega_last_battle_charge_update(
                dir1,dir2,dir3,dir4,see_r,
                endpicture=endpicture, end2picture=end2picture,
                active=last_battle_mode and nofiled==0)
            if charge_result == "endpicture":
                self._za_mega_rclick_dir3_until=0.0
                self._za_mega_field_dir5_until=0.0
                self._za_mega_field_dir4_until=0.0
                self.ZA_ZL_ACTION("END")
                self.ZA_MOVE_LStick(
                    dir1,dir2,dir3,dir4,1,"END")
                self.ZA_MOVE_SEE(action="END", in_see_r=see_r)
                return True
            if charge_result in {
                    "search", "green", "dodge", "guard", "complete"}:
                if self._za_mega_testmode1_enabled:
                    if charge_result in {"search", "green"}:
                        if not getattr(
                                self,
                                "_za_mega_testmode1_legacy_until_reset",
                                False):
                            self._za_mega_testmode1_phase="EXISTING_CHARGE"
                        self.ZA_mega_mode5_trace(
                            "CHARGE_" + charge_result.upper(),
                            "testmode1 suspended inside attack loop",
                            force=True)
                    elif charge_result in {"dodge", "complete"}:
                        if not getattr(
                                self,
                                "_za_mega_testmode1_legacy_until_reset",
                                False):
                            self._za_mega_testmode1_phase=str(getattr(
                                self,
                                "_za_mega_testmode1_phase_before_charge",
                                "COVER_ATTACK"))
                        nofiled=1
                        self.ZA_mega_mode5_set_start_flag(
                            0, "CHARGE_" + charge_result.upper(),
                            "charge action complete; retain phase until "
                            "BLACK_COMMENT/SELECT")
                charge_interrupted=True
                break
            testmode1_action="none"
            if self._za_mega_testmode1_enabled:
                testmode1_action=(
                    self.ZA_mega_mode5_testmode1_combat_update(
                        dir1,dir2,dir3,dir4,see_r))
            if testmode1_action == "restart":
                nofiled=1
                charge_interrupted=True
                break
            if testmode1_action == "handled":
                charge_interrupted=True
                break
            # 攻撃5回の途中で出た緑床も即時優先する。
            if (self._za_mega_z_guard_enabled and nofiled==0
                    and not self.ZA_mega_mode5_testmode1_controls_cover()
                    and self.ZA_mega_z_guard_update(
                        dir1,dir2,dir3,dir4)):
                if last_battle_mode:
                    self.ZA_mega_mode5_transition(
                        "GREEN_HOLD" if getattr(
                            self, "_za_mega_z_guard_holding", False)
                        else "GREEN_MOVE",
                        "green floor appeared during attack loop")
                z_guard_interrupted=True
                break
            if (last_battle_mode and nofiled==0
                    and self._za_mega_movemode == 1
                    and (not self._za_mega_testmode1_enabled
                         or not self.ZA_mega_mode5_testmode1_controls_cover())):
                # 外側ループだけで移動を更新すると、画像判定5回の間に
                # 左入力が十数秒消える。各攻撃の直前にも短い接近／探索を
                # 行い、緑床判定後から攻撃判定まで移動を途切れさせない。
                self.ZA_mega_movemode_update(
                    dir1,dir2,dir3,dir4,
                    include_upper=mode4_view_nudge)
            red_edge_result = self.ZA_mega_red_edge_dodge_if_needed(
                red_edge_y_renda_seconds,
                dir1,dir2,dir3,dir4,see_r,
                endpicture=endpicture, end2picture=end2picture,
                active=nofiled == 0,
                repeat_count=red_edge_y_repeat)
            if red_edge_result == "endpicture":
                self._za_mega_rclick_dir3_until=0.0
                self._za_mega_field_dir5_until=0.0
                self._za_mega_field_dir4_until=0.0
                self.ZA_ZL_ACTION("END")
                self.ZA_MOVE_LStick(
                    dir1,dir2,dir3,dir4,1,"END")
                self.ZA_MOVE_SEE(action="END", in_see_r=see_r)
                return True
            if red_edge_result in {
                    "complete", "guard", "green_priority"}:
                red_edge_interrupted = True
                break
            enabled_attacks = (Aaction,Baction,Xaction,Yaction)
            for _ in range(4):
                if enabled_attacks[count]:
                    break
                count=advance_attack_count(count)
            rclick_attack_active = (
                time.monotonic() < getattr(
                    self, "_za_mega_rclick_dir3_until", 0.0))
            # RCLICK演出でC+表示が一時的に消えても、開始前に攻撃可能を
            # 確認済みの35秒間はAXYB攻撃を止めない。
            if count==0 and Aaction==1:
                # mode 5は安全な戦闘画面、通常MEGAはC+またはFIELDを
                # A専用条件として使う。C+欠落だけでAを止めない。
                attack_input_ready=(
                    rclick_attack_active
                    or self.ZA_mega_a_attack_ready(
                        choice_guard_checked=True))
            elif last_battle_mode:
                # B/X/YはC+画像を現在確認できる場合だけ技として送る。
                # RCLICK時間や戦闘状態だけではダッシュ／ローリングに
                # 化ける可能性があるため、Aのフォールバックとは分ける。
                attack_input_ready=(
                    self.ZA_mega_mode5_skill_attack_ready())
            else:
                attack_input_ready = (
                    rclick_attack_active
                    or self.ZA_mega_attack_ready())
            if (attack_input_ready
                    and self._za_mega_movemode == 1
                    and getattr(self, "ZL_state", 0) == 0):
                # 連続視点探索中に攻撃可能に戻った場合は、攻撃前に
                # 右スティックを止めて必ずロックオンを戻す。
                self.ZA_mega_mode5_marker_search_view_stop(
                    relock=True)
            current_attack_ready=attack_input_ready
            if (last_battle_mode and count != 0
                    and not current_attack_ready):
                # 技画像がない周回はAへ即座に戻し、攻撃回数を落とさない。
                count=0
                current_attack_ready=(
                    rclick_attack_active
                    or self.ZA_mega_a_attack_ready(
                        choice_guard_checked=True))
            if count==3 and last_battle_mode:
                # YはZL入力状態だけでなく、EYE／実マーカーを
                # 直近で確認できた場合だけ技として送る。
                current_attack_ready=(
                    attack_input_ready
                    and self.ZA_mega_mode5_y_attack_ready())
            cplus_for_current_attack=bool(
                enabled_attacks[count]
                and (Cplus_attack or (count==0 and Aaction==1)))
            cplus_activation_ready=(
                current_attack_ready or not Cplus_attack)
            if (last_battle_mode and Cplus_attack
                    and current_attack_ready):
                # C+が実際に使える表示のときだけPLUSを先に送り、
                # 表示を一時的に取れない場合はAだけで攻撃を継続する。
                cplus_activation_ready=(
                    self.image_check("POKEMON_ZA_C+")
                    or self.image_check("POKEMON_ZA_C+_LOW"))
            if (cplus_for_current_attack
                    and cplus_activation_ready
                    and self.ZA_mega_cplus_should_press(
                        cp_mode=Cp_mode,
                        cplus_active=cplus_active)):
                # PLUS送信後は、技入力を送るまでC+有効状態を保持する。
                # 技待ち中にPLUSを再送してOFFにしない。
                self.press(Button.PLUS, duration=0.04, wait=0.0)
                cplus_active=True
                cplus_suppression_logged=False
                print("[MEGA_CPLUS] PLUS: C+ activated")
            elif (cplus_for_current_attack
                    and cplus_activation_ready and Cp_mode==1
                    and cplus_active
                    and not cplus_suppression_logged):
                print("[MEGA_CPLUS] PLUS suppressed: C+ already active")
                cplus_suppression_logged=True
            if count==0 and Aaction==1 and current_attack_ready:
                # mode 5の未検知探索中は右スティックを止めず、
                # A攻撃とターゲット再捕捉を並行する。
                if not last_battle_mode:
                    self.ZA_MOVE_SEE(action = "END")
                self.pressRep(Button.A, repeat=1, duration=0.04, wait=0.0, interval=0.1)
                if last_battle_mode:
                    self.ZA_mega_mode5_trace(
                        "BATTLE_SCREEN", "A attack")
                cplus_active=self.ZA_mega_cplus_after_skill_input(
                    cplus_active)
                cplus_suppression_logged=False
                
                if escape_flag==1:
                    #回避行動用
                    if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK"): #FIELDから変更
                        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,4,"RELOAD")
                        if self.image_check("POKEMON_ZA_C+"):
                            self.ZA_mega_relock_toward_marker(dir1,dir2,dir3,dir4,dodge_repeat=1)
                elif escape_flag==2:
                    #回避行動用
                    if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK"): #FIELDから変更
                        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,4,"RELOAD")
                        if self.image_check("POKEMON_ZA_C+"):
                            self.ZA_mega_relock_toward_marker(dir1,dir2,dir3,dir4,dodge_repeat=5)
                elif escape_flag==3:
                    #回避行動用
                    if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK"): #FIELDから変更
                        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,4,"RELOAD")
                        if self.image_check("POKEMON_ZA_C+"):
                            self.ZA_mega_relock_toward_marker(dir1,dir2,dir3,dir4,dodge_repeat=9)
                count=advance_attack_count(count)
                no_target_count=0
                target_count+=1
                continue
                #QUICK_RETURN 回避動作間隔を狭めるため
            elif count==1 and Baction==1 and current_attack_ready:
                self.ZA_MOVE_SEE(action = "END")
                self.pressRep(Button.B, repeat=1, duration=0.04, wait=0.0, interval=0.1)
                if last_battle_mode:
                    self.ZA_mega_mode5_trace(
                        "POKEMON_ZA_C+/C+_LOW", "B skill attack")
                cplus_active=self.ZA_mega_cplus_after_skill_input(
                    cplus_active)
                cplus_suppression_logged=False
                if escape_flag==1:
                #回避行動用
                    if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK"): #FIELDから変更
                        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,4,"RELOAD")
                        if self.image_check("POKEMON_ZA_C+"):

                            self.ZA_mega_relock_toward_marker(dir1,dir2,dir3,dir4,dodge_repeat=1)
                elif escape_flag==2:
                    #回避行動用
                    if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK"): #FIELDから変更
                        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,4,"RELOAD")
                        if self.image_check("POKEMON_ZA_C+"):
                            self.ZA_mega_relock_toward_marker(dir1,dir2,dir3,dir4,dodge_repeat=5)
                elif escape_flag==3:
                    #回避行動用
                    if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK"): #FIELDから変更
                        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,4,"RELOAD")
                        if self.image_check("POKEMON_ZA_C+"):
                            self.ZA_mega_relock_toward_marker(dir1,dir2,dir3,dir4,dodge_repeat=9)
                count=advance_attack_count(count)
                no_target_count=0
                target_count+=1
                continue
                #QUICK_RETURN 回避動作間隔を狭めるため
            elif count==2 and Xaction==1 and current_attack_ready:
                self.ZA_MOVE_SEE(action = "END")
                self.pressRep(Button.X, repeat=1, duration=0.04, wait=0.0, interval=0.1)
                if last_battle_mode:
                    self.ZA_mega_mode5_trace(
                        "POKEMON_ZA_C+/C+_LOW", "X skill attack")
                cplus_active=self.ZA_mega_cplus_after_skill_input(
                    cplus_active)
                cplus_suppression_logged=False
                if escape_flag==1:
                    #回避行動用
                    if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK"): #FIELDから変更
                        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,4,"RELOAD")
                        if self.image_check("POKEMON_ZA_C+"):
                            self.ZA_mega_relock_toward_marker(dir1,dir2,dir3,dir4,dodge_repeat=1)
                elif escape_flag==2:
                    #回避行動用
                    if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK"): #FIELDから変更
                        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,4,"RELOAD")
                        if self.image_check("POKEMON_ZA_C+"):
                            self.ZA_mega_relock_toward_marker(dir1,dir2,dir3,dir4,dodge_repeat=5)
                elif escape_flag==3:
                    #回避行動用
                    if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK"): #FIELDから変更
                        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,4,"RELOAD")
                        if self.image_check("POKEMON_ZA_C+"):
                            self.ZA_mega_relock_toward_marker(dir1,dir2,dir3,dir4,dodge_repeat=9)
                count=advance_attack_count(count)
                no_target_count=0
                target_count+=1
                continue
                #QUICK_RETURN 回避動作間隔を狭めるため
            elif count==3 and Yaction==1 and current_attack_ready:
                self.ZA_MOVE_SEE(action = "END")
                self.pressRep(Button.Y, repeat=1, duration=0.04, wait=0.0, interval=0.1)
                if last_battle_mode:
                    self.ZA_mega_mode5_trace(
                        "POKEMON_ZA_C+/C+_LOW", "Y skill attack")
                cplus_active=self.ZA_mega_cplus_after_skill_input(
                    cplus_active)
                cplus_suppression_logged=False
                if escape_flag==1:
                #回避行動用
                    if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK"): #FIELDから変更
                        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,4,"RELOAD")
                        if self.image_check("POKEMON_ZA_C+"):
                            self.ZA_mega_relock_toward_marker(dir1,dir2,dir3,dir4,dodge_repeat=1)
                elif escape_flag==2:
                    #回避行動用
                    if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK"): #FIELDから変更
                        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,4,"RELOAD")
                        if self.image_check("POKEMON_ZA_C+"):
                            self.ZA_mega_relock_toward_marker(dir1,dir2,dir3,dir4,dodge_repeat=5)
                elif escape_flag==3:
                    #回避行動用
                    if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK"): #FIELDから変更
                        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,4,"RELOAD")
                        if self.image_check("POKEMON_ZA_C+"):
                            self.ZA_mega_relock_toward_marker(dir1,dir2,dir3,dir4,dodge_repeat=9)
                count=advance_attack_count(count)
                no_target_count=0
                target_count+=1
                continue
                #QUICK_RETURN 回避動作間隔を狭めるため
            elif count==0 and last_battle_mode:
                # FIELD確認を失った暗転／コメント／選択肢では、
                # 再ロック探索にも入らず次の外側ループで状態を取り直す。
                self.ZA_MOVE_LStick(
                    dir1,dir2,dir3,dir4,1,"END")
                self.ZA_MOVE_SEE(action="END", in_see_r=see_r)
                break
            elif not attack_input_ready:
                self.ZA_mega_relock_toward_marker(
                    dir1,dir2,dir3,dir4,
                    include_upper_marker=mode4_view_nudge)
                if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK"): #FIELDから変更
                    no_target_count+=1
                    target_count=0
                else:
                    continue
                break
            
        if (red_edge_interrupted or z_guard_interrupted
                or charge_interrupted):
            continue

        #回避行動中にターゲットマーカーチェックの移動を行えないと別方向に視点が行ってしまうため
        midloop_choice_input_guard = (
            choice_input_guard
            or self.ZA_mega_choice_input_guard())
        if midloop_choice_input_guard:
            self.ZA_MOVE_LStick(
                dir1,dir2,dir3,dir4,1,"END")
            self.ZA_MOVE_SEE(action = "END",in_see_r=see_r)
        if (not midloop_choice_input_guard and not (
                self.image_check("POKEMON_ZA_TEXT_GREEN_COMMENT")
                or self.image_check("POKEMON_ZA_TEXT_BLACK_COMMENT"))):
            marker_direction = self.ZA_mega_target_marker_direction(
                include_upper=bool(mode4_view_nudge))
            if marker_direction:

                if target_marker_count==2:
                    if not self.ZA_mega_attack_ready():
                        if (time.monotonic() < getattr(
                                self, "_za_mega_field_dir5_until", 0.0)
                                and getattr(self, "_za_mega_dir5", -1) >= 0):
                            self.ZA_MOVE_LStick(
                                dir1,dir2,dir3,dir4,5,"RELOAD")
                        elif time.monotonic() < getattr(
                                self, "_za_mega_field_dir4_until", 0.0):
                            self.ZA_MOVE_LStick(
                                dir1,dir2,dir3,dir4,4,"RELOAD")
                        elif self._za_mega_movemode != 1:
                            resume_dirnum = self.ZA_mega_keep_left_moving(
                                dir1,dir2,dir3,dir4)
                            self.ZA_MOVE_LStick(
                                dir1,dir2,dir3,dir4,marker_direction,"RELOAD")
                            self.wait(0.2)
                            self.pressRep(Button.L, repeat=1, duration=0.04, wait=0.0, interval=0.1)
                            self.ZA_MOVE_LStick(
                                dir1,dir2,dir3,dir4,resume_dirnum,"RELOAD")
                            print("LS")
                    self.ZA_MOVE_SEE(
                        action=("END" if self._za_mega_movemode == 1 else ""),
                        in_see_r=see_r)
                    for i in range(
                            10 if time.monotonic() < getattr(
                                self, "_za_mega_rclick_dir3_until", 0.0)
                            else 5):
                        if self.ZA_mega_choice_input_guard():
                            self.ZA_MOVE_LStick(
                                dir1,dir2,dir3,dir4,1,"END")
                            self.ZA_MOVE_SEE(
                                action = "END",in_see_r=see_r)
                            break
                        charge_result=(
                            self.ZA_mega_last_battle_charge_update(
                                dir1,dir2,dir3,dir4,see_r,
                                endpicture=endpicture,
                                end2picture=end2picture,
                                active=(last_battle_mode
                                        and nofiled==0)))
                        if charge_result == "endpicture":
                            self._za_mega_rclick_dir3_until=0.0
                            self._za_mega_field_dir5_until=0.0
                            self._za_mega_field_dir4_until=0.0
                            self.ZA_ZL_ACTION("END")
                            self.ZA_MOVE_LStick(
                                dir1,dir2,dir3,dir4,1,"END")
                            self.ZA_MOVE_SEE(
                                action="END", in_see_r=see_r)
                            return True
                        if charge_result in {
                                "search", "green", "dodge", "guard",
                                "complete"}:
                            if self._za_mega_testmode1_enabled:
                                if charge_result in {"search", "green"}:
                                    if not getattr(
                                            self,
                                            "_za_mega_testmode1_legacy_until_reset",
                                            False):
                                        self._za_mega_testmode1_phase=(
                                            "EXISTING_CHARGE")
                                    self.ZA_mega_mode5_trace(
                                        "CHARGE_" + charge_result.upper(),
                                        "testmode1 suspended inside "
                                        "target-marker attack loop",
                                        force=True)
                                elif charge_result in {"dodge", "complete"}:
                                    if not getattr(
                                            self,
                                            "_za_mega_testmode1_legacy_until_reset",
                                            False):
                                        self._za_mega_testmode1_phase=str(
                                            getattr(
                                                self,
                                                "_za_mega_testmode1_phase_before_charge",
                                                "COVER_ATTACK"))
                                    nofiled=1
                                    self.ZA_mega_mode5_set_start_flag(
                                        0,
                                        "CHARGE_" + charge_result.upper(),
                                        "charge action complete; retain "
                                        "phase until BLACK_COMMENT/SELECT")
                            red_edge_interrupted=True
                            break
                        red_edge_result = (
                            self.ZA_mega_red_edge_dodge_if_needed(
                                red_edge_y_renda_seconds,
                                dir1,dir2,dir3,dir4,see_r,
                                endpicture=endpicture,
                                end2picture=end2picture,
                                active=nofiled == 0,
                                repeat_count=red_edge_y_repeat))
                        if red_edge_result == "endpicture":
                            self._za_mega_rclick_dir3_until=0.0
                            self._za_mega_field_dir5_until=0.0
                            self._za_mega_field_dir4_until=0.0
                            self.ZA_ZL_ACTION("END")
                            self.ZA_MOVE_LStick(
                                dir1,dir2,dir3,dir4,1,"END")
                            self.ZA_MOVE_SEE(
                                action="END", in_see_r=see_r)
                            return True
                        if red_edge_result in {
                                "complete", "guard", "green_priority"}:
                            red_edge_interrupted = True
                            break
                        enabled_attacks = (
                            Aaction,Baction,Xaction,Yaction)
                        for _ in range(4):
                            if enabled_attacks[count]:
                                break
                            count=advance_attack_count(count)
                        rclick_attack_active = (
                            time.monotonic() < getattr(
                                self,
                                "_za_mega_rclick_dir3_until",
                                0.0))
                        if count==0 and Aaction==1:
                            # 重複攻撃経路も同じA専用フォールバックを使う。
                            attack_input_ready=(
                                rclick_attack_active
                                or self.ZA_mega_a_attack_ready(
                                    choice_guard_checked=True))
                        elif last_battle_mode:
                            attack_input_ready=(
                                self.ZA_mega_mode5_skill_attack_ready())
                        else:
                            attack_input_ready = (
                                rclick_attack_active
                                or self.ZA_mega_attack_ready())
                        current_attack_ready=attack_input_ready
                        if (last_battle_mode and count != 0
                                and not current_attack_ready):
                            count=0
                            current_attack_ready=(
                                rclick_attack_active
                                or self.ZA_mega_a_attack_ready(
                                    choice_guard_checked=True))
                        if count==3 and last_battle_mode:
                            # YはZL入力状態だけでなく、EYE／実マーカーを
                            # 直近で確認できた場合だけ技として送る。
                            current_attack_ready=(
                                attack_input_ready
                                and self.ZA_mega_mode5_y_attack_ready())
                        cplus_for_current_attack=bool(
                            enabled_attacks[count]
                            and (Cplus_attack
                                 or (count==0 and Aaction==1)))
                        cplus_activation_ready=(
                            current_attack_ready or not Cplus_attack)
                        if (last_battle_mode and Cplus_attack
                                and current_attack_ready):
                            cplus_activation_ready=(
                                self.image_check("POKEMON_ZA_C+")
                                or self.image_check(
                                    "POKEMON_ZA_C+_LOW"))
                        if (cplus_for_current_attack
                                and cplus_activation_ready
                                and self.ZA_mega_cplus_should_press(
                                    cp_mode=Cp_mode,
                                    cplus_active=cplus_active)):
                            self.press(
                                Button.PLUS,
                                duration=0.04, wait=0.0)
                            cplus_active=True
                            cplus_suppression_logged=False
                            print("[MEGA_CPLUS] PLUS: C+ activated")
                        if count==0 and Aaction==1 and current_attack_ready:
                            self.ZA_MOVE_SEE(action = "END")
                            self.pressRep(Button.A, repeat=1, duration=0.04, wait=0.0, interval=0.1)
                            if last_battle_mode:
                                self.ZA_mega_mode5_trace(
                                    "BATTLE_SCREEN", "A attack")
                            cplus_active=self.ZA_mega_cplus_after_skill_input(
                                cplus_active)
                            cplus_suppression_logged=False
                            self.ZA_MOVE_SEE(action = "END",in_see_r=see_r)
                            self.wait(0.3)
                            if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK"): #FIELDから変更
                                if no_target_count>no_target_count_threshold:
                                    targetmode=0
                                    self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,3,"RELOAD")
                                elif target_count>target_count_threshold:
                                    targetmode=1
                                    self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,4,"RELOAD")
                                else:
                                    if targetmode==0:
                                        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,2,"RELOAD")
                                    else:
                                        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"RELOAD")    
                            count=advance_attack_count(count)
                            break
                        elif count==1 and Baction==1 and current_attack_ready:
                            self.ZA_MOVE_SEE(action = "END")
                            self.pressRep(Button.B, repeat=1, duration=0.04, wait=0.0, interval=0.1)
                            if last_battle_mode:
                                self.ZA_mega_mode5_trace(
                                    "POKEMON_ZA_C+/C+_LOW",
                                    "B skill attack")
                            cplus_active=self.ZA_mega_cplus_after_skill_input(
                                cplus_active)
                            cplus_suppression_logged=False
                            self.ZA_MOVE_SEE(action = "END",in_see_r=see_r)
                            self.wait(0.3)
                            if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK"): #FIELDから変更
                                if no_target_count>no_target_count_threshold:
                                    targetmode=0
                                    self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,3,"RELOAD")
                                elif target_count>target_count_threshold:
                                    targetmode=1
                                    self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,4,"RELOAD")
                                else:
                                    if targetmode==0:
                                        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,2,"RELOAD")
                                    else:
                                        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"RELOAD")    
                            count=advance_attack_count(count)
                            break
                        elif count==2 and Xaction==1 and current_attack_ready:
                            self.ZA_MOVE_SEE(action = "END")
                            self.pressRep(Button.X, repeat=1, duration=0.04, wait=0.0, interval=0.1)
                            if last_battle_mode:
                                self.ZA_mega_mode5_trace(
                                    "POKEMON_ZA_C+/C+_LOW",
                                    "X skill attack")
                            cplus_active=self.ZA_mega_cplus_after_skill_input(
                                cplus_active)
                            cplus_suppression_logged=False
                            self.ZA_MOVE_SEE(action = "END",in_see_r=see_r)
                            self.wait(0.3)
                            if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK"): #FIELDから変更
                                if no_target_count>no_target_count_threshold:
                                    targetmode=0
                                    self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,3,"RELOAD")
                                elif target_count>target_count_threshold:
                                    targetmode=1
                                    self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,4,"RELOAD")
                                else:
                                    if targetmode==0:
                                        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,2,"RELOAD")
                                    else:
                                        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"RELOAD")   
                            count=advance_attack_count(count)
                            break
                        elif count==3 and Yaction==1 and current_attack_ready:
                            self.ZA_MOVE_SEE(action = "END")
                            self.pressRep(Button.Y, repeat=1, duration=0.04, wait=0.0, interval=0.1)
                            if last_battle_mode:
                                self.ZA_mega_mode5_trace(
                                    "POKEMON_ZA_C+/C+_LOW",
                                    "Y skill attack")
                            cplus_active=self.ZA_mega_cplus_after_skill_input(
                                cplus_active)
                            cplus_suppression_logged=False
                            self.ZA_MOVE_SEE(action = "END",in_see_r=see_r)
                            self.wait(0.3)
                            if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK"): #FIELDから変更
                                if no_target_count>no_target_count_threshold:
                                    targetmode=0
                                    self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,3,"RELOAD")
                                elif target_count>target_count_threshold:
                                    targetmode=1
                                    self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,4,"RELOAD")
                                else:
                                    if targetmode==0:
                                        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,2,"RELOAD")
                                    else:
                                        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"RELOAD")   
                            count=advance_attack_count(count)
                            break
                        elif count==0 and last_battle_mode:
                            self.ZA_MOVE_LStick(
                                dir1,dir2,dir3,dir4,1,"END")
                            self.ZA_MOVE_SEE(
                                action="END", in_see_r=see_r)
                            break
                        else:
                            if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK"): #FIELDから変更
                                if no_target_count>no_target_count_threshold:
                                    targetmode=0
                                    self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,3,"RELOAD")
                                elif target_count>target_count_threshold:
                                    targetmode=1
                                    self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,4,"RELOAD")
                                else:
                                    if targetmode==0:
                                        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,2,"RELOAD")
                                    else:
                                        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"RELOAD")    
                    if red_edge_interrupted:
                        continue
                    target_marker_count+=1
                elif target_marker_count>2:
                    target_marker_count=0
                else:
                    self.ZA_MOVE_SEE(
                        action=("END" if self._za_mega_movemode == 1 else ""),
                        in_see_r=see_r)
            else:
                target_marker_count=0
                self.ZA_MOVE_SEE(
                    action=("END" if self._za_mega_movemode == 1 else ""),
                    in_see_r=see_r)
        else:
            # コメント中は左移動を停止する場合があるため、
            # 右スティックだけを回転状態にしない。
            target_marker_count=0
            self.ZA_MOVE_SEE(action = "END",in_see_r=see_r)
        count=advance_attack_count(count)
        
        black_comment = self.image_check("POKEMON_ZA_TEXT_BLACK_COMMENT")
        field_active = self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK") #FIELDから変更
        black_nonfield_candidate = black_comment and not field_active
        if black_nonfield_candidate:
            # BLACK_COMMENTと選択肢では方向入力を送らない。
            self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
            self.ZA_MOVE_SEE(action = "END",in_see_r=see_r)
        black_nonfield_confirmed = (
            black_nonfield_candidate
            and self.ZA_mega_nonfield_picture_confirmed(
                "POKEMON_ZA_TEXT_BLACK_COMMENT")
        )
        if not black_nonfield_confirmed:
            if field_active:
                if last_battle_mode:
                    self._za_mega_mode5_battle_active=True
                if self._za_mega_movemode == 1:
                    # この周回中に従来方向で上書きされていても、
                    # 最後にターゲット接近／周回方向を再送する。
                    self.ZA_mega_movemode_update(
                        dir1,dir2,dir3,dir4,
                        include_upper=mode4_view_nudge)
                elif no_target_count>no_target_count_threshold:
                    targetmode=0
                    self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,3,"RELOAD")
                elif target_count>target_count_threshold:
                    targetmode=1
                    self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,4,"RELOAD")
                else:
                    if targetmode==0:
                        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,2,"RELOAD")
                    else:
                        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"RELOAD")  
            #self.MOVE_SEE(action = "END",in_see_r=see_r)
            self.wait(0.1)

        else:
            no_target_count=0
            target_count=target_count_threshold
            self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
            self.ZA_MOVE_SEE(action = "END",in_see_r=see_r)
                
        if black_nonfield_confirmed:
            if last_battle_mode:
                self.ZA_mega_mode5_transition(
                    "RETRY_SELECTION",
                    "battle-end black comment confirmed")
                self._za_mega_mode5_battle_active=False
                self._za_mega_mode5_lockon_confirmed_until=0.0
                self._za_mega_mode5_visual_lockon_until=0.0
            if nofiled==0:
                nofiled=1
                # 前の戦闘で確認したRCLICK時間を次戦のC+判定へ持ち越さない。
                self._za_mega_rclick_dir3_until=0.0
                self._za_mega_field_dir5_until=0.0
                self._za_mega_field_dir4_until=0.0
                battle_count+=1
                Cp_mode=(
                    1 if Cplus_attack
                    else (Cp_mode+1)%2)#Cpのモード切替
                cplus_active=False
                cplus_suppression_logged=False
                print(f'BATTLE_COUNT::{battle_count}')
            no_target_count=0
            target_count=target_count_threshold
            self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
            self.ZA_MOVE_SEE(action = "END",in_see_r=see_r)
            self.wait(1.0)
            if (last_battle_mode
                    and self.image_check(
                        "POKEMON_ZA_3_SELECT_TUTORIAL")):
                # 最終戦の「準備して再挑戦」は専用画像を優先し、
                # 汎用3_SELECTの下入力処理へ入れず、そのまま決定する。
                if self.ZA_mega_last_battle_tutorial_confirmed():
                    self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.5, interval=0.1)
            elif (last_battle_mode
                    and self.image_check(select2_picture)):
                # 描画途中では専用画像だけ外れることがある。
                # 下入力へフォールバックせず、この場で再確認する。
                if self.ZA_mega_last_battle_tutorial_confirmed():
                    self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.5, interval=0.1)
            elif self.image_check(select2_picture):
                self.wait(1.0)
                if (not last_battle_mode
                        and self.image_check(
                            "POKEMON_ZA_2_SELECT_TUTORIAL")):
                    self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.5, interval=0.1) 
                else:
                    # 2_SELECT相当は1項目下へ移動してから決定する。
                    self.etc_sendCommand("Lbutton_down")
                    self.wait(1.0)
                    self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.5, interval=0.1)  
            elif self.image_check(select3_picture):
                self.wait(1.0)
                if (not last_battle_mode
                        and self.image_check(
                            "POKEMON_ZA_3_SELECT_SELECT")):
                    self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.5, interval=0.1)
                else:
                    # 3_SELECT相当は1項目下へ移動してから決定する。
                    self.etc_sendCommand("Lbutton_down")
                    self.wait(1.0)
                    self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.5, interval=0.1)
            else:
                self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.5, interval=0.1)
            if last_battle_mode:
                self.ZA_mega_mode5_set_start_flag(
                    0, "BLACK_COMMENT_SELECT_HANDLED",
                    "selection input complete; restart FIELD check")
                 
        elif (not choice_input_guard
                and not self.ZA_mega_choice_input_guard()
                and self.image_check("POKEMON_ZA_TEXT_GREEN_COMMENT")):
            self.ZA_renda_button(rendabutton="B",endpicture="POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK",sub_button="A",sub_picture="POKEMON_ZA_1_SELECT",sub2_button="A",sub2_picture=select2_picture,sub3_button="A",sub3_picture="POKEMON_ZA_HELP_MARKER") #FIELDから変更

        elif (
                last_battle_mode
                and not field_active
                and self.image_check(
                    "POKEMON_ZA_3_SELECT_TUTORIAL")):
            nofiled=1
            self._za_mega_field_dir5_until=0.0
            self._za_mega_field_dir4_until=0.0
            self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
            self.ZA_MOVE_SEE(action = "END",in_see_r=see_r)
            # 専用3_SELECT_TUTORIALは現在選択中の
            # 「準備して再挑戦」を下入力なしで決定する。
            if self.ZA_mega_last_battle_tutorial_confirmed():
                self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.5, interval=0.1)
                self.ZA_mega_mode5_set_start_flag(
                    0, "POKEMON_ZA_3_SELECT_TUTORIAL",
                    "A complete; restart FIELD check")
        elif (
                last_battle_mode
                and not field_active
                and self.image_check(select2_picture)
                and self.ZA_mega_nonfield_picture_confirmed(
                    select2_picture)):
            nofiled=1
            self._za_mega_field_dir5_until=0.0
            self._za_mega_field_dir4_until=0.0
            self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
            self.ZA_MOVE_SEE(action = "END",in_see_r=see_r)
            # 汎用3_SELECTだけ先に一致しても入力せず、専用画像を再確認する。
            if self.ZA_mega_last_battle_tutorial_confirmed():
                self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.5, interval=0.1)
                self.ZA_mega_mode5_set_start_flag(
                    0, select2_picture,
                    "A complete; restart FIELD check")
        elif (
                not last_battle_mode
                and not field_active
                and self.image_check(select2_picture)
                and self.ZA_mega_nonfield_picture_confirmed(
                    "POKEMON_ZA_2_SELECT")):
            nofiled=1
            self._za_mega_field_dir5_until=0.0
            self._za_mega_field_dir4_until=0.0
            self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
            self.ZA_MOVE_SEE(action = "END",in_see_r=see_r)
            self.wait(1.0)
            if (not last_battle_mode
                    and self.image_check(
                        "POKEMON_ZA_2_SELECT_TUTORIAL")):
                self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.5, interval=0.1) 
            else:
                self.wait(1.0)
                # 2_SELECT相当は1項目下へ移動してから決定する。
                self.etc_sendCommand("Lbutton_down")
                self.wait(1.0)
                self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.5, interval=0.1)  
        elif (
                not field_active
                and self.image_check(select3_picture)
                and ((last_battle_mode
                      and self.ZA_mega_nonfield_picture_confirmed(
                          select3_picture))
                     or (not last_battle_mode
                         and self.ZA_mega_nonfield_picture_confirmed(
                             "POKEMON_ZA_3_SELECT")))):
            nofiled=1
            self._za_mega_field_dir5_until=0.0
            self._za_mega_field_dir4_until=0.0
            self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
            self.ZA_MOVE_SEE(action = "END",in_see_r=see_r)
            self.wait(1.0)
            if (not last_battle_mode
                    and self.image_check(
                        "POKEMON_ZA_3_SELECT_SELECT")):
                self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.5, interval=0.1)
            else:
                # 3_SELECT相当は1項目下へ移動してから決定する。
                self.etc_sendCommand("Lbutton_down")
                self.wait(1.0)
                self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.5, interval=0.1)
            if last_battle_mode:
                self.ZA_mega_mode5_set_start_flag(
                    0, select3_picture,
                    "selection input complete; restart FIELD check")
def ZA_ZL_ACTION(self,action = "RELOAD",lockonflg=1):
    if action != "END":
        if lockonflg == 0:
            if self.ZL_state == 1:
                self.keys.inputEnd(Button.ZL)
                self.ZL_state = 0
            return
        if self.ZL_state == 0:
            self.keys.input(Button.ZL)
            self.ZL_state = 1
        else:
            self.keys.inputEnd(Button.ZL)
            #間隔をあけないとロックオンがオンにならない？
            self.wait(0.1)#self.wait(self.SLEEPLIST[2][2])
            self.keys.input(Button.ZL)
            self.ZL_state = 1
    elif action == "END" and self.ZL_state == 1:
        self.keys.inputEnd(Button.ZL)
        self.ZL_state = 0
def ZA_story_Template_battle_before(self,noprg_ret,prg_ret,green_check=0,no_filed=0,sleeptime=0.5):
    if self.ZA_story_Template_Comment_Out():
        return prg_ret
    else:
        return noprg_ret
def ZA_story_Template_battle_function(self,bkprg_ret,prg_ret,noprg_ret,Xaction=0,Aaction=0,Yaction=0,Baction=0,lockon_endskip=0,get_chanceicon4=0,noCp=0,markertype=0,battle_mode=0,move=0,sleeptime=0.5,rebattle_move_fast=0.1):
    if self.image_check("POKEMON_ZA_BATTLE_BALL_CHECK") or self.image_check("POKEMON_ZA_ESCAPE"):
        field_w_up_handled = False
        if (noCp==1 and battle_mode==1
                and self.image_check("POKEMON_ZA_FIELD_W")):
            # 1回攻撃型は共通バトル入口でFIELD_Wを処理する。
            self.etc_sendCommand("Lbutton_up")
            field_w_up_handled = True
        if noCp==0:
            if move==0:
                self.ZA_battle_Cp_loop(Xaction=Xaction,Aaction=Aaction,Yaction=Yaction,Baction=Baction,get_chanceicon4=get_chanceicon4,battle_mode=battle_mode)
            else:
                self.ZA_battle_Cp_loop_move(Xaction=Xaction,Aaction=Aaction,Yaction=Yaction,Baction=Baction,get_chanceicon4=get_chanceicon4,battle_mode=battle_mode)
        else:
            if get_chanceicon4==1 and self.image_check("POKEMON_ZA_GETCHANCE_ICON4"):
                self.ZA_get_pokemon()
            self.ZA_battle_coCp_noloop(Xaction=Xaction,Aaction=Aaction,Yaction=Yaction,Baction=Baction,battle_mode=battle_mode,selection_up_handled=field_w_up_handled)

    elif self.image_check("POKEMON_ZA_CHAT_MARKER"):
        while True:
            self.checkIfAlive()
            ret = self.ZA_Common_Event_check(markertype=markertype)
            if ret == "START":
                break
            elif ret == "FALSE":
                return prg_ret
        self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.5, interval=0.1)
        return bkprg_ret
    elif self.image_check("POKEMON_ZA_TEXT_BLACK_COMMENT"):
        self.pressRep(Button.A, repeat=10, duration=0.15, wait=0.5, interval=0.1)
        for i in range(10):
            self.wait(1.0)
            if not (self.image_check("POKEMON_ZA_BATTLE_BALL_CHECK") or self.image_check("POKEMON_ZA_ESCAPE")):
                if self.image_check("POKEMON_ZA_TEXT_BLACK_COMMENT"):
                    return bkprg_ret
    # TODO: 共通battle_functionの全呼び出し元で影響を確認する。
    # BATTLE_BALL／ESCAPE未検知時のCOMMENTはbattle_afterへ進めず、
    # battle_beforeへ戻して復帰ループ判定の対象にする。
    elif self.image_check("POKEMON_ZA_TEXT_GREEN_COMMENT"):
        return bkprg_ret
    elif self.image_check("POKEMON_ZA_TEXT_WHITE_COMMENT"):
        return bkprg_ret
    elif self.image_check("POKEMON_ZA_COIN_ICON"):
        self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.5, interval=0.1)
        return prg_ret
    elif self.image_check("POKEMON_ZA_COIN_ICON"):
        self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.5, interval=0.1)
        return noprg_ret
    
    if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK"):
    
        #TODO　処理の更新
        #for i in range(30):
        #    if i == 0:
        #        self.press(Direction(Stick.LEFT,90), duration=rebattle_move_fast, wait=0.5)
        #    else:
        #        self.press(Direction(Stick.LEFT,90), duration=0.1, wait=0.5)
        #        
        #    if self.image_check("POKEMON_ZA_CHAT_MARKER"):
        #        self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.5, interval=0.1)
        #    elif self.image_check("POKEMON_ZA_TEXT_WHITE_COMMENT"):
        #        return bkprg_ret
        #return noprg_ret
        #TODO　以下をいったん破棄
        
        if markertype==0:
            if self.ZA_markerdir("EVENT", 1):
                
                while True:
                    self.checkIfAlive()
                    ret = self.ZA_Common_Event_check(markertype=markertype)
                    if ret == "START":
                        break
                    elif ret == "FALSE":
                        return prg_ret
                for i in range(10):
                    self.press(Direction(Stick.LEFT,90), duration=0.1, wait=0.5)
                    
                    if self.image_check("POKEMON_ZA_CHAT_MARKER"):
                        self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.5, interval=0.1)
                    elif self.image_check("POKEMON_ZA_TEXT_WHITE_COMMENT"):
                        return bkprg_ret
                return noprg_ret
        elif markertype==1:
            if self.ZA_markerdir("SIDE_MARKER"):
                
                while True:
                    self.checkIfAlive()
                    ret = self.ZA_Common_Event_check(markertype=markertype)
                    if ret == "START":
                        break
                    elif ret == "FALSE":
                        return prg_ret

                for i in range(10):
                    self.press(Direction(Stick.LEFT,90), duration=0.1, wait=0.5)
                    
                    if self.image_check("POKEMON_ZA_CHAT_MARKER"):
                        self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.5, interval=0.1)
                    elif self.image_check("POKEMON_ZA_TEXT_WHITE_COMMENT"):
                        return bkprg_ret
                return noprg_ret
            
        elif markertype==-1:
            for i in range(30):
                if self.image_check("POKEMON_ZA_BATTLE_BALL_CHECK") or self.image_check("POKEMON_ZA_ESCAPE"):
                    return noprg_ret
                self.wait(1.0)
            if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK"):
                return bkprg_ret
            
        else:
            print("w3er")
            return noprg_ret
    elif self.ZA_renda_button(rendabutton="B",endpicture="POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK",endpicture2="POKEMON_ZA_COIN_ICON",endpicture3="POKEMON_ZA_BATTLE_BALL_CHECK",endpicture4="POKEMON_ZA_ESCAPE",endpicture5="POKEMON_ZA_TEXT_WHITE_COMMENT",sub_button="A",sub_picture="POKEMON_ZA_TEXT_BLACK_COMMENT",sub2_button="A",sub2_picture="POKEMON_ZA_3_SELECT",sub3_button="A",sub3_picture="POKEMON_ZA_2_SELECT",sub4_button="A",sub4_picture="POKEMON_ZA_HELP_MARKER",sleeptime=sleeptime): #FIELDから変更
        return noprg_ret
    #elif self.image_check("EVENT_MARKER_CENTER"):
    #    self.press(Direction(Stick.LEFT,90), duration=0.1, wait=0.5)
    #    self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.5, interval=0.1)
    #    return bkprg_ret

    return noprg_ret
def ZA_story_Template_battle_after(
        self, bkprg_ret, prg_ret,
        selected_pic="POKEMON_ZA_FALSE_RETURN", selected_target=0,
        mode=0, sleeptime=0.5,
        endpicture="", endpicture2="", endpicture3=""):
    """戦闘後コメントを抜け、フィールドまたは指定画像で次へ進む。"""
    del mode  # 呼び出し互換用。終了時は共通の非戦闘フィールドを確認する。
    false_pictures = {
        None, "", "RETURN_FALSE", "RETURN FALSE",
        "POKEMON_ZA_FALSE_RETURN",
    }
    endpictures = tuple(
        picture for picture in (endpicture, endpicture2, endpicture3)
        if picture not in false_pictures)
    selected_picture_enabled = selected_pic not in false_pictures
    a_pictures = (
        "POKEMON_ZA_TEXT_BLACK_COMMENT",
        "POKEMON_ZA_CHAT_MARKER",
        "POKEMON_ZA_COIN_ICON",
        "POKEMON_ZA_1_SELECT",
        "POKEMON_ZA_2_SELECT",
        "POKEMON_ZA_3_SELECT",
        "POKEMON_ZA_4_SELECT",
        "POKEMON_ZA_HELP_MARKER",
        "POKEMON_ZA_MORNING",
        "POKEMON_ZA_NIGHT",
    )
    b_pictures = (
        "POKEMON_ZA_X_MENU_OPEN",
        "POKEMON_ZA_TEXT_WHITE_COMMENT",
        "POKEMON_ZA_TEXT_GREEN_COMMENT",
        "POKEMON_ZA_COMMENT_MARKER",
    )

    while True:
        self.checkIfAlive()

        # 明示された終了画像は、戦闘表示と同時に見えても優先する。
        if any(self.image_check(picture) for picture in endpictures):
            return prg_ret

        # BATTLE_BALL_CHECKは状態異常で閾値が変わるため使用しない。
        if (self.image_check("POKEMON_ZA_BATTLE_ACTIVE_LEVEL")
                or self.image_check("POKEMON_ZA_ESCAPE")):
            return bkprg_ret

        # コメントや演出が完全に消え、フィールドが見えてから次へ進む。
        if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK"):
            return prg_ret

        if (selected_picture_enabled
                and self.image_check(selected_pic)):
            self.wait(1.0)
            for _ in range(selected_target):
                self.etc_sendCommand("Lbutton_down")
                self.wait(0.5)
            self.pressRep(
                Button.A, repeat=1, duration=0.15,
                wait=0.0, interval=0.1)
        elif any(self.image_check(picture) for picture in a_pictures):
            self.pressRep(
                Button.A, repeat=1, duration=0.04,
                wait=0.0, interval=0.1)
        elif any(self.image_check(picture) for picture in b_pictures):
            self.pressRep(
                Button.B, repeat=1, duration=0.04,
                wait=0.0, interval=0.1)
        else:
            # 遷移中の無検知画面では操作せず、次の画像を待つ。
            self.wait(max(0.1, sleeptime))
            continue
        self.wait(max(0.1, sleeptime))
def ZA_story_Template_Field_HardGaurd(self,mode=0):
    if ( ((mode==0 and (self.image_check("POKEMON_ZA_FIELD_W") or self.image_check("POKEMON_ZA_FIELD_BACK_W"))) or mode==1)
        and (self.image_check("POKEMON_ZA_MERIP_ICON_GET5") or self.image_check("POKEMON_ZA_BATTLE") or self.image_check("POKEMON_ZA_WANINOKO_ICON") or self.image_check("POKEMON_ZA_ODAIRU_ICON") or self.image_check("POKEMON_ZA_ABSOL_ICON") or self.image_check("POKEMON_ZA_DEAD"))):
        return True
    else:
        return False
def ZA_no_battle_filed_check_HardGaurd(self,mode=0):
#チェックタイミングによってバトル中が非バトル中扱いとなる可能性があるため、sleeptimeなしで連続でチェックを行ってから判断させる。

    if self.ZA_story_Template_Field_HardGaurd(mode):
        if ((not (self.image_check("POKEMON_ZA_BATTLE_BALL_CHECK") or self.image_check("POKEMON_ZA_ESCAPE")))and (self.ZA_story_Template_Field_HardGaurd(mode))):
            for i in range(3):
                if self.image_check("POKEMON_ZA_EYE_CHECK_HIGH_POKE"):
                    return True#ポケモンに見つかった場合は即座にTrue扱いで抜ける
                elif (((self.image_check("POKEMON_ZA_BATTLE_BALL_CHECK") or self.image_check("POKEMON_ZA_ESCAPE")))and (self.ZA_story_Template_Field_HardGaurd(mode))):
                    return False #バトル中扱いとする
                elif (not (self.ZA_story_Template_Field_HardGaurd(mode))):
                    return False #フィールドではないと判定
            return True #時間内にバトル中判定がない場合は非バトル中とする。
        
        elif ((self.image_check("POKEMON_ZA_BATTLE_BALL_CHECK") or self.image_check("POKEMON_ZA_ESCAPE")))and (self.ZA_story_Template_Field_HardGaurd(mode)):
            return False #バトル中扱いとする
    return False #フィールドチェックできない

