def ZA_mega_evolution_battle_mode_select(
        self, mode=0, usenum=1,
        Xaction=1, Aaction=1, Yaction=1, Baction=0,
        movemode=0, Z_Gaurd=0, Cplus_attack=0,
        testmode1=0,
        red_edge_y_renda_seconds=0.0,
        attack_unavailable_y_dodge=1):
    #アブソル Bはまもるのため選ばない。
    #if mode == 0 and self.mega_evolution_battle(Xaction=1,Aaction=1,Yaction=1,Baction=0,mode=0,dir1=320,dir2=20,see_r=0.20, endpicture="TEXT_WHITE_COMMENT"):
    if mode == 0 and self.ZA_mega_evolution_battle(usenum=usenum,Xaction=1,Aaction=1,Yaction=1,Baction=0,mode=0,dir1=20,dir2=340,dir3=40,dir4=300,see_r=0.24, escape_flag=1,target_count_threshold_arg=6,no_target_count_threshold_arg=6, endpicture="POKEMON_ZA_TEXT_WHITE_COMMENT", red_edge_y_renda_seconds=red_edge_y_renda_seconds, attack_unavailable_y_dodge=0):


        return True
    elif mode == 1 and self.ZA_mega_evolution_battle(usenum=usenum,Xaction=1,Aaction=1,Yaction=1,Baction=0,mode=0,dir1=20,dir2=340,dir3=20,dir4=340,see_r=0.24, escape_flag=2, endpicture="POKEMON_ZA_TEXT_WHITE_COMMENT", red_edge_y_renda_seconds=red_edge_y_renda_seconds, attack_unavailable_y_dodge=0):
        return True
    elif mode == 2 and self.ZA_mega_evolution_battle(usenum=usenum,Xaction=1,Aaction=1,Yaction=1,Baction=0,mode=0,dir1=20,dir2=340,dir3=40,dir4=300,see_r=0.24, escape_flag=3, endpicture="POKEMON_ZA_TEXT_WHITE_COMMENT", red_edge_y_renda_seconds=red_edge_y_renda_seconds, attack_unavailable_y_dodge=0):
        return True
    elif mode == 3 and self.ZA_mega_evolution_battle(usenum=usenum,Xaction=0,Aaction=1,Yaction=1,Baction=0,mode=0,dir1=20,dir2=0,dir3=40,dir4=0,see_r=0.24, escape_flag=0, endpicture="POKEMON_ZA_TEXT_WHITE_COMMENT", red_edge_y_renda_seconds=red_edge_y_renda_seconds, dir5=90, field_resume_dir5_seconds=4.0, attack_unavailable_y_dodge=attack_unavailable_y_dodge):
        return True
    elif mode == 4 and self.ZA_mega_evolution_battle(usenum=usenum,Xaction=1,Aaction=0,Yaction=0,Baction=0,mode=0,dir1=40,dir2=20,dir3=20,dir4=0,see_r=0.24, escape_flag=0, endpicture="POKEMON_ZA_TEXT_WHITE_COMMENT", red_edge_y_renda_seconds=red_edge_y_renda_seconds, dir5=90, field_resume_dir5_seconds=2.0, attack_unavailable_y_dodge=attack_unavailable_y_dodge, mode4_view_nudge=1):
        return True
    # mode 5はAを常時使い、通常画面のB/X/YはC+確認時だけ使用する。
    # 最終戦の専用4技UIだけはC+がないため、別経路でA/X/B/Yを送る。
    elif mode == 5 and self.ZA_mega_evolution_battle_mode5(
            usenum=usenum, movemode=movemode,
            Z_Gaurd=Z_Gaurd, Cplus_attack=Cplus_attack,
            testmode1=testmode1):
        return True
def ZA_mega_target_marker_direction(self, include_upper=False):
    # 画面下中央をプレイヤー位置とし、検出したマーカー中心までの
    # ベクトルをそのまま左スティック角度へ変換する。
    self._za_mega_target_marker_position=None
    self._za_mega_target_from_color=False
    self._za_mega_last_target_frame=None
    targets = getattr(self, "IMAGE_DETECTION_TARGETS", {})
    marker_variants = [
        (target, targets[target][0])
        for target in (
            "POKEMON_ZA_TARGET_LEFT_LOW",
            "POKEMON_ZA_TARGET_RIGHT_LOW")
        if targets.get(target)
    ]
    if marker_variants:
        camera = getattr(self, "camera", None)
        if camera is None:
            return 0
        if hasattr(camera, "readFreshFrame"):
            frame = camera.readFreshFrame(timeout=0.75)
        else:
            frame = camera.readFrame() if hasattr(
                camera, "readFrame") else None
        if frame is None:
            return 0
        self._za_mega_last_target_frame=frame
        detection_details = []
        for target, variant in marker_variants:
            template_path = str(variant.get("template_path", ""))
            normalized_path = template_path.replace("\\", "/")
            if (not os.path.isabs(template_path)
                    and normalized_path.startswith("Template/")):
                template_path = self.get_filespec(
                    normalized_path[len("Template/"):], mode="t")
            template = cv2.imread(template_path, cv2.IMREAD_COLOR)
            if template is None:
                continue
            source_match = frame
            template_match = template
            if variant.get("use_gray", False):
                source_match = cv2.cvtColor(
                    source_match, cv2.COLOR_BGR2GRAY)
                template_match = cv2.cvtColor(
                    template_match, cv2.COLOR_BGR2GRAY)
            if (source_match.shape[0] < template_match.shape[0]
                    or source_match.shape[1] < template_match.shape[1]):
                continue
            result = cv2.matchTemplate(
                source_match,
                template_match,
                cv2.TM_CCOEFF_NORMED)
            # テンプレート矩形が左上マップへ少しでも重なる候補を除外する。
            result = result.copy()
            result_height, result_width = result.shape[:2]
            template_height, template_width = template_match.shape[:2]
            exclusion_right = min(result_width, 210)
            exclusion_bottom = min(result_height, 210)
            if exclusion_right > 0 and exclusion_bottom > 0:
                result[0:exclusion_bottom, 0:exclusion_right] = -2.0
            if (getattr(self, "_za_mega_last_battle_mode", False)
                    and getattr(self, "_za_mega_movemode", 0) == 1):
                # mode 5の左下には手持ちポケモンの固定UIがあり、
                # 青緑の細い輪郭がターゲットマーカーと誤一致する。
                # 1280x720基準のx<430・y>=500だけを候補から外し、
                # それより上／右に出る実マーカーは従来どおり残す。
                lower_left_ui_right = min(
                    result_width,
                    int(round(frame.shape[1] * (430.0 / 1280.0))))
                lower_left_ui_top = min(
                    result_height,
                    int(round(frame.shape[0] * (500.0 / 720.0))))
                if (lower_left_ui_right > 0
                        and lower_left_ui_top < result_height):
                    result[
                        lower_left_ui_top:,
                        0:lower_left_ui_right] = -2.0
            _, score, _, location = cv2.minMaxLoc(result)
            threshold = float(variant.get("threshold", 0.5))
            marker_color_ratio=1.0
            if (getattr(self, "_za_mega_last_battle_mode", False)
                    and getattr(self, "_za_mega_movemode", 0) == 1):
                # 小さい円弧テンプレートは紫の壁や柱の輪郭にも0.5前後で
                # 一致する。mode 5では実マーカーの青緑色も同時に確認し、
                # 壁をターゲットとして保存方向を更新し続けない。
                marker_x,marker_y=location
                marker_patch=frame[
                    marker_y:marker_y + template_height,
                    marker_x:marker_x + template_width]
                if marker_patch.size:
                    marker_hsv=cv2.cvtColor(
                        marker_patch, cv2.COLOR_BGR2HSV)
                    marker_color_mask=cv2.inRange(
                        marker_hsv, (80, 80, 100), (115, 255, 255))
                    marker_color_ratio=(
                        float(cv2.countNonZero(marker_color_mask))
                        / max(1, int(marker_color_mask.size)))
                else:
                    marker_color_ratio=0.0
            normal_matched=(
                float(score) >= threshold
                and marker_color_ratio >= 0.22)
            detection_details.append({
                "name": target,
                "matched": normal_matched,
                "score": float(score),
                "marker_color_ratio": marker_color_ratio,
                "position": location,
                "template_size": (
                    int(template_width), int(template_height)),
            })
            if include_upper and not normal_matched:
                # 上向き時に画面上端で欠けたマーカーだけをmode 4で補足する。
                for trim_ratio in (0.25, 0.5):
                    trim_y = max(
                        1, min(
                            template_height - 2,
                            int(round(template_height * trim_ratio))))
                    upper_template = template_match[trim_y:, :]
                    upper_height, upper_width = upper_template.shape[:2]
                    search_height = min(
                        source_match.shape[0], upper_height + 5)
                    upper_source = source_match[:search_height, :]
                    if (upper_source.shape[0] < upper_height
                            or upper_source.shape[1] < upper_width):
                        continue
                    upper_result = cv2.matchTemplate(
                        upper_source,
                        upper_template,
                        cv2.TM_CCOEFF_NORMED).copy()
                    upper_result_height, upper_result_width = (
                        upper_result.shape[:2])
                    # 欠けたテンプレートは上端5px以内だけを候補とする。
                    if upper_result_height > 5:
                        upper_result[5:, :] = -2.0
                    upper_exclusion_right = min(
                        upper_result_width, 210)
                    if upper_exclusion_right > 0:
                        upper_result[:, :upper_exclusion_right] = -2.0
                    _, upper_score, _, upper_location = cv2.minMaxLoc(
                        upper_result)
                    upper_threshold = max(0.6, threshold)
                    detection_details.append({
                        "name": target,
                        "matched": (
                            float(upper_score) >= upper_threshold),
                        "score": float(upper_score),
                        "position": (
                            int(upper_location[0]),
                            int(upper_location[1]) - trim_y),
                        "template_size": (
                            int(template_width), int(template_height)),
                        "upper_clipped": True,
                    })
        if not detection_details:
            return 0
        matched_details = [
            item for item in detection_details
            if item.get("matched")]
        detail = max(
            matched_details or detection_details,
            key=lambda item: float(item.get("score", -1.0)))
        self.last_image_detection = detail
        if not detail.get("matched"):
            return 0
        x, y = detail["position"]
        width, height = detail["template_size"]
        marker_x = float(x) + float(width) / 2.0
        marker_y = float(y) + float(height) / 2.0
        self._za_mega_target_marker_position=(marker_x, marker_y)
        if (getattr(self, "_za_mega_last_battle_mode", False)
                and getattr(self, "_za_mega_movemode", 0) == 1):
            # 色補助ではなく実マーカーを取れた時だけ、短時間の
            # ロックオン確認としてY技／攻撃可能フォールバックへ渡す。
            self._za_mega_mode5_lockon_confirmed_until=(
                time.monotonic() + 0.8)
            self._za_mega_mode5_visual_lockon_until=(
                time.monotonic() + 0.8)
            # 最後に見えた側は記録するが、右スティック探索方向は
            # ここで更新しない。再検知のたびに0/180度を反転すると
            # 同じ狭い範囲を往復するため、mode 5の探索は一方向を維持する。
            if marker_x < 610.0:
                self._za_mega_marker_last_side=180.0
            elif marker_x > 670.0:
                self._za_mega_marker_last_side=0.0
            self._za_mega_marker_search_retry_at=(
                time.monotonic() + 0.15)
        delta_x = marker_x - 640.0
        delta_y = 720.0 - marker_y
        if abs(delta_x) < 1.0 and abs(delta_y) < 1.0:
            angle = 90.0
        else:
            angle = (
                math.degrees(math.atan2(delta_y, delta_x))
                + 360.0) % 360.0
        return Direction(Stick.LEFT, angle, 0.5)

    # 画像定義を持たない旧環境・単体テストでは従来判定へ戻す。
    if (self.image_check("POKEMON_ZA_TARGET_LEFT_LOW")
            or self.image_check("POKEMON_ZA_TARGET_LEFT_RIHGT_CHECK_LOW")):
        return -2
    if (self.image_check("POKEMON_ZA_TARGET_RIGHT_LOW")
            or self.image_check("POKEMON_ZA_TARGET_RIGHT_RIHGT_CHECK_LOW")):
        return -1
    return 0

def ZA_mega_mode5_colored_enemy_direction(
        self, frame=None, allow_resume=False, blue_only=False,
        refresh_frame=False):
    """mode 5だけ、赤／青の敵色をマーカー未検出時の位置補助に使う。"""
    self._za_mega_colored_enemy_position=None
    self._za_mega_colored_enemy_color=None
    self._za_mega_colored_enemy_near=False
    # 移動へ使う確定色とは別に、このfresh frameで幾何条件まで通った
    # 生の敵色を残す。赤のみ復帰側がさらに3回・3秒確認するため、
    # ここで同じ3回安定化を二重に要求しない。
    self._za_mega_colored_enemy_observed_color=None
    if (not getattr(self, "_za_mega_last_battle_mode", False)
            or getattr(self, "_za_mega_movemode", 0) != 1):
        return 0
    now=time.monotonic()
    # 赤／青はテンプレート画像ではなく色領域なので、会話・選択肢・
    # 暗転・必殺技演出にも候補が現れる。直前に戦闘FIELDを画像確認した
    # 短い区間だけ許可し、画面外状態の色で移動方向を上書きしない。
    if (not allow_resume
            and (int(getattr(
                self, "_za_mega_mode5_start_flag", 0)) != 4
                 or not getattr(
                    self, "_za_mega_mode5_battle_active", False)
                 or now >= float(getattr(
                    self, "_za_mega_mode5_color_field_until", 0.0)))):
        return 0
    if frame is None and not refresh_frame:
        frame=getattr(self, "_za_mega_last_target_frame", None)
    if frame is None:
        camera=getattr(self, "camera", None)
        if camera is None:
            return 0
        if hasattr(camera, "readFreshFrame"):
            frame=camera.readFreshFrame(timeout=0.75)
        else:
            frame=(camera.readFrame()
                   if hasattr(camera, "readFrame") else None)
    if frame is None or getattr(frame, "size", 0) == 0:
        return 0

    previous_position=getattr(
        self, "_za_mega_colored_enemy_track_position", None)
    previous_color=getattr(
        self, "_za_mega_colored_enemy_track_color", None)
    previous_seen=float(getattr(
        self, "_za_mega_colored_enemy_track_seen_at", 0.0))
    recent_track=bool(
        previous_position and now - previous_seen <= 0.9)
    height,width=frame.shape[:2]
    x0,x1=int(width * 0.06),int(width * 0.94)
    y0,y1=int(height * 0.08),int(height * 0.86)
    region=frame[y0:y1, x0:x1]
    if region.size == 0:
        return 0
    hsv=cv2.cvtColor(region, cv2.COLOR_BGR2HSV)
    blue_channel,green_channel,red_channel=cv2.split(region)
    blue_i=blue_channel.astype("int16")
    green_i=green_channel.astype("int16")
    red_i=red_channel.astype("int16")
    # 最終戦の赤敵は赤紫側(H=158～179)。通常赤(H=0～12)まで含めると
    # 主人公の髪・手持ちUIを敵として拾うため、ここでは対象外にする。
    red_hsv_mask=cv2.inRange(hsv, (158, 125, 105), (179, 255, 255))
    # Hueだけでは紫壁や暗い演出を拾うため、BGRでも赤成分が緑より
    # 十分強く、青より大幅に弱くないことを確認する。
    red_dominant=(
        (red_i >= green_i + 38)
        & (red_i >= blue_i - 20)
        & (red_channel >= 110))
    red_mask=cv2.bitwise_and(
        red_hsv_mask, red_dominant.astype("uint8") * 255)
    # 録画で青敵はH=103～113付近、背景の紫～青壁は
    # H=119以上が主だったため、青側を狭くして背景を除外する。
    blue_hsv_mask=cv2.inRange(hsv, (102, 150, 105), (115, 255, 255))
    # 暗い青背景や半透明UIはVが低く、BとGの差も小さい。
    # 青敵本体の青優勢画素だけをHSV候補へ重ねる。
    blue_dominant=(
        (blue_i >= red_i + 28)
        & (blue_i >= green_i + 8)
        & (blue_channel >= 110))
    blue_mask=cv2.bitwise_and(
        blue_hsv_mask, blue_dominant.astype("uint8") * 255)
    player_x=float(width) * 0.50
    player_y=float(height) * 0.90
    frame_area=float(width * height)
    candidates=[]
    open_kernel=cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (3, 3))
    close_kernel=cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (7, 7))
    for color_name,raw_mask in (("red", red_mask), ("blue", blue_mask)):
        mask=cv2.morphologyEx(raw_mask, cv2.MORPH_OPEN, open_kernel)
        mask=cv2.morphologyEx(mask, cv2.MORPH_CLOSE, close_kernel)
        contours,_=cv2.findContours(
            mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        for contour in contours:
            area=float(cv2.contourArea(contour))
            if area < max(600.0, frame_area * 0.00065):
                continue
            rect_x,rect_y,rect_w,rect_h=cv2.boundingRect(contour)
            if (rect_w < int(width * 0.012)
                    or rect_h < int(height * 0.022)):
                continue
            if (rect_w < int(width * 0.07)
                    and rect_h < int(height * 0.07)):
                continue
            aspect=float(rect_w) / max(1.0, float(rect_h))
            if aspect < 0.16 or aspect > 6.0:
                continue
            # 横長の通知・手持ちUIを除外する。敵の赤／青部位は縦長、
            # または画面高の25%以上を占める大きな連続領域になる。
            if (rect_h < int(rect_w * 0.85)
                    and rect_h < int(height * 0.25)):
                continue
            # 被弾時の画面端の赤、上部HPバー、下部技UIは敵にしない。
            # 一方、録画では生存中の青敵が画面左端で欠け、検知ROIの
            # 左境界へ接したことで青なしと誤判定されていた。左下UIは
            # 後段の位置条件で除外し、中段にある十分高い青敵だけ許可する。
            blue_enemy_at_left_edge=(
                color_name == "blue"
                and rect_x <= 2
                and rect_h >= int(height * 0.10)
                and rect_y + y0 < int(height * 0.62)
                and rect_y + y0 + rect_h > int(height * 0.18))
            if ((rect_x <= 2 and not blue_enemy_at_left_edge)
                    or rect_x + rect_w >= region.shape[1] - 2
                    or rect_y + rect_h >= region.shape[0] - 2):
                continue
            center_x=float(rect_x + rect_w * 0.5 + x0)
            center_y=float(rect_y + rect_h * 0.5 + y0)
            global_top=rect_y + y0
            global_bottom=global_top + rect_h
            # 常時表示される上部HP／名称と下部の手持ち・技UIは、
            # 赤青が連続していても敵本体ではない。
            if global_bottom <= int(height * 0.18):
                continue
            if global_top >= int(height * 0.78):
                continue
            if (center_y > float(height) * 0.62
                    and (center_x < float(width) * 0.36
                         or center_x > float(width) * 0.70)):
                continue
            # 全画面寄りの色フラッシュや太い攻撃エフェクトを除外する。
            # 敵本体として追う範囲は画面幅42%・高さ58%以内に限定する。
            if (rect_w > int(width * 0.42)
                    or rect_h > int(height * 0.58)):
                continue
            # 主人公の赤い髪は中央付近にある小～中サイズの縦領域。
            # ここを除外しないと、敵を見失った時に自分へ追従してしまう。
            if (color_name == "red"
                    and float(width) * 0.38 <= center_x <= float(width) * 0.62
                    and float(height) * 0.18 <= center_y
                    and rect_w < int(width * 0.18)
                    and rect_h < int(height * 0.38)):
                continue
            # 左下は手持ち・HP表示の固定領域。敵色よりUIを優先して
            # しまうため、画面下寄りの左側候補は追従対象から外す。
            if (center_x < float(width) * 0.34
                    and center_y > float(height) * 0.62):
                continue
            if center_y < float(height) * 0.18 and aspect > 2.5:
                continue
            if (rect_w > int(width * 0.40)
                    and rect_h < int(height * 0.12)):
                continue
            color_pixels=float(cv2.countNonZero(
                raw_mask[rect_y:rect_y + rect_h,
                         rect_x:rect_x + rect_w]))
            minimum_pixels=max(900.0, frame_area * 0.0009)
            coverage=color_pixels / max(1.0, float(rect_w * rect_h))
            hull_area=float(cv2.contourArea(cv2.convexHull(contour)))
            solidity=area / max(1.0, hull_area)
            if (color_pixels < minimum_pixels
                    or coverage < 0.10
                    or solidity < 0.56):
                continue
            center_distance=(
                abs(center_x - player_x) / max(1.0, float(width) * 0.5))
            score=color_pixels * max(0.65, 1.10 - 0.30 * center_distance)
            # 最大面積だけで選ぶと、同じ敵の複数部位間で中心Xが飛ぶ。
            # 直近0.9秒は同色かつ近い輪郭を優先し、追従方向を安定させる。
            if recent_track:
                track_distance=math.hypot(
                    center_x - float(previous_position[0]),
                    center_y - float(previous_position[1]))
                track_ratio=(track_distance
                             / max(1.0, float(width) * 0.45))
                if color_name == previous_color and track_ratio <= 1.0:
                    score*=1.0 + 2.5 * (1.0 - track_ratio)
                elif color_name == previous_color:
                    score*=0.55
                else:
                    score*=0.40
            candidates.append((
                score, color_pixels, color_name, center_x, center_y,
                rect_x + x0, rect_y + y0, rect_w, rect_h, coverage,
                solidity))
    if not candidates:
        return 0

    # 両方を同時に確認できた場合は、先に倒したい青敵を優先する。
    # 候補なしの色を無理に選ばず、青が見えない時だけ赤へ戻す。
    blue_candidates=[
        candidate for candidate in candidates
        if candidate[2] == "blue"]
    if blue_only and not blue_candidates:
        return 0
    preferred_candidates=(
        blue_candidates if blue_only else (blue_candidates or candidates))
    (score,color_pixels,color_name,raw_target_x,raw_target_y,
     rect_x,rect_y,rect_w,rect_h,coverage,solidity)=max(
         preferred_candidates, key=lambda item: item[0])
    del score
    self._za_mega_colored_enemy_observed_color=color_name
    # 色だけでの初回一致は、攻撃エフェクトの一瞬の発光と区別できない。
    # 実ロックオン画像がない場合は、同色・近い位置・近い面積を3回
    # 連続確認してから移動へ使う。実マーカー／C+／EYE確認中は
    # 移動角度をdir1へ固定するため、即時確定しても急旋回しない。
    previous_candidate_position=getattr(
        self, "_za_mega_colored_enemy_candidate_position", None)
    previous_candidate_color=getattr(
        self, "_za_mega_colored_enemy_candidate_color", None)
    previous_candidate_pixels=float(getattr(
        self, "_za_mega_colored_enemy_candidate_pixels", 0.0))
    previous_candidate_seen=float(getattr(
        self, "_za_mega_colored_enemy_candidate_seen_at", 0.0))
    candidate_hits=int(getattr(
        self, "_za_mega_colored_enemy_candidate_hits", 0))
    position_close=bool(
        previous_candidate_position
        and math.hypot(
            float(raw_target_x) - float(previous_candidate_position[0]),
            float(raw_target_y) - float(previous_candidate_position[1]))
        <= float(width) * 0.10)
    area_ratio=(
        color_pixels / max(1.0, previous_candidate_pixels))
    candidate_continues=bool(
        previous_candidate_color == color_name
        and now - previous_candidate_seen <= 5.0
        and position_close
        and 0.55 <= area_ratio <= 1.80)
    candidate_hits=(candidate_hits + 1 if candidate_continues else 1)
    self._za_mega_colored_enemy_candidate_position=(
        float(raw_target_x), float(raw_target_y))
    self._za_mega_colored_enemy_candidate_color=color_name
    self._za_mega_colored_enemy_candidate_pixels=color_pixels
    self._za_mega_colored_enemy_candidate_seen_at=now
    self._za_mega_colored_enemy_candidate_hits=candidate_hits
    visual_lockon_active=bool(
        getattr(self, "ZL_state", 0) == 1
        and now < float(getattr(
            self, "_za_mega_mode5_visual_lockon_until", 0.0)))
    accepted_track=bool(
        recent_track and candidate_continues
        and color_name == previous_color
        and math.hypot(
            float(raw_target_x) - float(previous_position[0]),
            float(raw_target_y) - float(previous_position[1]))
        <= float(width) * 0.12)
    if not (visual_lockon_active or accepted_track or candidate_hits >= 3):
        return 0
    target_x=float(raw_target_x)
    target_y=float(raw_target_y)
    if (recent_track and color_name == previous_color
            and math.hypot(
                target_x - float(previous_position[0]),
                target_y - float(previous_position[1]))
            <= float(width) * 0.45):
        # 新しい位置をやや強くしたEMAで、追従性を残しながら座標飛びを抑える。
        target_x=float(previous_position[0]) * 0.45 + target_x * 0.55
        target_y=float(previous_position[1]) * 0.45 + target_y * 0.55
    self._za_mega_colored_enemy_track_position=(target_x, target_y)
    self._za_mega_colored_enemy_track_color=color_name
    self._za_mega_colored_enemy_track_seen_at=now
    self._za_mega_colored_enemy_position=(target_x, target_y)
    self._za_mega_colored_enemy_color=color_name
    # 敵の中心が下寄り、または輪郭が大きい場合は十分近い。
    # movemode側で直進を止め、距離を保つ横移動へ切り替える。
    self._za_mega_colored_enemy_near=bool(
        target_y >= float(height) * 0.58
        or rect_h >= int(height * 0.30)
        or rect_w >= int(width * 0.22))
    self._za_mega_target_marker_position=(target_x, target_y)
    self._za_mega_target_from_color=True
    if target_x < 610.0:
        self._za_mega_marker_last_side=180.0
    elif target_x > 670.0:
        self._za_mega_marker_last_side=0.0
    delta_x=target_x - player_x
    delta_y=player_y - target_y
    angle=(math.degrees(math.atan2(delta_y, delta_x)) + 360.0) % 360.0
    detection_key=(color_name, int(target_x // 120), int(target_y // 120))
    if detection_key != getattr(
            self, "_za_mega_colored_enemy_log_key", None):
        print(
            "[MEGA_MOVEMODE] colored enemy {} x={:.0f} y={:.0f} "
            "pixels={:.0f}".format(
                color_name, target_x, target_y, color_pixels))
        self._za_mega_colored_enemy_log_key=detection_key
    self.last_image_detection={
        "name": "ZA_MODE5_COLORED_ENEMY_{}".format(color_name.upper()),
        "matched": True,
        "position": (int(rect_x), int(rect_y)),
        "template_size": (int(rect_w), int(rect_h)),
        "color_pixels": color_pixels,
        "coverage": coverage,
        "solidity": solidity,
        "candidate_hits": candidate_hits,
        "visual_lockon": visual_lockon_active,
        "standoff": self._za_mega_colored_enemy_near,
    }
    if hasattr(self, "displayRectangle"):
        # 通常の画像検知と同じプレビュー座標へ、確定した色候補だけを
        # 短時間表示する。赤敵は赤、青敵は青の枠で区別する。
        outline=("#ff1744" if color_name == "red" else "#00b0ff")
        self.displayRectangle(
            (int(rect_x), int(rect_y)), int(rect_w), int(rect_h),
            tag="ZA_MODE5_COLOR_{}_{}".format(
                color_name.upper(), int(time.perf_counter() * 1000)),
            ms=600, color=[outline, "orange"], crop=[])
    return Direction(Stick.LEFT, angle, 0.5)

def ZA_mega_mode5_marker_search_view_stop(self, relock=False):
    """mode 5の連続視点探索を安全に解除する。"""
    if getattr(self, "_za_mega_marker_search_view_holding", False):
        search_angle=float(getattr(
            self, "_za_mega_marker_search_view_angle", 180.0))
        self.holdEnd(Direction(Stick.RIGHT, search_angle))
    self._za_mega_marker_search_view_holding=False
    self._za_mega_marker_search_lock_until=0.0
    if relock:
        # ZL_state=1でもゲーム側の対象だけ外れている場合があるため、
        # 解除→再保持を行い、0.45秒の画像確認猶予へ入る。
        self.ZA_ZL_ACTION("")
    return True

def ZA_mega_mode5_colored_enemy_relock(self):
    """赤／青の敵位置へ短く視点を寄せ、ZLを再保持する。"""
    if (not getattr(self, "_za_mega_last_battle_mode", False)
            or getattr(self, "_za_mega_movemode", 0) != 1):
        return False
    position=getattr(self, "_za_mega_colored_enemy_position", None)
    if not position:
        return False
    now=time.monotonic()
    if now < float(getattr(
            self, "_za_mega_colored_relock_retry_at", 0.0)):
        return True

    # 実マーカー／EYEでロックオンを確認できている間は、色補助で
    # ZLを解除しない。ゲーム側の追尾を優先し、色は移動方向だけに使う。
    if (getattr(self, "ZL_state", 0) == 1
            and now < float(getattr(
                self, "_za_mega_mode5_visual_lockon_until", 0.0))):
        # 実ロックオン確認中は右視点だけ止める。relock=Trueは
        # ZLを一度解放して再入力するため、確認済みロックを壊してしまう。
        self.ZA_mega_mode5_marker_search_view_stop(relock=False)
        self._za_mega_colored_relock_retry_at=now + 0.6
        return True

    # 緑床を待つ開始直後は色を移動方向にだけ使い、視点は動かさない。
    green_priority_active=bool(
        getattr(self, "_za_mega_mode5_initial_phase_active", False)
        or int(getattr(
            self, "_za_mega_mode5_green_priority_checks_remaining", 0)) > 0)
    if ((green_priority_active
         and not getattr(self, "_za_mega_z_guard_holding", False))
            or now < float(getattr(
                self, "_za_mega_mode5_view_search_block_until", 0.0))):
        self.ZA_mega_mode5_marker_search_view_stop(relock=True)
        self._za_mega_colored_relock_retry_at=now + 0.35
        return True

    frame=getattr(self, "_za_mega_last_target_frame", None)
    width=(float(frame.shape[1]) if frame is not None
           and getattr(frame, "size", 0) else 1280.0)
    target_x=float(position[0])
    center_x=width * 0.5
    # 中央付近なら左右補正を繰り返さず、ZLだけを保持する。
    deadband=width * 0.14
    self.ZA_mega_mode5_marker_search_view_stop(relock=False)
    if abs(target_x - center_x) <= deadband:
        if getattr(self, "ZL_state", 0) == 0:
            self.ZA_ZL_ACTION("")
        self._za_mega_colored_relock_retry_at=now + 0.35
        return True

    view_angle=180.0 if target_x < center_x else 0.0
    horizontal_ratio=min(
        1.0, abs(target_x - center_x) / max(1.0, center_x))
    view_seconds=max(0.06, min(0.16, horizontal_ratio * 0.20))
    # 色位置は補助判定なので、既に保持しているZLを解除しない。
    # ロック済みなら右入力はゲーム側の追尾を壊さず、未ロックなら
    # ZLを保持したまま短く視点を寄せて再捕捉を狙える。
    relock_after_pulse=(getattr(self, "ZL_state", 0) == 0)
    self.press(
        Direction(Stick.RIGHT, view_angle, 0.48),
        duration=view_seconds,
        wait=0.0)
    if relock_after_pulse:
        self.ZA_ZL_ACTION("")
    # ZL再保持後にゲーム側がロックオンする猶予を与え、細かな解除を防ぐ。
    self._za_mega_colored_relock_retry_at=now + 0.85
    print(
        "[MEGA_COLOR_RELOCK] {} x={:.0f} view={:.0f} duration={:.2f}s".format(
            getattr(self, "_za_mega_colored_enemy_color", "enemy"),
            target_x, view_angle, view_seconds))
    return True

def ZA_mega_mode5_marker_search_view(self):
    """mode 5でマーカーを見失った間、最後の左右へ視点を連続して送る。"""
    if (not getattr(self, "_za_mega_last_battle_mode", False)
            or getattr(self, "_za_mega_movemode", 0) != 1):
        return False
    if (getattr(self, "_za_mega_testmode1_enabled", False)
            and getattr(self, "_za_mega_testmode1_phase", "")
            not in {"EXISTING_CHARGE", "LEGACY_COMBAT"}):
        # TESTMODE1は再開準備から障害物攻撃まで視点を固定する。
        # 予兆検知後のcharge処理と赤敵だけになった後の既存mode5は、
        # それぞれの専用／通常右視点確認を許可する。
        self.ZA_mega_mode5_marker_search_view_stop(relock=False)
        return False
    now=time.monotonic()
    green_hold_active=bool(getattr(
        self, "_za_mega_z_guard_holding", False))
    if (not green_hold_active and (
            getattr(
                self, "_za_mega_mode5_initial_phase_active", False)
            or int(getattr(
                self,
                "_za_mega_mode5_green_priority_checks_remaining",
                0)) > 0
            or now < float(getattr(
                self,
                "_za_mega_mode5_view_search_block_until",
                0.0)))):
        # 開始直後は正面の敵と緑床を先に確認し、右スティックで
        # 画面を動かさない。既に残る探索保持もここで解除する。
        if getattr(self, "_za_mega_marker_search_view_holding", False):
            self.ZA_mega_mode5_marker_search_view_stop(relock=False)
        if not getattr(
                self, "_za_mega_mode5_view_search_block_logged", False):
            print("[MEGA_VIEW_SEARCH] initial hold; prioritize green floor")
            self._za_mega_mode5_view_search_block_logged=True
        return True
    self._za_mega_mode5_view_search_block_logged=False
    if getattr(self, "_za_mega_marker_search_view_holding", False):
        if now < getattr(self, "_za_mega_marker_search_retry_at", 0.0):
            return True
        # 連続回転の間にZLを保持する周期を入れ、マーカーを
        # 画面に入れただけで通り越さないようにする。
        self.ZA_mega_mode5_marker_search_view_stop(relock=True)
        self._za_mega_marker_search_lock_until=now + 0.45
        print("[MEGA_VIEW_SEARCH] pause view; ZL relock check")
        trace=getattr(self, "ZA_mega_mode5_trace", None)
        if callable(trace):
            trace(
                "TARGET_MARKER_MISSING",
                "pause view and retry ZL for 0.45s")
        return True
    if now < getattr(self, "_za_mega_marker_search_lock_until", 0.0):
        return True
    search_angle=float(getattr(
        self, "_za_mega_marker_search_direction", 180.0))
    if search_angle not in (0.0, 180.0):
        search_angle=180.0
    # press(0.2秒)で毎回中立へ戻さず、画像チェック中も視点入力を
    # 保持する。探索方向は時間で左右反転させない。
    search_strength=max(0.45, min(0.6, float(getattr(
        self, "_za_mega_marker_search_strength", 0.24)) * 2.0))
    # 探索のたびにZLを解除すると、敵を画面へ入れても攻撃可能に
    # 戻るまで空白が生じる。ZLは保持し、未保持時だけ先に押す。
    if getattr(self, "ZL_state", 0) == 0:
        self.ZA_ZL_ACTION("")
    self.hold(Direction(Stick.RIGHT, search_angle, search_strength), wait=0.0)
    self._za_mega_marker_search_view_holding=True
    self._za_mega_marker_search_view_angle=search_angle
    self._za_mega_marker_search_retry_at=now + 0.70
    print(
        "[MEGA_VIEW_SEARCH] rotate angle={:.0f} strength={:.2f}".format(
            search_angle, search_strength))
    trace=getattr(self, "ZA_mega_mode5_trace", None)
    if callable(trace):
        trace(
            "TARGET_MARKER_MISSING",
            "hold right-stick view angle={:.0f}".format(search_angle))
    return True

def ZA_mega_movemode_update(
        self, dir1, dir2, dir3, dir4, include_upper=0):
    """movemode 1で未ロック時は接近し、ロック後は距離を保つ。"""
    if (not getattr(self, "_za_mega_last_battle_mode", False)
            or getattr(self, "_za_mega_movemode", 0) != 1):
        return False
    now=time.monotonic()
    visual_lockon_active=bool(
        getattr(self, "ZL_state", 0) == 1
        and now < float(getattr(
            self, "_za_mega_mode5_visual_lockon_until", 0.0)))
    if (getattr(
            self, "_za_mega_mode5_low_yellow_hp_active", False)
            and visual_lockon_active):
        self._za_mega_mode5_low_yellow_hp_lock_seen=True
    yellow_low_hp_post_lock=bool(
        getattr(self, "_za_mega_mode5_low_yellow_hp_active", False)
        and getattr(
            self, "_za_mega_mode5_low_yellow_hp_lock_seen", False))
    initial_phase_active=bool(getattr(
        self, "_za_mega_mode5_initial_phase_active", False))
    initial_approach_started=bool(getattr(
        self, "_za_mega_mode5_initial_approach_started", False))
    initial_approach_until=float(getattr(
        self, "_za_mega_field_dir5_until", 0.0))
    if (initial_phase_active and initial_approach_started
            and initial_approach_until > 0.0
            and now >= initial_approach_until):
        # 緑床確認回数は画像判定の重さで実時間が大きく延びるため、
        # 3秒の初期接近終了後まで90度移動を拘束しない。
        # 未消費の確認回数も破棄し、この周回から視点探索へ切り替える。
        self._za_mega_field_dir5_until=0.0
        self._za_mega_mode5_initial_phase_active=False
        self._za_mega_mode5_green_priority_checks_remaining=0
        self._za_mega_mode5_view_search_block_until=0.0
        initial_phase_active=False
        print(
            "[MEGA_INITIAL_MOVE] 90deg approach timeout; "
            "release move and allow target search")
    if now < getattr(self, "_za_mega_field_dir5_until", 0.0):
        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,5,"RELOAD")
        return True
    if initial_phase_active:
        # 緑床の優先確認と90度の開始移動が終わるまで、マーカー／敵色を
        # 調べず同じ方向を維持する。視点探索へ早く抜けて壁へ向かわない。
        if (int(getattr(
                self,
                "_za_mega_mode5_green_priority_checks_remaining",
                0)) <= 0):
            self._za_mega_mode5_initial_phase_active=False
            self._za_mega_mode5_view_search_block_until=0.0
            print(
                "[MEGA_INITIAL_MOVE] 90deg approach complete; "
                "allow target search")
        else:
            self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,5,"RELOAD")
            return True

    marker_direction = self.ZA_mega_target_marker_direction(
        include_upper=bool(include_upper))
    if not isinstance(marker_direction, Direction):
        color_detector=getattr(
            self, "ZA_mega_mode5_colored_enemy_direction", None)
        if callable(color_detector):
            marker_direction=color_detector(
                frame=getattr(self, "_za_mega_last_target_frame", None))
    if not isinstance(marker_direction, Direction):
        cached_direction = getattr(
            self, "_za_mega_movemode_direction", None)
        if (isinstance(cached_direction, Direction)
                and now < getattr(
                    self, "_za_mega_movemode_direction_until", 0.0)):
            # 攻撃演出などの一時的な未検知では直前方向を短く使う。
            # mode 5は短いpressを繰り返すと中立パケットのたびに減速する。
            # 強度1.0の保持を継続し、その間も同じ方向へ視点探索する。
            if getattr(self, "ZL_state", 0) == 0:
                self.ZA_ZL_ACTION("")
            self._za_mega_movemode_searching=False
            cached_angle=float(cached_direction.angle_for_show)
            if yellow_low_hp_post_lock:
                # ロックオン後に残っていた接近方向（55～60度前後）を
                # 再送しない。近距離後退中だけ300度、それ以外は
                # 20度の距離維持へ置き換える。
                cached_angle=(
                    300.0 if getattr(
                        self, "_za_mega_mode5_lockon_retreating", False)
                    else 20.0)
            cached_movement=Direction(
                Stick.LEFT, cached_angle, 1.0)
            self._za_mega_movemode_direction=cached_movement
            self.ZA_MOVE_LStick(
                dir1,dir2,dir3,dir4,
                cached_movement,
                "RELOAD", force_direction=True)
            if visual_lockon_active:
                stop_search=getattr(
                    self, "ZA_mega_mode5_marker_search_view_stop", None)
                if callable(stop_search):
                    stop_search(relock=False)
            else:
                self.ZA_mega_mode5_marker_search_view()
            return True
        # 保存方向が切れた後も、最後に見えた側へ強度1.0で移動し続け、
        # 右スティックを一定方向へ保持して赤／青またはマーカーを探す。
        self._za_mega_movemode_searching=True
        self.ZA_mega_mode5_marker_search_view()
        last_side=getattr(self, "_za_mega_marker_last_side", None)
        if yellow_low_hp_post_lock:
            # 黄色低HPで一度ロックオンした後は、未検知になっても
            # 55／125度の接近フォールバックへ戻さない。
            fallback_angle=(
                160.0 if last_side == 180.0 else 20.0)
        else:
            fallback_angle=125.0 if last_side == 180.0 else 55.0
        fallback_movement=Direction(
            Stick.LEFT, fallback_angle, 1.0)
        self._za_mega_movemode_direction=fallback_movement
        self._za_mega_movemode_direction_until=now + 0.8
        self.ZA_MOVE_LStick(
            dir1,dir2,dir3,dir4,
            fallback_movement,"RELOAD",force_direction=True)
        if not getattr(
                self, "_za_mega_movemode_fallback_logged", False):
            print(
                "[MEGA_MOVEMODE] marker missing; "
                "hold move angle={:.0f} strength=1.0 while view searches".format(
                    fallback_angle))
            self._za_mega_movemode_fallback_logged=True
        trace=getattr(self, "ZA_mega_mode5_trace", None)
        if callable(trace):
            trace(
                "TARGET_AND_COLOR_MISSING",
                "continuous move angle={:.0f} while view searches".format(
                    fallback_angle))
        return True

    target_from_color=bool(getattr(
        self, "_za_mega_target_from_color", False))
    if target_from_color:
        # 色を検出できている間に固定方向の全周探索を続けると、敵を
        # 画面へ入れた直後に通り越す。敵側へ短く寄せてZLを再保持する。
        self._za_mega_movemode_searching=True
        self.ZA_mega_mode5_colored_enemy_relock()
    else:
        # 実マーカーを取り直した場合だけ視点保持を止め、
        # 移動より先にロックオンを戻す。
        stop_search=getattr(
            self, "ZA_mega_mode5_marker_search_view_stop", None)
        if callable(stop_search):
            stop_search(relock=False)
        if getattr(self, "ZL_state", 0) == 0:
            self.ZA_ZL_ACTION("")
    marker_angle=float(marker_direction.angle_for_show) % 360.0
    marker_position=getattr(
        self, "_za_mega_target_marker_position", None)
    visual_color_lockon=bool(
        target_from_color
        and getattr(self, "ZL_state", 0) == 1
        and now < float(getattr(
            self, "_za_mega_mode5_visual_lockon_until", 0.0)))
    visual_lockon_confirmed=bool(
        getattr(self, "ZL_state", 0) == 1
        and now < float(getattr(
            self, "_za_mega_mode5_visual_lockon_until", 0.0)))
    yellow_low_hp_standoff=bool(
        getattr(self, "_za_mega_mode5_low_yellow_hp_active", False)
        and visual_lockon_confirmed)
    if yellow_low_hp_standoff:
        self._za_mega_mode5_low_yellow_hp_lock_seen=True
    yellow_low_hp_post_lock=bool(
        getattr(self, "_za_mega_mode5_low_yellow_hp_active", False)
        and getattr(
            self, "_za_mega_mode5_low_yellow_hp_lock_seen", False))
    # 画面中央付近でも敵の輪郭が大きい場合は接近を打ち切る。
    # マーカーが下寄り、または赤青敵が近い間は横移動で距離を保つ。
    color_target_near=bool(
        target_from_color and getattr(
            self, "_za_mega_colored_enemy_near", False))
    marker_y=(
        float(marker_position[1])
        if marker_position else 0.0)
    lockon_retreating=bool(getattr(
        self, "_za_mega_mode5_lockon_retreating", False))
    if yellow_low_hp_standoff:
        # 近距離で斜め後退を開始し、十分に離れるまでは継続する。
        # 開始と終了の境界を分け、1フレームの位置揺れで
        # 300度／20度を往復しないようにする。
        if lockon_retreating:
            lockon_retreating=bool(
                color_target_near or marker_y > 360.0)
        else:
            lockon_retreating=bool(
                color_target_near or marker_y >= 420.0)
    else:
        lockon_retreating=False
    self._za_mega_mode5_lockon_retreating=lockon_retreating
    near_target=bool(
        marker_position
        and (float(marker_position[1]) >= 460.0
             or color_target_near
             or lockon_retreating))
    previous_near=bool(getattr(
        self, "_za_mega_movemode_near_target", False))
    if yellow_low_hp_standoff:
        # 黄色HP約1/4で再開した場合だけ、ロックオン後は敵方向へ
        # 接近し続けない。近い間は通常方向に対応する斜め後方
        # （0度側なら300度）へ下がり、ロックオンを維持できる距離まで
        # 離れたら0～20度側の横移動へ切り替える。攻撃は継続する。
        normal_angle=float(dir1) % 360.0
        normal_on_right=bool(
            normal_angle <= 90.0 or normal_angle >= 270.0)
        if lockon_retreating:
            move_angle=300.0 if normal_on_right else 240.0
        else:
            move_angle=(
                max(0.0, min(20.0, normal_angle))
                if normal_on_right
                else max(160.0, min(180.0, normal_angle)))
        movement=Direction(Stick.LEFT, move_angle, 1.0)
        self._za_mega_movemode_orbit_until=0.0
    elif yellow_low_hp_post_lock:
        # 一度ロックオンした後に画像が一時的に外れても、赤青の
        # 位置由来の約60～90度へ接近しない。20度側で距離を保ち、
        # 視点探索とZL再入力による再捕捉だけを行う。
        normal_angle=float(dir1) % 360.0
        move_angle=(
            max(0.0, min(20.0, normal_angle))
            if normal_angle <= 90.0 or normal_angle >= 270.0
            else max(160.0, min(180.0, normal_angle)))
        movement=Direction(Stick.LEFT, move_angle, 1.0)
        self._za_mega_movemode_orbit_until=0.0
    elif visual_color_lockon:
        # ロックオン済みならゲーム側が敵を正面へ追尾する。近距離では
        # 直進せず20/160度の横移動へ切り替え、攻撃距離を残す。
        if near_target:
            orbit_sign=int(getattr(
                self, "_za_mega_movemode_orbit_sign", 1))
            if orbit_sign not in (-1, 1):
                orbit_sign=1
            self._za_mega_movemode_orbit_sign=orbit_sign
            move_angle=(160.0 if orbit_sign > 0 else 20.0)
        else:
            move_angle=max(20.0, min(160.0, float(dir1)))
        movement=Direction(Stick.LEFT, move_angle, 1.0)
        self._za_mega_movemode_orbit_until=0.0
    elif near_target:
        orbit_sign=int(getattr(
            self, "_za_mega_movemode_orbit_sign", 1))
        if orbit_sign not in (-1, 1):
            orbit_sign=1
        self._za_mega_movemode_orbit_sign=orbit_sign
        # 周回方向も3秒ごとに反転するとロックオンカメラも
        # 左右往復し、移動幅が小さくなる。mode 5は一方向の周回を維持する。
        self._za_mega_movemode_orbit_until=now + 3.0
        # mode 5では後方（180～360度）へ回り込むとロックオンが外れ
        # やすいため、前方半面の範囲でだけ左右へ動く。
        # 真横の0/180度まで寄せると、緑床待機の解除直後などに
        # 床の外へ一直線に抜けやすい。前方寄りの20～160度に留める。
        move_angle=max(
            20.0,
            min(160.0, marker_angle + 55.0 * orbit_sign))
        movement=Direction(Stick.LEFT, move_angle, 1.0)
    else:
        # 接近時も真横・後方へ抜けない。マーカーが端に見えても
        # 前方成分を残し、柵へ0度で押し続ける状態を避ける。
        move_angle=max(20.0, min(160.0, marker_angle))
        movement=Direction(Stick.LEFT, move_angle, 1.0)
        self._za_mega_movemode_orbit_until=0.0

    self._za_mega_movemode_fallback_logged=False
    self._za_mega_movemode_searching=target_from_color
    self._za_mega_movemode_missing_move_retry_at=0.0
    self._za_mega_movemode_near_target=near_target
    self._za_mega_movemode_direction=movement
    # 攻撃演出でマーカーが短時間隠れても接近方向を失わない。
    # 誤検知した壁方向を長く保持しない。短い攻撃演出だけを補える
    # 1.0秒に留め、その後は固定方向の視点探索へ移る。
    self._za_mega_movemode_direction_until=(
        now + (
            0.35 if lockon_retreating
            else (0.55 if getattr(
                self, "_za_mega_target_from_color", False) else 1.0)))
    # ターゲット捕捉後も中立へ戻さず、強度1.0を次の判定まで保持する。
    # 次周回で位置を取り直して方向だけ置換するため、停止パルスを挟まない。
    self.ZA_MOVE_LStick(
        dir1,dir2,dir3,dir4,
        movement,"RELOAD",force_direction=True)
    trace=getattr(self, "ZA_mega_mode5_trace", None)
    if callable(trace):
        if target_from_color:
            detection="{}_ENEMY".format(str(getattr(
                self, "_za_mega_colored_enemy_color", "COLOR")).upper())
        else:
            detection=str(getattr(
                self, "last_image_detection", {}).get(
                    "name", "TARGET_MARKER"))
        if yellow_low_hp_standoff and lockon_retreating:
            trace_action=(
                "yellow low HP lock; diagonal retreat angle={:.1f}")
        elif yellow_low_hp_standoff:
            trace_action=(
                "yellow low HP lock; range reached lateral angle={:.1f}")
        elif yellow_low_hp_post_lock:
            trace_action=(
                "yellow low HP post-lock; block approach angle={:.1f}")
        elif visual_color_lockon and near_target:
            trace_action=(
                "visual lock close; standoff move angle={:.1f}")
        elif visual_color_lockon:
            trace_action=(
                "visual lock confirmed; hold dir1 angle={:.1f}")
        else:
            trace_action=(
                "continuous move angle={:.1f} toward target")
        trace(
            detection,
            trace_action.format(float(movement.angle_for_show)))
    if near_target != previous_near:
        if yellow_low_hp_standoff:
            movement_state=(
                "retreat" if lockon_retreating else "range_hold")
        else:
            movement_state=("orbit" if near_target else "approach")
        print(
            "[MEGA_MOVEMODE] {} angle={:.1f} marker_y={:.1f}".format(
                movement_state,
                float(movement.angle_for_show),
                float(marker_position[1])))
    return True

def ZA_mega_green_safe_floor_direction(self, frame=None):
    """画面下部の緑床について、足元到達状態と移動方向を返す。"""
    self._za_mega_green_floor_move_seconds=0.0
    self._za_mega_green_floor_distance_ratio=0.0
    if frame is None:
        camera=getattr(self, "camera", None)
        if camera is None:
            return False, None, 0.0
        if hasattr(camera, "readFreshFrame"):
            frame=camera.readFreshFrame(timeout=0.75)
        else:
            frame=(camera.readFrame()
                   if hasattr(camera, "readFrame") else None)
    if frame is None or getattr(frame, "size", 0) == 0:
        return False, None, 0.0

    height,width=frame.shape[:2]
    x0,x1=int(width * 0.05),int(width * 0.95)
    # 最終戦の安全床は遠方では画面上寄りに横長で現れる。
    # 従来の38%開始では見えている床を候補にできなかったため、
    # 上側まで探索し、下側UIは後段の形状・位置条件で除外する。
    y0,y1=int(height * 0.20),int(height * 0.96)
    region=frame[y0:y1, x0:x1]
    if region.size == 0:
        return False, None, 0.0
    hsv=cv2.cvtColor(region, cv2.COLOR_BGR2HSV)
    # 安全床は明るい黄緑～緑。暗い青緑の岩（H≈105/V≈60）は
    # 床ではないため、色相上限と明度下限の両方で除外する。
    hsv_green_mask=cv2.inRange(hsv, (25, 40, 80), (95, 255, 255))
    blue,green,red=cv2.split(region)
    green_dominant=(
        (green.astype("int16") >= red.astype("int16") + 12)
        & (green.astype("int16") >= blue.astype("int16") + 8)
        & (green >= 85))
    green_mask=cv2.bitwise_or(
        hsv_green_mask,
        (green_dominant.astype("uint8") * 255))
    kernel=cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))
    green_mask=cv2.morphologyEx(
        green_mask, cv2.MORPH_OPEN, kernel)
    green_mask=cv2.morphologyEx(
        green_mask, cv2.MORPH_CLOSE, kernel)

    # カメラ原画では主人公の足元は画面中央付近。Commands録画の
    # 右側ログ表示でゲーム像が縮んだ座標を基準にしない。
    foot_x0=max(0, int(width * 0.42) - x0)
    foot_x1=min(region.shape[1], int(width * 0.60) - x0)
    foot_y0=max(0, int(height * 0.72) - y0)
    foot_y1=min(region.shape[0], int(height * 0.95) - y0)
    # 足元到達は輪郭整形前のHSVマスクを使う。床の境界ではOPEN処理で
    # 緑画素が約3割失われ、実際には床へ入っていても見逃していた。
    # HSVだけなら灰色床や暗い青緑を拾わず、左下UIの誤認も抑えられる。
    foot_mask=hsv_green_mask[foot_y0:foot_y1, foot_x0:foot_x1]
    foot_pixels=max(1, int(foot_mask.size))
    foot_ratio=float(cv2.countNonZero(foot_mask)) / foot_pixels
    # 緑文字・ゲージ・攻撃エフェクトの点在画素を床上と誤認しないよう、
    # 総量だけでなく連続した緑領域の大きさも確認する。
    foot_kernel=cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (7, 7))
    foot_floor_mask=cv2.morphologyEx(
        foot_mask, cv2.MORPH_OPEN, foot_kernel)
    foot_contours,_=cv2.findContours(
        foot_floor_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    largest_foot_area=max(
        (float(cv2.contourArea(contour)) for contour in foot_contours),
        default=0.0)
    largest_foot_ratio=largest_foot_area / foot_pixels
    # 実際の床境界は足元領域の約1割を連続して占める。
    if foot_ratio >= 0.10 and largest_foot_ratio >= 0.07:
        return True, None, foot_ratio

    contours,_=cv2.findContours(
        green_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    # 安全床はまとまった面積を持つ。従来の250pxでは左下UIや
    # 緑色の攻撃エフェクトまで候補になったため、画面比率で除外する。
    minimum_area=max(
        1800.0,
        float(region.shape[0] * region.shape[1]) * 0.006)
    # 最終戦の通常カメラにおける主人公の足元位置。画面中央を使うと
    # 右前方の床へ必要以上に横移動するため、実録画の表示位置へ合わせる。
    player_x=float(width) * 0.50
    player_y=float(height) * 0.88
    candidates=[]
    for contour in contours:
        area=float(cv2.contourArea(contour))
        if area < minimum_area:
            continue
        rect_x,rect_y,rect_w,rect_h=cv2.boundingRect(contour)
        if (rect_w < int(width * 0.05)
                or rect_h < int(height * 0.025)
                or float(rect_w) / max(1.0, float(rect_h)) < 1.2
                or float(rect_w) / max(1.0, float(rect_h)) > 12.0):
            continue
        moments=cv2.moments(contour)
        if not moments.get("m00"):
            continue
        center_x=float(moments["m10"] / moments["m00"] + x0)
        center_y=float(moments["m01"] / moments["m00"] + y0)
        # 遠方の安全床も候補にする。探索領域の上端に貼り付く
        # 細い色ノイズだけをここで除外する。
        if center_y < float(height) * 0.22:
            continue
        # 画面最下部は手持ち／技UIの領域であり、緑床の探索対象外。
        if center_y > float(height) * 0.92:
            continue
        # 左下の出撃ポケモンHP枠を除外する。ただし接近した安全床も
        # 左下へ大きく広がるため、十分な面積と縦幅がある領域は残す。
        if (center_x < float(width) * 0.32
                and center_y > float(height) * 0.70
                and (rect_h < int(height * 0.12)
                     or area < float(region.shape[0] * region.shape[1]) * 0.02)):
            continue
        distance=math.hypot(center_x - player_x, center_y - player_y)
        candidates.append((area / (1.0 + distance * 0.5), center_x, center_y))
    if not candidates:
        return False, None, foot_ratio

    _,target_x,target_y=max(candidates, key=lambda item: item[0])
    delta_x=target_x - player_x
    delta_y=player_y - target_y
    angle=(math.degrees(math.atan2(delta_y, delta_x)) + 360.0) % 360.0
    # 継続追従ではなく、床中心までの画面上距離から1回分の移動時間を
    # 決める。最終戦の遠方床は従来係数では到達前に止まっていたため、
    # 最大強度のまま距離係数を上げ、3秒以内の1回移動で到達を狙う。
    # contour走査の最後の候補ではなく、実際に採用した床中心との
    # 距離から移動時間を決める。
    distance=math.hypot(delta_x, delta_y)
    distance_ratio=distance / max(1.0, float(height))
    self._za_mega_green_floor_distance_ratio=distance_ratio
    self._za_mega_green_floor_move_seconds=max(
        0.35, min(3.0, distance_ratio * 7.0))
    return False, Direction(Stick.LEFT, angle, 1.0), foot_ratio

def ZA_mega_z_guard_update(
        self, dir1, dir2, dir3, dir4, wait_seconds=2.5,
        hold_until_disappears=False):
    """Z_Gaurd 1で緑床へ移動し、通常は2.5秒停止する。"""
    wait_seconds=max(0.0, float(wait_seconds))
    if not getattr(self, "_za_mega_z_guard_enabled", False):
        return False
    now=time.monotonic()
    hp75_initial_green=bool(
        getattr(self, "_za_mega_last_battle_mode", False)
        and getattr(self, "_za_mega_testmode1_enabled", False)
        and getattr(self, "_za_mega_testmode1_resume_hp", "") == "HP75"
        and getattr(self, "_za_mega_testmode1_phase", "")
        == "HP75_EXISTING"
        and getattr(self, "_za_mega_mode5_initial_phase_active", False)
        and not hold_until_disappears)
    hp75_green_angle=90.0
    if hp75_initial_green:
        settings_getter=getattr(
            self, "ZA_mega_mode5_testmode1_settings", None)
        if callable(settings_getter):
            hp75_green_angle=float(settings_getter()[
                "HP75_INITIAL_GREEN_MOVE_ANGLE"])
        # HP75再開直後は緑床の画面位置に合わせて視点を回さず、
        # 現在画角のまま固定方向へ移動する。
        self.ZA_mega_mode5_marker_search_view_stop(relock=False)
        self.ZA_MOVE_SEE(action="END")
    on_green,direction,foot_ratio=(
        self.ZA_mega_green_safe_floor_direction())
    move_seconds=max(0.0, float(getattr(
        self, "_za_mega_green_floor_move_seconds", 0.0)))
    # 移動時間だけを増やすと、従来の2.2秒基準で近い床まで遠方扱いに
    # なってしまう。遠方破棄は画面上の実距離で判定し、移動幅と分離する。
    floor_distance_ratio=max(0.0, float(getattr(
        self, "_za_mega_green_floor_distance_ratio",
        move_seconds / 4.5)))
    if ((on_green or isinstance(direction, Direction))
            and not getattr(self, "_za_mega_z_guard_holding", False)):
        # 遠方として追跡を破棄する場合も、床を検知した時点で先に
        # mode 5探索保持と通常Rstickを止める。従来は遠方分岐が
        # 先にreturnし、復帰直後でも視点だけ回り続けていた。
        self.ZA_mega_mode5_marker_search_view_stop(relock=False)
        self.ZA_MOVE_SEE(action="END")
    # 最終戦は攻撃時間を優先する。画面距離から2.2秒を超える床だけを
    # 遠方とみなし、その床が消えるまで再追跡しない。
    if (getattr(self, "_za_mega_last_battle_mode", False)
            and not getattr(
                self, "_za_mega_mode5_initial_phase_active", False)
            and not getattr(self, "_za_mega_z_guard_holding", False)
            and not on_green and isinstance(direction, Direction)
            and floor_distance_ratio > (2.2 / 4.5)):
        self._za_mega_z_guard_skip_current_floor=True
        self._za_mega_z_guard_skip_last_seen=now
        print(
            "[MEGA_Z_GUARD] skip distant floor "
            "duration={:.2f}s; prioritize attack".format(move_seconds))
        trace=getattr(self, "ZA_mega_mode5_trace", None)
        if callable(trace):
            trace(
                "GREEN_FLOOR_TOO_FAR",
                "skip floor and continue target attack")
        return False
    if getattr(self, "_za_mega_z_guard_skip_current_floor", False):
        if getattr(
                self, "_za_mega_z_guard_normal_hold_completed", False):
            # 通常時の2.5秒待機後は、同じ床を再取得して
            # 停止ループに戻らない。床が消えたら次の候補を許可する。
            if on_green or isinstance(direction, Direction):
                self._za_mega_z_guard_skip_last_seen=now
                return False
            if now - float(getattr(
                    self, "_za_mega_z_guard_skip_last_seen", now)) < 0.6:
                return False
            self._za_mega_z_guard_skip_current_floor=False
            self._za_mega_z_guard_skip_last_seen=0.0
            self._za_mega_z_guard_normal_hold_completed=False
            print(
                "[MEGA_Z_GUARD] completed floor disappeared; "
                "allow next floor")
        else:
            if on_green:
                # 破棄中でも足元へ床が来た場合は通り越さず、通常の
                # 床上確認へ戻す。
                self._za_mega_z_guard_skip_current_floor=False
                self._za_mega_z_guard_skip_last_seen=0.0
                print("[MEGA_Z_GUARD] reached skipped floor; hold")
            else:
                if isinstance(direction, Direction):
                    self._za_mega_z_guard_skip_last_seen=now
                    # 1回移動で届かなかった同じ床を繰り返し追わない。
                    # 敵追従・攻撃はこの周回から再開できる。
                    return False
                if now - float(getattr(
                        self, "_za_mega_z_guard_skip_last_seen", now)) < 0.6:
                    return False
                self._za_mega_z_guard_skip_current_floor=False
                self._za_mega_z_guard_skip_last_seen=0.0
                print("[MEGA_Z_GUARD] skipped floor disappeared; allow next floor")
    if (not getattr(self, "_za_mega_z_guard_holding", False)
            and not on_green and isinstance(direction, Direction)):
        # 最初の候補は右スティック停止直前の回転中フレームから
        # 算出されている。停止後の画面で方向を取り直さないと、
        # 実際の床位置と移動角度がずれるためfresh frameを再取得する。
        self.wait(0.1)
        settled_on_green,settled_direction,settled_foot_ratio=(
            self.ZA_mega_green_safe_floor_direction())
        if (not settled_on_green
                and not isinstance(settled_direction, Direction)):
            print(
                "[MEGA_Z_GUARD] floor candidate lost after view stop; "
                "skip movement")
            return False
        on_green=settled_on_green
        direction=settled_direction
        foot_ratio=settled_foot_ratio
        # 視点停止後の再取得で距離も更新されるため、移動上限には
        # 停止前ではなく、この確定フレームの距離を使用する。
        move_seconds=max(0.0, float(getattr(
            self, "_za_mega_green_floor_move_seconds", move_seconds)))
        floor_distance_ratio=max(0.0, float(getattr(
            self, "_za_mega_green_floor_distance_ratio",
            floor_distance_ratio)))
        if (hp75_initial_green and not on_green
                and isinstance(direction, Direction)):
            direction=Direction(
                Stick.LEFT, hp75_green_angle, 1.0)
    if getattr(self, "_za_mega_z_guard_holding", False):
        # 一度でも緑床移動／床上待機へ入った後は、FIELDだけで
        # TESTMODE1障害物経路を再開しない。
        enter_legacy=getattr(
            self, "ZA_mega_mode5_testmode1_enter_legacy", None)
        if callable(enter_legacy):
            enter_legacy("GREEN_FLOOR")
        # 待機を続けるのは足元が緑の場合だけ。離れた場所に緑床が
        # 見えているだけで、移動を止め続けない。
        floor_visible=on_green
        if floor_visible:
            self._za_mega_z_guard_last_seen=now
        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
        if (floor_visible
                and getattr(self, "_za_mega_last_battle_mode", False)):
            testmode1_green_latched=bool(
                getattr(self, "_za_mega_testmode1_enabled", False)
                and getattr(
                    self, "_za_mega_testmode1_legacy_until_reset", False))
            if hp75_initial_green or testmode1_green_latched:
                # TESTMODE1を通常mode5へ切り替えた後も、
                # 現在の緑床待機が終わるまで視点は固定する。
                self.ZA_mega_mode5_marker_search_view_stop(relock=False)
                self.ZA_MOVE_SEE(action="END")
            else:
                # 通常時は左移動を止めたまま、右スティックだけで次の
                # 赤／青・ターゲットマーカーを先に探してよい。
                self.ZA_mega_mode5_marker_search_view()
        hold_until=float(getattr(
            self, "_za_mega_z_guard_hold_until", 0.0))
        if getattr(
                self, "_za_mega_z_guard_hold_until_disappears", False):
            # 強い光の予兆中だけは、単一フレームのエフェクトで
            # 解除せず、緑床が0.6秒連続で消えるまで待機する。
            if (floor_visible or now - float(getattr(
                    self, "_za_mega_z_guard_last_seen", now)) < 0.6):
                return True
        elif now < hold_until:
            return True
        self._za_mega_z_guard_holding=False
        self._za_mega_z_guard_active=False
        self._za_mega_z_guard_on_green_count=0
        self._za_mega_z_guard_direction=None
        self._za_mega_z_guard_direction_until=0.0
        if getattr(
                self, "_za_mega_z_guard_hold_until_disappears", False):
            print("[MEGA_Z_GUARD] green floor disappeared; resume battle")
        else:
            # 通常時は床表示が残っても固定待機で必ず復帰する。
            # 同じ床が消えるまでは再追跡しない。
            self._za_mega_z_guard_normal_hold_completed=True
            self._za_mega_z_guard_skip_current_floor=True
            self._za_mega_z_guard_skip_last_seen=now
            print(
                "[MEGA_Z_GUARD] post-move wait complete; "
                "resume battle and ignore same floor")
        self._za_mega_z_guard_hold_until=0.0
        self._za_mega_z_guard_hold_until_disappears=False
        return False

    if on_green:
        # 単一フレームの緑エフェクトでは停止しない。連続2フレームで
        # 足元のまとまった緑領域を確認した場合だけ床上待機へ入る。
        # ただし1フレーム目でも旧方向を再送せず即時停止し、静止状態で
        # 2フレーム目を確認する。これにより床の通り越しを防ぐ。
        on_green_count=(
            int(getattr(self, "_za_mega_z_guard_on_green_count", 0)) + 1)
        self._za_mega_z_guard_on_green_count=on_green_count
        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
        self._za_mega_z_guard_active=False
        self._za_mega_z_guard_direction=None
        self._za_mega_z_guard_direction_until=0.0
        if on_green_count < 2:
            print(
                "[MEGA_Z_GUARD] green floor edge detected; brake and confirm")
            return True
        enter_legacy=getattr(
            self, "ZA_mega_mode5_testmode1_enter_legacy", None)
        if callable(enter_legacy):
            enter_legacy("GREEN_FLOOR")
        self._za_mega_z_guard_holding=True
        self._za_mega_z_guard_last_seen=now
        self._za_mega_z_guard_hold_until=(now + wait_seconds)
        self._za_mega_z_guard_hold_until_disappears=bool(
            hold_until_disappears)
        self._za_mega_z_guard_normal_hold_completed=False
        # 到達前の接近／周回方向を残すと、床消失後に古い0度系の
        # 入力を再利用する場合があるため、待機開始時に破棄する。
        self._za_mega_movemode_direction=None
        self._za_mega_movemode_direction_until=0.0
        self._za_mega_movemode_orbit_until=0.0
        print(
            "[MEGA_Z_GUARD] green floor reached ratio={:.3f}; {}".format(
                foot_ratio,
                ("hold until gone" if hold_until_disappears
                 else "hold {:.1f}s".format(wait_seconds))))
        return True
    self._za_mega_z_guard_on_green_count=0
    if isinstance(direction, Direction):
        # 確定した床方向へ動く直前にも、指定回転と探索保持の両方を
        # 明示的に停止する。緑床移動中は右スティックを再開しない。
        enter_legacy=getattr(
            self, "ZA_mega_mode5_testmode1_enter_legacy", None)
        if callable(enter_legacy):
            enter_legacy("GREEN_FLOOR")
        self.ZA_mega_mode5_marker_search_view_stop(relock=False)
        self.ZA_MOVE_SEE(action="END")
        print(
            "[MEGA_Z_GUARD] green floor found; one-shot move "
            "angle={:.1f} duration={:.2f}s strength=1.0{}".format(
                float(direction.angle_for_show), move_seconds,
                " HP75_FIXED_VIEW" if hp75_initial_green else ""))
        trace=getattr(self, "ZA_mega_mode5_trace", None)
        if callable(trace):
            trace(
                "GREEN_FLOOR",
                "stop view; {}move angle={:.1f} duration={:.2f}s".format(
                    "HP75 fixed-view " if hp75_initial_green else "continuous ",
                    float(direction.angle_for_show), move_seconds))
        # それまでの戦闘移動を緑床方向へ置換する。短いpressを繰り返すと
        # 区間ごとに中立へ戻って減速するため、移動中は強度1.0を保持し、
        # 方向だけを更新する。到達後は左スティックを必ず中立へ戻す。
        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
        # ロックオン中の横移動は遅いため、安全床への移動時だけZLを
        # 解除し、最大強度1.0の通常移動にする。
        if getattr(self, "ZL_state", 0) != 0:
            self.ZA_ZL_ACTION("END")
        move_limit=max(0.25, min(3.0, move_seconds))
        moved_seconds=0.0
        post_on_green=False
        post_direction=direction
        move_direction=direction
        post_ratio=foot_ratio
        missing_direction_checks=0
        while moved_seconds + 0.001 < move_limit:
            # 0.10秒ごとに床位置を取り直すが、左スティックは解除しない。
            # ZA_MOVE_LStickは同じStickの保持値を1パケットで置換する。
            self.ZA_MOVE_LStick(
                dir1,dir2,dir3,dir4,
                Direction(
                    Stick.LEFT,
                    move_direction.angle_for_show,
                    1.0),
                "RELOAD",force_direction=True)
            step_seconds=max(
                0.0, min(0.10, move_limit - moved_seconds))
            self.wait(step_seconds)
            moved_seconds+=step_seconds
            post_on_green,post_direction,post_ratio=(
                self.ZA_mega_green_safe_floor_direction())
            if post_on_green:
                break
            if isinstance(post_direction, Direction):
                if not hp75_initial_green:
                    move_direction=post_direction
                missing_direction_checks=0
                continue
            # 移動中のブラーや攻撃エフェクトで床候補が消えても、
            # 最初に2フレーム確認した床までの距離予算は使い切る。
            # 上限は画面距離から算出済み（最大3秒）なので無制限にはならない。
            missing_direction_checks+=1
            if missing_direction_checks == 1:
                print(
                    "[MEGA_Z_GUARD] floor temporarily missed; "
                    "keep strength=1.0 until move budget ends")
            continue
        # 緑床到達後／移動予算終了後は左移動を残さない。
        # 右スティック探索はこの停止対象に含めない。
        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
        self._za_mega_z_guard_active=False
        self._za_mega_z_guard_direction=None
        self._za_mega_z_guard_direction_until=0.0
        if post_on_green:
            self._za_mega_z_guard_holding=True
            hold_started_at=time.monotonic()
            self._za_mega_z_guard_last_seen=hold_started_at
            self._za_mega_z_guard_hold_until=(
                hold_started_at + wait_seconds)
            self._za_mega_z_guard_hold_until_disappears=bool(
                hold_until_disappears)
            self._za_mega_z_guard_normal_hold_completed=False
            self._za_mega_z_guard_on_green_count=2
            self._za_mega_z_guard_skip_current_floor=False
            self._za_mega_z_guard_skip_last_seen=0.0
            self._za_mega_movemode_direction=None
            self._za_mega_movemode_direction_until=0.0
            self._za_mega_movemode_orbit_until=0.0
            print(
                "[MEGA_Z_GUARD] one-shot move reached floor "
                "ratio={:.3f}; {}".format(
                    post_ratio,
                    ("hold until gone" if hold_until_disappears
                     else "hold {:.1f}s".format(wait_seconds))))
            return True
        # 距離予算を使い切っても床が見えている場合だけ、同じ床を
        # 再追従し続けない。候補自体が消えた場合は次の床を許可する。
        # 床上判定を取りこぼしても、移動後は2〜3秒の
        # 停止を確実に入れる。停止後は同じ床を再追跡しない。
        hold_started_at=time.monotonic()
        self._za_mega_z_guard_holding=True
        self._za_mega_z_guard_last_seen=hold_started_at
        self._za_mega_z_guard_hold_until=(
            hold_started_at + wait_seconds)
        self._za_mega_z_guard_hold_until_disappears=bool(
            hold_until_disappears)
        self._za_mega_z_guard_normal_hold_completed=False
        self._za_mega_z_guard_on_green_count=0
        self._za_mega_z_guard_skip_current_floor=isinstance(
            post_direction, Direction)
        self._za_mega_z_guard_skip_last_seen=(
            time.monotonic()
            if self._za_mega_z_guard_skip_current_floor else 0.0)
        print(
            "[MEGA_Z_GUARD] one-shot move ended; "
            "hold {:.1f}s (moved={:.2f}/{:.2f}s candidate={})".format(
                wait_seconds,
                moved_seconds, move_limit,
                isinstance(post_direction, Direction)))
        return True
    self._za_mega_z_guard_active=False
    self._za_mega_z_guard_direction=None
    self._za_mega_z_guard_direction_until=0.0
    return False

def ZA_mega_relock_toward_marker(self,dir1,dir2,dir3,dir4,dodge_repeat=0,include_upper_marker=0):
    now = time.monotonic()
    if (now < getattr(
            self, "_za_mega_field_dir5_until", 0.0)
            and getattr(self, "_za_mega_dir5", -1) >= 0):
        # dir5開始移動中も、ロックオンし直して移動を途切れさせない。
        if dodge_repeat:
            self.pressRep(
                Button.Y,
                repeat=dodge_repeat,
                duration=0.04,
                wait=0.0,
                interval=0.1)
        self.ZA_MOVE_LStick(
            dir1,dir2,dir3,dir4,5,"RELOAD")
        return
    if now < getattr(
            self, "_za_mega_field_dir4_until", 0.0):
        # 再開直後はZL解除・小幅補正・待機の反復を行わず、
        # 回避ボタンを保ったまdir4の連続移動を優先する。
        if dodge_repeat:
            self.pressRep(
                Button.Y,
                repeat=dodge_repeat,
                duration=0.04,
                wait=0.0,
                interval=0.1)
        self.ZA_MOVE_LStick(
            dir1,dir2,dir3,dir4,4,"RELOAD")
        return
    if dodge_repeat:
        self.pressRep(
            Button.Y,
            repeat=dodge_repeat,
            duration=0.04,
            wait=0.0,
            interval=0.1)
    # 前回のマーカー補正が残っていても、先に通常移動へ戻す。
    resume_dirnum = self.ZA_mega_keep_left_moving(
        dir1,dir2,dir3,dir4)
    if now < getattr(self, "_za_mega_relock_retry_at", 0.0):
        return
    mode5_dynamic=bool(
        getattr(self, "_za_mega_last_battle_mode", False)
        and getattr(self, "_za_mega_movemode", 0) == 1)
    # 直接Lを送る経路は抑えているため、mode 5は2秒ごとに短時間だけ
    # 再取得を試し、ロックオンが外れたままの時間を長くしない。
    self._za_mega_relock_retry_at = now + (
        2.0 if mode5_dynamic else 1.0)
    marker_direction = self.ZA_mega_target_marker_direction(
        include_upper=bool(include_upper_marker))
    # mode 0～4は従来どおり、マーカー確認後に一度ZLを解除する。
    # mode 5だけは未検知探索中の非ロックオン時間を増やさない。
    if not mode5_dynamic:
        self.ZA_ZL_ACTION("END")
    if marker_direction:
        if mode5_dynamic:
            self.ZA_ZL_ACTION("END")
        self.ZA_MOVE_LStick(
            dir1,dir2,dir3,dir4,marker_direction,"RELOAD")
        # mode 5の非ロックオン時間を最短化する。
        self.wait(
            0.1 if mode5_dynamic else 0.2)
        # マーカー方向を保持したままLでその向きを画面中央へ合わせる。
        self.pressRep(
            Button.L,
            repeat=1,
            duration=0.04,
            wait=0.0,
            interval=0.1)
        self.ZA_ZL_ACTION("")
    else:
        if mode5_dynamic:
            self.ZA_mega_mode5_marker_search_view()
        else:
            # 通常modeの旧動作：短い解除間隔後にZLを再入力する。
            self.wait(0.1)
            self.ZA_ZL_ACTION("")
    self.ZA_MOVE_LStick(
        dir1,dir2,dir3,dir4,resume_dirnum,"RELOAD")
def ZA_mega_nonfield_picture_confirmed(self,picture):
    # 戦闘中の一時的な誤検知で移動をENDしない。
    # 移動を保持したまま次フレーム側で再確認する。
    self.wait(0.05)
    return (
        not self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK")
        and self.image_check(picture)
    )

def ZA_mega_last_battle_tutorial_confirmed(
        self, initial_wait=0.4, attempts=5, interval=0.2):
    # 汎用3_SELECTは選択画面の描画途中でも先に一致し得るため、
    # 専用テンプレートが安定するまで少し待って複数フレームを確認する。
    self.wait(initial_wait)
    attempts=max(1, int(attempts))
    for attempt in range(attempts):
        if (self.image_check("POKEMON_ZA_3_SELECT_TUTORIAL")
                and self.ZA_mega_nonfield_picture_confirmed(
                    "POKEMON_ZA_3_SELECT_TUTORIAL")):
            return True
        if attempt + 1 < attempts:
            self.wait(interval)
    return False

def ZA_mega_red_screen_edge_check(
        self, frame=None, edge_fraction=0.08,
        side_red_ratio=0.06, total_red_ratio=0.04):
    """上下左右のうち2辺以上が赤いダメージ画面だけを検知する。"""
    if frame is None:
        camera = getattr(self, "camera", None)
        if camera is None:
            return False
        try:
            if hasattr(camera, "readFreshFrame"):
                frame = camera.readFreshFrame(timeout=0.75)
            else:
                frame = camera.readFrame() if hasattr(
                    camera, "readFrame") else None
        except RuntimeError:
            return False
    if (frame is None or getattr(frame, "size", 0) == 0
            or len(frame.shape) != 3):
        return False
    if frame.shape[2] == 4:
        frame = cv2.cvtColor(frame, cv2.COLOR_BGRA2BGR)
    elif frame.shape[2] != 3:
        return False

    height, width = frame.shape[:2]
    edge_y = max(1, min(height // 2, int(height * edge_fraction)))
    edge_x = max(1, min(width // 2, int(width * edge_fraction)))
    middle_top = edge_y
    middle_bottom = max(middle_top + 1, height - edge_y)
    edge_regions = (
        frame[:edge_y, :],
        frame[height - edge_y:, :],
        frame[middle_top:middle_bottom, :edge_x],
        frame[middle_top:middle_bottom, width - edge_x:],
    )
    red_pixels = 0
    edge_pixels = 0
    red_sides = 0
    for region in edge_regions:
        if region.size == 0:
            continue
        hsv = cv2.cvtColor(region, cv2.COLOR_BGR2HSV)
        red_mask = cv2.bitwise_or(
            cv2.inRange(hsv, (0, 90, 60), (15, 255, 255)),
            cv2.inRange(hsv, (165, 90, 60), (179, 255, 255)))
        region_pixels = int(region.shape[0] * region.shape[1])
        region_red_pixels = int(cv2.countNonZero(red_mask))
        edge_pixels += region_pixels
        red_pixels += region_red_pixels
        if (region_pixels > 0
                and region_red_pixels / region_pixels >= side_red_ratio):
            red_sides += 1
    return (
        red_sides >= 2
        and edge_pixels > 0
        and red_pixels / edge_pixels >= total_red_ratio)

def ZA_mega_red_edge_y_renda(
        self, seconds, endpicture="", end2picture="",
        repeat_count=0):
    """赤い画面端を避けるためYを送り、停止理由を返す。"""
    endpictures = tuple(
        picture for picture in (endpicture, end2picture) if picture)
    repeat_count=max(0, int(repeat_count))
    if repeat_count:
        for repeat_index in range(repeat_count):
            self.checkIfAlive()
            if any(self.image_check(picture) for picture in endpictures):
                return "endpicture"
            if self.ZA_mega_choice_input_guard():
                return "guard"
            self.pressRep(
                Button.Y, repeat=1, duration=0.04,
                wait=0.0, interval=0.05)
            if repeat_index + 1 < repeat_count:
                self.wait(0.1)
        return "complete"
    deadline = time.monotonic() + max(0.0, float(seconds))
    while time.monotonic() < deadline:
        self.checkIfAlive()
        if any(self.image_check(picture) for picture in endpictures):
            return "endpicture"
        if self.ZA_mega_choice_input_guard():
            return "guard"
        self.pressRep(
            Button.Y, repeat=1, duration=0.04,
            wait=0.0, interval=0.05)
        self.wait(min(0.1, max(0.0, deadline - time.monotonic())))
    return "complete"

def ZA_mega_last_battle_charge_dodge(
        self, dir1, dir2, dir3, dir4, see_r,
        endpicture="", end2picture="", seconds=3.0, reason="timeout"):
    """最終戦の強い光を、非ロックオンY連打で回避する。"""
    seconds=max(0.0, float(seconds))
    if reason == "green_too_far":
        # 遠い緑床は即座に破棄し、強い光の発動全体を
        # 覆えるよう非ロックオンY回避を7秒維持する。
        seconds=7.0
    self._za_mega_last_charge_state="DODGE"
    self.ZA_mega_mode5_marker_search_view_stop(relock=False)
    self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
    self.ZA_MOVE_SEE(action="END", in_see_r=see_r)
    self.ZA_ZL_ACTION("END")
    print(
        "[MEGA_CHARGE] {}: no reachable green floor; "
        "unlock and Y rolling for {:.1f}s".format(reason, seconds))
    self.ZA_mega_mode5_trace(
        "STRONG_LIGHT_" + str(reason).upper(),
        "no reachable green floor; non-lockon Y for {:.1f}s".format(
            seconds),
        force=True)
    result=self.ZA_mega_red_edge_y_renda(
        seconds, endpicture=endpicture, end2picture=end2picture)
    if result == "complete":
        # 旧移動方向は再送しない。ZLだけ戻し、次周期のmode 5探索で
        # 新しい敵方向を取得する。
        self.ZA_ZL_ACTION("")
        self._za_mega_last_charge_state="COOLDOWN"
        self._za_mega_last_charge_cooldown_until=(
            time.monotonic() + 5.0)
        self.ZA_mega_mode5_trace(
            "STRONG_LIGHT_DODGE_COMPLETE",
            "relock; wait for warning notices to disappear",
            force=True)
        return "dodge"
    self._za_mega_last_charge_state="IDLE"
    self._za_mega_last_charge_search_deadline=0.0
    return result
def ZA_mega_last_battle_charge_update(
        self, dir1, dir2, dir3, dir4, see_r,
        endpicture="", end2picture="", active=True,
        search_seconds=3.5, near_move_seconds=1.35,
        dodge_seconds=3.0):
    """最終戦の溜め通知後、近い緑床またはY回避を選択する。"""
    if (not active
            or not getattr(self, "_za_mega_last_battle_mode", False)
            or not getattr(self, "_za_mega_z_guard_enabled", False)):
        if not active:
            self._za_mega_last_charge_state="IDLE"
            self._za_mega_last_charge_search_deadline=0.0
        return "none"

    now=time.monotonic()

    def block_red_attack_premove(reason, strong_light=False):
        phase=str(getattr(
            self, "_za_mega_testmode1_phase", ""))
        waiting_strong_light=bool(getattr(
            self,
            "_za_mega_testmode1_red_premove_waiting_strong_light",
            False))
        if (not getattr(self, "_za_mega_testmode1_enabled", False)
                or (phase not in {
                    "MOVE_TO_COVER", "FACE_BLUE", "COVER_ATTACK",
                    "MOVE_TO_RED_COVER", "FACE_RED",
                    "RED_COVER_ATTACK"}
                    and not waiting_strong_light)):
            return
        settings_getter=getattr(
            self, "ZA_mega_mode5_testmode1_settings", None)
        settings=(settings_getter()
                  if callable(settings_getter) else {})
        block_seconds=max(0.0, float(settings.get(
            "RED_ATTACK_PREMOVE_BLOCK_SECONDS", 7.0)))
        if strong_light:
            # 強い光の表示中に再開しないよう、最後に確認した時点から
            # 指定秒数まで青側／赤側共通の攻撃前移動を止める。
            self._za_mega_testmode1_red_premove_waiting_strong_light=False
            self._za_mega_testmode1_red_premove_block_until=max(
                float(getattr(
                    self,
                    "_za_mega_testmode1_red_premove_block_until", 0.0)),
                time.monotonic() + block_seconds)
            self.ZA_mega_mode5_trace(
                "TESTMODE1_RED_PREMOVE_BLOCK",
                "{}; keep blue/red 270deg pre-attack move stopped for {:.1f}s".format(
                    reason, block_seconds))
        else:
            # CHARGEとSTRONG_LIGHTの間が5秒を超えても再開しない。
            # STRONG_LIGHTを確認して初めて上の5秒タイマーへ切り替える。
            self._za_mega_testmode1_red_premove_waiting_strong_light=True
            self.ZA_mega_mode5_trace(
                "TESTMODE1_RED_PREMOVE_BLOCK",
                "{}; stop blue/red 270deg pre-attack move until strong light + {:.1f}s".format(
                    reason, block_seconds))

    state=str(getattr(
        self, "_za_mega_last_charge_state", "IDLE"))
    if state == "SKIP_WAIT_CLEAR":
        if now < float(getattr(
                self, "_za_mega_last_charge_check_retry_at", 0.0)):
            return "skip"
        charge_still_visible=self.image_check(
            "POKEMON_ZA_LAST_BATTLE_CHARGE")
        strong_light_still_visible=False
        if not charge_still_visible:
            strong_light_still_visible=self.image_check(
                "POKEMON_ZA_LAST_BATTLE_STRONG_LIGHT")
        warning_still_visible=(
            charge_still_visible or strong_light_still_visible)
        self._za_mega_last_charge_check_retry_at=now + 0.5
        if warning_still_visible:
            # 同じ表示を複数回の予兆として数えない。
            warning_name=(
                "STRONG_LIGHT" if strong_light_still_visible
                else "CHARGE")
            self.ZA_mega_mode5_testmode1_warning_cycle_update(
                warning_name)
            block_red_attack_premove(
                ("strong light" if strong_light_still_visible
                 else "charge warning"),
                strong_light=strong_light_still_visible)
            return "skip"
        self._za_mega_last_charge_state="IDLE"
        self.ZA_mega_mode5_testmode1_warning_cycle_update("CLEAR")
        return "none"
    if (getattr(
            self, "_za_mega_last_charge_attack_suspended", False)
            and state in {"IDLE", "COOLDOWN"}):
        # 受理した予兆の回避完了後も、FIELD再開処理が状態を
        # リセットするまでは通常攻撃とTESTMODE1ローリングへ戻さない。
        self.ZA_mega_mode5_marker_search_view_stop(relock=False)
        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
        self.ZA_MOVE_SEE(action="END", in_see_r=see_r)
        return "guard"
    if state == "COOLDOWN":
        if now < float(getattr(
                self, "_za_mega_last_charge_cooldown_until", 0.0)):
            return "none"
        # 同じ通知が残る間は再発動しない。両通知が消えたことを
        # 確認してから次の即死攻撃予兆を受け付ける。
        if (self.image_check("POKEMON_ZA_LAST_BATTLE_CHARGE")
                or self.image_check(
                    "POKEMON_ZA_LAST_BATTLE_STRONG_LIGHT")):
            self._za_mega_last_charge_cooldown_until=now + 1.0
            return "none"
        self._za_mega_last_charge_state="IDLE"
        state="IDLE"

    if state == "GREEN":
        if (getattr(self, "_za_mega_testmode1_enabled", False)
                and not getattr(
                    self, "_za_mega_testmode1_legacy_until_reset", False)):
            # 予兆後の緑床処理中は、別経路でphaseが書き戻されても
            # 障害物用の定期Yローリングへ絶対に戻さない。
            self._za_mega_testmode1_existing_charge_latched=True
            self._za_mega_testmode1_phase="EXISTING_CHARGE"
        if self.ZA_mega_z_guard_update(
                dir1,dir2,dir3,dir4,
                hold_until_disappears=True):
            return "green"
        self._za_mega_last_charge_state="COOLDOWN"
        self._za_mega_last_charge_cooldown_until=now + 5.0
        self.ZA_mega_mode5_trace(
            "CHARGE_GREEN_COMPLETE",
            "green floor disappeared; resume battle",
            force=True)
        return "complete"

    if state == "IDLE":
        if now < float(getattr(
                self, "_za_mega_last_charge_check_retry_at", 0.0)):
            return "none"
        charge_detected=self.image_check(
            "POKEMON_ZA_LAST_BATTLE_CHARGE")
        strong_light_detected=False
        if not charge_detected:
            # 最初の通知を取りこぼしても、発動通知から直接Y回避へ
            # 入れるようにする。
            strong_light_detected=self.image_check(
                "POKEMON_ZA_LAST_BATTLE_STRONG_LIGHT")
        self._za_mega_last_charge_check_retry_at=(
            time.monotonic() + 0.5)
        if charge_detected or strong_light_detected:
            warning_name=(
                "STRONG_LIGHT" if strong_light_detected else "CHARGE")
            self.ZA_mega_mode5_testmode1_warning_cycle_update(
                warning_name)
            block_red_attack_premove(
                "strong light" if strong_light_detected
                else "charge warning",
                strong_light=strong_light_detected)
            skip_limit=0
            if getattr(self, "_za_mega_testmode1_enabled", False):
                settings_getter=getattr(
                    self, "ZA_mega_mode5_testmode1_settings", None)
                if callable(settings_getter):
                    skip_limit=int(settings_getter().get(
                        "CHARGE_WARNING_SKIP_COUNT", -1))
            testmode1_phase=str(getattr(
                self, "_za_mega_testmode1_phase", ""))
            if skip_limit < 0 and testmode1_phase != "LEGACY_COMBAT":
                # -1は予兆をTESTMODE1終了条件にしない。表示が残る間の
                # 重複判定だけ抑止する。赤色の直接確認、または予兆
                # セット間の青不在による赤側障害物移行を待つ。
                self._za_mega_last_charge_state="SKIP_WAIT_CLEAR"
                self.ZA_mega_mode5_trace(
                    "CHARGE_WARNING_RED_ONLY_WAIT",
                    "{} ignored; wait for red-only/warning fallback".format(
                        warning_name),
                    force=True)
                return "skip"
            if skip_limit < 0:
                # 赤のみ確認後は既存mode5なので、既存の予兆／緑床処理を
                # 無効化せず、0回スキップとして扱う。
                skip_limit=0
            skip_count=max(0, int(getattr(
                self, "_za_mega_last_charge_skip_count", 0)))
            if skip_count < skip_limit:
                skip_count+=1
                self._za_mega_last_charge_skip_count=skip_count
                self._za_mega_last_charge_state="SKIP_WAIT_CLEAR"
                self.ZA_mega_mode5_trace(
                    "CHARGE_WARNING_SKIPPED",
                    "{} event skipped {}/{}; keep attack controls".format(
                        warning_name, skip_count, skip_limit),
                    force=True)
                return "skip"
            # 3回目以降の予兆を受理した時点から、再開判定までは
            # 通常攻撃とTESTMODE1の定期Yローリングを停止する。
            self._za_mega_last_charge_attack_suspended=True
            if (getattr(self, "_za_mega_testmode1_enabled", False)
                    and not getattr(
                        self, "_za_mega_testmode1_legacy_until_reset",
                        False)):
                phase_before_charge=str(getattr(
                    self, "_za_mega_testmode1_phase", "COVER_ATTACK"))
                if phase_before_charge in {
                        "COVER_ATTACK", "RED_COVER_ATTACK"}:
                    self._za_mega_testmode1_phase_before_charge=(
                        phase_before_charge)
                self._za_mega_testmode1_existing_charge_latched=True
                self._za_mega_testmode1_phase="EXISTING_CHARGE"
        if strong_light_detected:
            return self.ZA_mega_last_battle_charge_dodge(
                dir1,dir2,dir3,dir4,see_r,
                endpicture=endpicture, end2picture=end2picture,
                seconds=dodge_seconds,
                reason="strong_light_without_charge")
        if not charge_detected:
            return "none"

        self._za_mega_last_charge_state="SEARCH_GREEN"
        self._za_mega_last_charge_search_deadline=(
            time.monotonic() + max(0.1, float(search_seconds)))
        self._za_mega_z_guard_skip_current_floor=False
        self._za_mega_z_guard_skip_last_seen=0.0
        self.ZA_mega_mode5_marker_search_view_stop(relock=False)
        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
        self.ZA_MOVE_SEE(action="END", in_see_r=see_r)
        print(
            "[MEGA_CHARGE] charge warning detected; "
            "search nearby green floor for {:.1f}s".format(
                search_seconds))
        self.ZA_mega_mode5_trace(
            "POKEMON_ZA_LAST_BATTLE_CHARGE",
            "stop attack/move; search nearby green floor",
            force=True)
        state="SEARCH_GREEN"

    if state != "SEARCH_GREEN":
        return "none"

    # 右視点を止めたfresh frameで床距離を調べる。近い床だけを
    # 通常の緑床処理へ渡し、遠い床へ走って間に合わない場合は
    # 強い光を待たずY回避へ切り替える。
    self.ZA_mega_mode5_marker_search_view_stop(relock=False)
    self.ZA_MOVE_SEE(action="END", in_see_r=see_r)
    on_green,direction,_=(self.ZA_mega_green_safe_floor_direction())
    move_seconds=max(0.0, float(getattr(
        self, "_za_mega_green_floor_move_seconds", 0.0)))
    if (on_green or (isinstance(direction, Direction)
                     and move_seconds <= float(near_move_seconds))):
        self._za_mega_z_guard_skip_current_floor=False
        self._za_mega_z_guard_skip_last_seen=0.0
        if self.ZA_mega_z_guard_update(
                dir1,dir2,dir3,dir4,
                hold_until_disappears=True):
            self._za_mega_last_charge_state="GREEN"
            self.ZA_mega_mode5_transition(
                "GREEN_HOLD" if getattr(
                    self, "_za_mega_z_guard_holding", False)
                else "GREEN_MOVE",
                "charge warning; nearby green floor selected")
            self.ZA_mega_mode5_trace(
                "CHARGE_NEAR_GREEN",
                "move to green floor before strong light",
                force=True)
            return "green"
    elif isinstance(direction, Direction):
        return self.ZA_mega_last_battle_charge_dodge(
            dir1,dir2,dir3,dir4,see_r,
            endpicture=endpicture, end2picture=end2picture,
            seconds=dodge_seconds, reason="green_too_far")

    strong_light_detected=self.image_check(
        "POKEMON_ZA_LAST_BATTLE_STRONG_LIGHT")
    if strong_light_detected:
        block_red_attack_premove(
            "strong light", strong_light=True)
    if (strong_light_detected
            or time.monotonic() >= float(getattr(
                self, "_za_mega_last_charge_search_deadline", now))):
        return self.ZA_mega_last_battle_charge_dodge(
            dir1,dir2,dir3,dir4,see_r,
            endpicture=endpicture, end2picture=end2picture,
            seconds=dodge_seconds,
            reason=("strong_light" if strong_light_detected
                    else "green_search_timeout"))

    # すぐ見つからない場合は同じ方向への短い右視点パルスだけを
    # 行い、次周期の停止画面で再び床を探す。時間で左右反転しない。
    search_angle=float(getattr(
        self, "_za_mega_marker_search_direction", 180.0))
    if search_angle not in (0.0, 180.0):
        search_angle=180.0
    # 強い力の予兆中は通常探索より少し早く見渡す。
    # 判定は次周の視点停止後fresh frameで行うため、
    # 回転中のぶれを緑床として確定しない。
    search_strength=max(0.55, min(0.68, float(getattr(
        self, "_za_mega_marker_search_strength", 0.24)) * 2.4))
    self.press(
        Direction(Stick.RIGHT, search_angle, search_strength),
        duration=0.12, wait=0.1)
    self.ZA_mega_mode5_trace(
        "CHARGE_GREEN_MISSING",
        "right-stick scan angle={:.0f}; keep searching".format(
            search_angle))
    return "search"
def ZA_mega_red_edge_dodge_if_needed(
        self, seconds, dir1, dir2, dir3, dir4, see_r,
        endpicture="", end2picture="", active=True,
        repeat_count=0):
    """赤端を確認し、ZL解除中にY回避してから戦闘入力を復帰する。"""
    if seconds <= 0.0 or not active:
        if not active:
            self._za_mega_red_edge_latched = False
        return "none"
    if not self.ZA_mega_red_screen_edge_check():
        self._za_mega_red_edge_latched = False
        return "none"
    cover_guard=getattr(
        self, "ZA_mega_mode5_testmode1_controls_cover", None)
    testmode1_cover=bool(
        callable(cover_guard) and cover_guard())
    if (getattr(self, "_za_mega_last_battle_mode", False)
            and getattr(self, "_za_mega_z_guard_enabled", False)
            and not testmode1_cover
            and self.ZA_mega_z_guard_update(
                dir1, dir2, dir3, dir4)):
        # 赤端と緑床が同時に見える場合は、ロックオン解除Yよりも
        # 安全床への移動／床上停止を優先する。赤ラッチは立てず、
        # 床処理終了後も赤端が残る場合だけ次周期で回避できる。
        print(
            "[MEGA_RED_EDGE] green floor has priority; skip Y dodge")
        trace=getattr(self, "ZA_mega_mode5_trace", None)
        if callable(trace):
            trace(
                "RED_DAMAGE_AND_GREEN_FLOOR",
                "continue green-floor action; skip non-lockon Y")
        return "green_priority"
    if getattr(self, "_za_mega_red_edge_latched", False):
        return "latched"

    self._za_mega_red_edge_latched = True
    # Yローリング中に相手方向へ吸われないよう、入力前にZLを外す。
    self.ZA_ZL_ACTION("END")
    self.ZA_MOVE_SEE(action="END", in_see_r=see_r)
    if testmode1_cover:
        # 障害物待機中の赤端回避は、非ロックオンYを障害物方向へ送る。
        self.ZA_MOVE_LStick(
            dir1,dir2,dir3,dir4,
            Direction(Stick.LEFT, 90.0, 1.0),
            "RELOAD", force_direction=True)
    if repeat_count:
        print(
            "[MEGA_RED_EDGE] unlock and Y rolling x{}".format(
                int(repeat_count)))
    else:
        print(
            "[MEGA_RED_EDGE] unlock and Y rolling for {:.1f}s".format(
                seconds))
    result = self.ZA_mega_red_edge_y_renda(
        seconds, endpicture=endpicture, end2picture=end2picture,
        repeat_count=repeat_count)
    if result == "complete":
        # 回避完了後はロックオン、保持移動、視点処理の順に復帰する。
        self.ZA_ZL_ACTION("")
        if testmode1_cover:
            self.ZA_MOVE_LStick(
                dir1,dir2,dir3,dir4,1,"END")
            self._za_mega_testmode1_next_dodge_at=(
                time.monotonic() + 2.4)
        else:
            self.ZA_mega_keep_left_moving(dir1,dir2,dir3,dir4)
        self.ZA_MOVE_SEE(
            action=("END" if getattr(
                self, "_za_mega_movemode", 0) == 1 else ""),
            in_see_r=see_r)
    return result

def ZA_mega_choice_input_guard(self):
    # 最終戦モードでは通常の2体／3体選択を3体／4体選択へ読み替える。
    if getattr(self, "_za_mega_last_battle_mode", False):
        select_pictures = (
            "POKEMON_ZA_3_SELECT_TUTORIAL",
            "POKEMON_ZA_3_SELECT",
            "POKEMON_ZA_4_SELECT")
    else:
        select_pictures = (
            "POKEMON_ZA_2_SELECT", "POKEMON_ZA_3_SELECT")
    # FIELD表示中は選択肢テンプレートの残像／誤一致を無効化する。
    # 復帰直後にSELECT側へ入ると、緑床確認と上入力が数秒遅れる。
    if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK"):
        return False
    if any(self.image_check(picture) for picture in select_pictures):
        self._za_mega_mode5_color_field_until=0.0
        return True
    black_comment=self.image_check("POKEMON_ZA_TEXT_BLACK_COMMENT")
    if black_comment:
        self._za_mega_mode5_color_field_until=0.0
    return black_comment

def ZA_mega_mode5_lockon_ready(self, refresh=False):
    """mode 5でZL保持と画像または戦闘状態によるロックオンを確認する。"""
    if (not getattr(self, "_za_mega_last_battle_mode", False)
            or int(getattr(
                self, "_za_mega_mode5_start_flag", 0)) != 4
            or getattr(self, "ZL_state", 0) != 1):
        return False
    now=time.monotonic()
    if now < float(getattr(
            self, "_za_mega_mode5_lockon_confirmed_until", 0.0)):
        return True
    # 最終戦ではC+／EYE画像が攻撃演出と白背景で大きく変化する。
    # FIELD_W/BACK_Wから戦闘開始済みで、こちらがZLを保持し、
    # 右スティック探索中でもない区間はゲーム状態による補助判定とする。
    # 選択画面・敗北画面ではbattle_activeを先に解除するためY回避にはならない。
    if (getattr(self, "_za_mega_mode5_battle_active", False)
            and not getattr(
                self, "_za_mega_marker_search_view_holding", False)):
        self._za_mega_mode5_lockon_confirmed_until=now + 0.45
        if not getattr(
                self, "_za_mega_mode5_state_lockon_logged", False):
            print(
                "[MEGA_LOCKON] use active battle + ZL state fallback")
            self._za_mega_mode5_state_lockon_logged=True
        return True
    if not refresh:
        return False
    # EYE表示は既存のZLロックオン確認用画像。どちらも外れた場合だけ
    # 色補助ではない実ターゲットマーカーを再確認する。
    if (self.image_check("POKEMON_ZA_EYE_CHECK")
            or self.image_check("POKEMON_ZA_EYE_CHECK_HIGH")):
        self._za_mega_mode5_lockon_confirmed_until=now + 0.8
        self._za_mega_mode5_visual_lockon_until=now + 0.8
        self._za_mega_mode5_state_lockon_logged=False
        return True
    marker_direction=self.ZA_mega_target_marker_direction()
    if (isinstance(marker_direction, Direction)
            and not getattr(self, "_za_mega_target_from_color", False)):
        self._za_mega_mode5_lockon_confirmed_until=now + 0.8
        self._za_mega_mode5_visual_lockon_until=now + 0.8
        self._za_mega_mode5_state_lockon_logged=False
        return True
    return False

def ZA_mega_mode5_a_attack_ready(self, choice_guard_checked=False):
    """mode 5でA攻撃を送ってよい戦闘画面だけを確認する。"""
    if (not getattr(self, "_za_mega_last_battle_mode", False)
            or int(getattr(
                self, "_za_mega_mode5_start_flag", 0)) != 4
            or not getattr(self, "_za_mega_mode5_battle_active", False)):
        self._za_mega_mode5_color_field_until=0.0
        return False

    # FIELDと同時に背景が残る場合があるため、選択肢・コメントを先に
    # 除外する。これらと暗転中は、AだけでなくC+用PLUSも送らない。
    blocked_pictures = [
        "POKEMON_ZA_TEXT_WHITE_COMMENT",
        "POKEMON_ZA_TEXT_GREEN_COMMENT",
    ]
    if not choice_guard_checked:
        blocked_pictures.extend((
            "POKEMON_ZA_TEXT_BLACK_COMMENT",
            "POKEMON_ZA_3_SELECT_TUTORIAL",
            "POKEMON_ZA_3_SELECT",
            "POKEMON_ZA_4_SELECT",
        ))
    if any(self.image_check(picture) for picture in blocked_pictures):
        if not getattr(
                self, "_za_mega_mode5_a_block_logged", False):
            print(
                "[MEGA_A_ONLY] block A/PLUS on comment or selection")
            self._za_mega_mode5_a_block_logged=True
        self._za_mega_mode5_color_field_until=0.0
        return False

    field_pictures = (
        # 最新録画ではBATTLE=0.943でもFIELD_W/BACK_Wが0.8未満となり、
        # 実戦闘中のAが40秒中1回まで落ちていた。選択肢／Commentを
        # 上で除外済みなので、BATTLEも安全な攻撃画面として使用する。
        "POKEMON_ZA_BATTLE",
        "POKEMON_ZA_FIELD_W",
        "POKEMON_ZA_FIELD_BACK_W",
        "POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK",
    )
    if not any(self.image_check(picture) for picture in field_pictures):
        if not getattr(
                self, "_za_mega_mode5_a_block_logged", False):
            print("[MEGA_A_ONLY] block A/PLUS without FIELD")
            self._za_mega_mode5_a_block_logged=True
        self._za_mega_mode5_color_field_until=0.0
        return False
    self._za_mega_mode5_a_block_logged=False
    # 赤青補助はこのFIELD確認から1.5秒だけ許可する。画面が会話・
    # 暗転・演出へ変わった後に古い色追従を持ち越さない。
    self._za_mega_mode5_color_field_until=time.monotonic() + 1.5
    return True

def ZA_mega_mode5_skill_attack_ready(self):
    """mode 5でB/X/Yを技として送れるC+表示を確認する。"""
    if (not getattr(self, "_za_mega_last_battle_mode", False)
            or int(getattr(
                self, "_za_mega_mode5_start_flag", 0)) != 4
            or not getattr(self, "_za_mega_mode5_battle_active", False)
            or getattr(self, "ZL_state", 0) != 1):
        return False
    now=time.monotonic()
    if now < float(getattr(
            self, "_za_mega_mode5_skill_ready_until", 0.0)):
        return True
    if (self.image_check("POKEMON_ZA_C+")
            or self.image_check("POKEMON_ZA_C+_LOW")):
        self._za_mega_mode5_skill_ready_until=now + 0.25
        self._za_mega_mode5_lockon_confirmed_until=now + 0.5
        self._za_mega_mode5_visual_lockon_until=now + 0.5
        self.ZA_mega_mode5_trace(
            "POKEMON_ZA_C+/C+_LOW",
            "allow B/X/Y skill attack")
        return True
    return False

def ZA_mega_attack_ready(self):
    # 最終戦の戦闘状態フォールバックはテンプレート照合より先に使う。
    # C+／C+_LOWを毎技2回ずつ確認する待ちをなくし、攻撃区間を増やす。
    # PLUS入力自体は各技の直前に従来どおり送信する。
    if self.ZA_mega_mode5_lockon_ready(refresh=False):
        if not getattr(
                self, "_za_mega_mode5_attack_fallback_logged", False):
            print(
                "[MEGA_ATTACK_READY] use active battle lockon state")
            self._za_mega_mode5_attack_fallback_logged=True
        return True
    # 通常閾値を優先し、取りこぼした場合だけ0.60のLOWを確認する。
    if (self.image_check("POKEMON_ZA_C+")
            or self.image_check("POKEMON_ZA_C+_LOW")):
        self._za_mega_mode5_attack_fallback_logged=False
        return True
    # mode 5だけはC+画像を一時的に外しても、ZL保持に加えて
    # 戦闘状態、EYEまたは実マーカーで攻撃可能状態を補完する。
    if self.ZA_mega_mode5_lockon_ready(refresh=True):
        if not getattr(
                self, "_za_mega_mode5_attack_fallback_logged", False):
            print(
                "[MEGA_ATTACK_READY] C+ missed; "
                "use lockon fallback")
            self._za_mega_mode5_attack_fallback_logged=True
        return True
    self._za_mega_mode5_attack_fallback_logged=False
    return False

def ZA_mega_mode5_y_attack_ready(self):
    """mode 5のYを非ロックオン時のローリングにしない。"""
    if not getattr(self, "_za_mega_last_battle_mode", False):
        return True
    ready=self.ZA_mega_mode5_lockon_ready(refresh=True)
    if ready:
        self._za_mega_mode5_y_skip_logged=False
        return True
    if not getattr(self, "_za_mega_mode5_y_skip_logged", False):
        print("[MEGA_Y] skip Y; lockon not confirmed")
        self._za_mega_mode5_y_skip_logged=True
    return False

def ZA_mega_mode5_field_w_up_retry(
        self, field_w_detected, field_back_w_detected,
        max_attempts=5, interval=0.3, before_recovery=None):
    """mode 5だけ、FIELD_BACK_Wになるまで上入力を間欠再送する。

    上入力を上限まで送ってもFIELD_Wが残る場合は、ポケモンを
    出せないゲーム側状態をXメニューの開閉で解除して再試行する。
    """
    if not getattr(self, "_za_mega_last_battle_mode", False):
        return False
    if field_back_w_detected:
        attempts=int(getattr(
            self, "_za_mega_field_w_up_attempts", 0))
        if attempts:
            print(
                "[MEGA_FIELD_W] FIELD_BACK_W detected; "
                "stop up retry after {}/{}".format(
                    attempts, max(1, int(max_attempts))))
        self._za_mega_field_w_up_attempts=0
        self._za_mega_field_w_up_retry_at=0.0
        self._za_mega_field_w_up_latched=False
        return False
    if not field_w_detected:
        return False

    attempts=int(getattr(
        self, "_za_mega_field_w_up_attempts", 0))
    attempt_limit=max(1, int(max_attempts))
    now=time.monotonic()
    if now < float(getattr(
            self, "_za_mega_field_w_up_retry_at", 0.0)):
        return False
    if attempts >= attempt_limit:
        menu_open=self.image_check("POKEMON_ZA_X_MENU_OPEN")
        if not menu_open:
            # FIELDの背後へ選択肢が残る場合もあるため、共通guardの
            # FIELD優先短絡を使わず、危険画面を直接除外する。
            blocked_pictures=(
                "POKEMON_ZA_TEXT_WHITE_COMMENT",
                "POKEMON_ZA_TEXT_GREEN_COMMENT",
                "POKEMON_ZA_TEXT_BLACK_COMMENT",
                "POKEMON_ZA_3_SELECT_TUTORIAL",
                "POKEMON_ZA_3_SELECT",
                "POKEMON_ZA_4_SELECT",
            )
            if any(self.image_check(picture)
                   for picture in blocked_pictures):
                print(
                    "[MEGA_FIELD_W_RECOVERY] blocked by comment/selection; "
                    "do not press X/B")
                return False

        if callable(before_recovery):
            before_recovery()
        marker_stop=getattr(
            self, "ZA_mega_mode5_marker_search_view_stop", None)
        if callable(marker_stop):
            marker_stop(relock=False)
        view_stop=getattr(self, "ZA_MOVE_SEE", None)
        if callable(view_stop):
            view_stop(action="END")
        self.ZA_ZL_ACTION("END")

        if not menu_open:
            print(
                "[MEGA_FIELD_W_RECOVERY] FIELD_W remained after "
                "{}/{} up attempts; open X menu".format(
                    attempts, attempt_limit))
            self.pressRep(
                Button.X, repeat=1, duration=0.15,
                wait=0.5, interval=0.1)
            # 高負荷中のメニュー描画を待ち、表示を確認してからだけ
            # Bを送る。Xが欠落した場合に戦闘中のB入力へしない。
            for _ in range(10):
                if self.image_check("POKEMON_ZA_X_MENU_OPEN"):
                    menu_open=True
                    break
                alive_check=getattr(self, "checkIfAlive", None)
                if callable(alive_check):
                    alive_check()
                self.wait(0.1)

        close_count=0
        while menu_open and close_count < 3:
            self.checkIfAlive()
            self.pressRep(
                Button.B, repeat=1, duration=0.15,
                wait=0.5, interval=0.1)
            close_count+=1
            menu_open=self.image_check("POKEMON_ZA_X_MENU_OPEN")

        self._za_mega_field_w_up_attempts=0
        self._za_mega_field_w_up_retry_at=0.0
        self._za_mega_field_w_up_latched=False
        self._za_mega_mode5_battle_active=False
        self.ZA_mega_mode5_transition(
            "FIELD_W_INPUT",
            "FIELD_W stuck; X menu recovery complete")
        self.ZA_mega_mode5_set_start_flag(
            3, "FIELD_W_X_MENU_RECOVERY",
            "retry Lbutton_up after X menu open/close")
        if close_count:
            result_text=(
                "closed" if not menu_open
                else "still detected after B x{}".format(close_count))
            print(
                "[MEGA_FIELD_W_RECOVERY] X menu {} ; "
                "reset up retry".format(result_text))
        else:
            print(
                "[MEGA_FIELD_W_RECOVERY] X menu was not detected; "
                "do not press B; reset up retry")
        trace=getattr(self, "ZA_mega_mode5_trace", None)
        if callable(trace):
            trace(
                "FIELD_W_X_MENU_RECOVERY",
                "X menu open/close; retry Lbutton_up",
                force=True)
        return "menu_recovery"
    # 0.04秒では最終戦の高負荷中に方向入力を取りこぼす実録画がある。
    # 押下時間だけ0.10秒へ延ばし、再送間隔は従来どおり0.3秒以上にする。
    self.etc_sendCommand("Lbutton_up", wait=0.10)
    # 生コマンドの解放行で途切れたZL・左スティックを復元する。
    self.keys.input([])
    attempts+=1
    self._za_mega_field_w_up_attempts=attempts
    self._za_mega_field_w_up_retry_at=(
        now + max(0.1, float(interval)))
    self._za_mega_field_w_up_latched=True
    print(
        "[MEGA_FIELD_W] Lbutton_up retry {}/{}; "
        "restore held inputs".format(attempts, attempt_limit))
    trace=getattr(self, "ZA_mega_mode5_trace", None)
    if callable(trace):
        trace(
            "POKEMON_ZA_FIELD_W",
            "Lbutton_up retry {}/{}".format(attempts, attempt_limit))
    return True

def ZA_mega_cplus_should_press(
        self, cp_mode=0, cplus_active=False):
    # POKEMON_ZA_C+は「技が使用可能」の表示であり、
    # PLUSでC+化済みかを示す表示ではない。
    # そのため、自分が送ったPLUS/技入力から有効状態を管理する。
    return cp_mode == 1 and not cplus_active

def ZA_mega_cplus_after_skill_input(
        self, cplus_active=False):
    # C+化中はA/B/X/Yの技入力で解除される。
    if cplus_active:
        print("[MEGA_CPLUS] skill input: C+ activation consumed")
    if getattr(self, "_za_mega_last_battle_mode", False):
        self._za_mega_mode5_skill_ready_until=0.0
    return False

def ZA_mega_keep_left_moving(self,dir1,dir2,dir3,dir4,fallback_dirnum=4):
    # 右スティックの視点回転中に左入力だけが消えないよう、
    # 現在の通常移動方向を再送する。マーカー補正は継続しない。
    state_directions = (
        ("Lstick_state", 1),
        ("Lstick_state2", 2),
        ("Lstick_state3", 3),
        ("Lstick_state4", 4),
    )
    if (time.monotonic() < getattr(
            self, "_za_mega_field_dir5_until", 0.0)
            and getattr(self, "_za_mega_dir5", -1) >= 0):
        dirnum = 5
    else:
        # dir5の専用時間が終わった後は通常方向へ戻し、継続しない。
        dirnum = fallback_dirnum
        for state_name, state_dirnum in state_directions:
            if getattr(self, state_name, 0) == 1:
                dirnum = state_dirnum
                break
    self.ZA_MOVE_LStick(
        dir1,dir2,dir3,dir4,dirnum,"RELOAD")
    return dirnum

def ZA_mega_mode4_view_nudge(self):
    """mode 4専用で視点を右スティック90度へ0.1秒だけ動かす。"""
    self.press(
        Direction(Stick.RIGHT, 90),
        duration=0.1,
        wait=0.0)

def ZA_mega_attack_unavailable_y_dodge(
        self, dir1, dir2, dir3, dir4, see_r,
        repeat=2, cooldown=0.75, post_l_view_nudge=0,
        include_upper_marker=0):
    """攻撃不能中だけZLを外してY回避し、短時間で再ロックする。"""
    now = time.monotonic()
    if (now < getattr(
            self, "_za_mega_attack_unavailable_y_dodge_retry_at", 0.0)
            or self.ZA_mega_choice_input_guard()):
        return False

    # ロック中に見えているマーカーを、ZLを外す前に取得しておく。
    marker_direction = self.ZA_mega_target_marker_direction(
        include_upper=bool(include_upper_marker))
    resume_dirnum = self.ZA_mega_keep_left_moving(
        dir1, dir2, dir3, dir4)
    retry_at = now + max(0.1, float(cooldown))
    self._za_mega_attack_unavailable_y_dodge_retry_at = retry_at
    self._za_mega_relock_retry_at = retry_at

    # YはZL解除後に送らないと技入力となり、ローリングにならない。
    self.ZA_ZL_ACTION("END")
    self.ZA_MOVE_SEE(action="END", in_see_r=see_r)
    roll_angles = {
        1: dir1,
        2: dir2,
        3: dir3,
        4: dir4,
        5: getattr(self, "_za_mega_dir5", dir4),
    }
    roll_angle = (
        float(roll_angles.get(resume_dirnum, dir4)) + 20.0) % 360.0
    self.ZA_MOVE_LStick(
        dir1, dir2, dir3, dir4,
        Direction(Stick.LEFT, roll_angle, 1.0), "RELOAD",
        force_direction=True)
    roll_see_r = min(1.0, max(0.0, float(see_r) * 2.0))
    self.ZA_MOVE_SEE(action="", in_see_r=roll_see_r)
    self.pressRep(
        Button.Y,
        repeat=max(1, int(repeat)),
        duration=0.04,
        wait=0.0,
        interval=0.1)
    # Yローリング後は高速視点回転だけを止め、L待機へ持ち越さない。
    self.ZA_MOVE_SEE(action="END", in_see_r=roll_see_r)
    # Lの再センターは1秒後のままでも、ZLはローリング直後に戻す。
    # これにより非ロックオンになるのはY入力中だけとなる。
    self.ZA_ZL_ACTION("")

    if marker_direction:
        self.ZA_MOVE_LStick(
            dir1, dir2, dir3, dir4, marker_direction, "RELOAD")
        # 2回目のローリング完了から1秒以内にはLを送らない。
        self.wait(1.1)
        self.pressRep(
            Button.L,
            repeat=1,
            duration=0.04,
            wait=0.0,
            interval=0.1)
        if post_l_view_nudge:
            self.ZA_mega_mode4_view_nudge()

    self.ZA_MOVE_LStick(
        dir1, dir2, dir3, dir4, resume_dirnum, "RELOAD")
    self.ZA_MOVE_SEE(
        action=("END" if getattr(
            self, "_za_mega_movemode", 0) == 1 else ""),
        in_see_r=see_r)
    # L待機時間を延ばしても、復帰直後に次の回避を開始しない。
    retry_at = time.monotonic() + max(0.1, float(cooldown))
    self._za_mega_attack_unavailable_y_dodge_retry_at = retry_at
    self._za_mega_relock_retry_at = retry_at
    print(
        "[MEGA_NO_ATTACK_DODGE] unlock -> Y x{} -> relock".format(
            max(1, int(repeat))))
    return True
def ZA_battle_reword_recovery(self, max_press_count=10):
    press_count = 0
    while press_count < max_press_count:
        if not self.image_check("POKEMON_ZA_REWORD"):
            break
        self.checkIfAlive()
        self.pressRep(
            Button.B, repeat=1, duration=0.15,
            wait=0.5, interval=0.1)
        press_count += 1
    return press_count > 0

def ZA_battle_missing_field_recovery(
        self, counter_key="battle", enabled=True,
        attack_ready=False, before_recovery=None):
    count_name = (
        "_za_battle_missing_field_count_" + str(counter_key))
    # X復帰の報酬表示とXメニューは、FIELD消失回数や
    # 攻撃可否より先に共通入口で処理する。
    if self.ZA_battle_reword_recovery():
        setattr(self, count_name, 0)
        return True
    if self.image_check("POKEMON_ZA_X_MENU_OPEN"):
        setattr(self, count_name, 0)
        self.pressRep(
            Button.B, repeat=1, duration=0.15,
            wait=0.5, interval=0.1)
        return True
    if not enabled or attack_ready:
        setattr(self, count_name, 0)
        return False

    battle_without_field = (
        (not bool(self.ZA_story_Template_Field_HardGaurd()))
        and bool(self.ZA_story_Template_Field_HardGaurd(mode=1))
        and not self.image_check("POKEMON_ZA_BATTLE_ACTIVE_LEVEL"))
    if not battle_without_field:
        setattr(self, count_name, 0)
        return False

    missing_field_count = getattr(self, count_name, 0) + 1
    setattr(self, count_name, missing_field_count)
    if missing_field_count < 10:
        return False

    setattr(self, count_name, 0)
    if callable(before_recovery):
        before_recovery()
    if hasattr(self, "ZA_MOVE_SEE"):
        self.ZA_MOVE_SEE("END")
    self.ZA_ZL_ACTION("END")
    self.pressRep(
        Button.X, repeat=1, duration=0.15,
        wait=0.5, interval=0.1)
    help_press_count = 0
    b_press_count = 0
    while b_press_count < 20:
        # 復帰用Xで報酬が開いた場合は、HELPと同様に
        # 画像を確認しながら、消えるまでBで進める。
        if self.ZA_battle_reword_recovery():
            return True
        # 復帰用XによってXメニューが開いた場合は、背後のFIELD表示で
        # 復帰済みと誤判定する前にBで閉じる。
        if self.image_check("POKEMON_ZA_X_MENU_OPEN"):
            self.checkIfAlive()
            self.pressRep(
                Button.B, repeat=1, duration=0.15,
                wait=0.5, interval=0.1)
            return True
        if self.image_check("POKEMON_ZA_HELP_MARKER"):
            if help_press_count >= 10:
                return True
            # FIELD復帰ループ中のHELPは、消えるまでAで進める。
            # HELP中には選択を変えるBを送らない。
            self.checkIfAlive()
            self.pressRep(
                Button.A, repeat=1, duration=0.15,
                wait=0.5, interval=0.1)
            help_press_count += 1
            continue
        if bool(self.ZA_story_Template_Field_HardGaurd()):
            break
        self.checkIfAlive()
        self.pressRep(
            Button.B, repeat=1, duration=0.15,
            wait=0.5, interval=0.1)
        b_press_count += 1
    return True
def _ZA_mega_field_position_matches(self, usenum):
    """開始直後／復帰時の選択位置が使用番号と一致するか返す。"""
    if usenum==1:
        return (self.image_check("POKEMON_ZA_FIELD1")
                or self.image_check("POKEMON_ZA_FIELD_BACK1"))
    if usenum==2:
        return (self.image_check("POKEMON_ZA_FIELD2")
                or self.image_check("POKEMON_ZA_FIELD_BACK2"))
    if usenum==3:
        return (self.image_check("POKEMON_ZA_FIELD3")
                or self.image_check("POKEMON_ZA_FIELD_BACK3"))
    if usenum==4:
        return (self.image_check("POKEMON_ZA_FIELD4")
                or self.image_check("POKEMON_ZA_FIELD_BACK4"))
    if usenum==5:
        return (self.image_check("POKEMON_ZA_FIELD5")
                or self.image_check("POKEMON_ZA_FIELD_BACK5"))
    if usenum==6:
        return (self.image_check("POKEMON_ZA_FIELD6")
                or self.image_check("POKEMON_ZA_FIELD_BACK6"))
    return False

def ZA_mega_evolution_battle(self,usenum=1,Xaction=0,Aaction=0,Yaction=0,Baction=0,mode=0,dir1=0,dir2=0,dir3=0,dir4=0,see_r=0, escape_flag=0,target_count_threshold_arg=15,no_target_count_threshold_arg=15,endpicture="",end2picture="",lockon_rclick=1,field_resume_dir4_seconds=10.0,red_edge_y_renda_seconds=0.0,dir5=-1,field_resume_dir5_seconds=4.0,attack_unavailable_y_dodge=0,mode4_view_nudge=0,last_battle_mode=0,movemode=0,Z_Gaurd=0,Cplus_attack=0,red_edge_y_repeat=0,testmode1=0):
    if last_battle_mode:
        # AはC+画像がなくても戦闘画面なら使用する。B/X/Yは呼び出し値を
        # 保持し、後段でC+画像を確認できた時だけ技入力として許可する。
        Aaction=1
    count=0
    self.no_Cplus=0
    no_target_count=0
    no_target_count_threshold=no_target_count_threshold_arg
    target_count=0
    target_count_threshold=target_count_threshold_arg
    target_marker_count=0
    
    nofiled=1
    battle_count=0
    
    # Cplus_attack=1では初戦・再戦ともC+攻撃を維持する。
    Cp_mode=1 if Cplus_attack else 0
    targetmode=0
    rclick_lockon_used=False
    rclick_retry_at=0.0
    cplus_active=False
    cplus_suppression_logged=False
    self._za_mega_rclick_dir3_until=0.0
    self._za_mega_dir5=dir5
    self._za_mega_field_dir5_until=0.0
    self._za_mega_field_dir4_until=0.0
    self._za_mega_relock_retry_at=0.0
    self._za_mega_red_edge_latched=False
    self._za_mega_last_charge_state="IDLE"
    self._za_mega_last_charge_check_retry_at=0.0
    self._za_mega_last_charge_search_deadline=0.0
    self._za_mega_last_charge_cooldown_until=0.0
    self._za_mega_last_charge_skip_count=0
    self._za_mega_last_charge_attack_suspended=False
    self._za_mega_attack_unavailable_y_dodge_retry_at=0.0
    self._za_mega_field_w_up_latched=False
    self._za_mega_field_w_up_attempts=0
    self._za_mega_field_w_up_retry_at=0.0
    attack_unavailable_since=None
