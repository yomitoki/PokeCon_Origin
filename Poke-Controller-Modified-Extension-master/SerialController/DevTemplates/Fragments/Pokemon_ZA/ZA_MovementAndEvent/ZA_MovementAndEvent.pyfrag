######################################################
def ZA_get_pokemon(self):
    self.ZA_ZL_ACTION("")
    self.wait(0.1)
    self.keys.input(Button.ZR)
    self.wait(0.15)
    self.keys.inputEnd(Button.ZR)
    self.wait(0.1)
    self.ZA_ZL_ACTION("END")
def ZA_ball_change(self,type=0):

    for i in range(20):
        self.keys.input(Button.ZR)
        self.wait(2.0)
        if type==0 and self.image_check("POKEMON_ZA_M_BALL_ICON"):
            self.pressRep(Button.B, repeat=1, duration=0.15, wait=0.5, interval=0.1)
            self.wait(1.0)
            self.keys.inputEnd(Button.ZR)
            return True
        elif type==2 and self.image_check("POKEMON_ZA_H_BALL_ICON"):
            self.pressRep(Button.B, repeat=1, duration=0.15, wait=0.5, interval=0.1)
            self.wait(1.0)
            self.keys.inputEnd(Button.ZR)
            return True
        else:
            self.wait(1.0)
            self.etc_sendCommand("Lbutton_left")
            self.wait(1.0)
        self.pressRep(Button.B, repeat=1, duration=0.15, wait=0.5, interval=0.1)
        self.wait(1.0)
        self.keys.inputEnd(Button.ZR)
        self.wait(2.0)


    return False
def ZA_EventSkip_plus(self):
    for i in range(3):
        self.etc_sendCommand("plusbutton")
        self.wait(0.1)
        self.etc_sendCommand("plusbutton_push")
        self.wait(3.0)
        self.etc_sendCommand("plusbutton_release")

# 以下はmode 5専用状態遷移。実ソースから関数単位で同期する。
def ZA_mega_evolution_battle_mode5(
        self, usenum=1, movemode=0, Z_Gaurd=0, Cplus_attack=0,
        testmode1=0):
    """最終戦専用mode 5を、通常MEGA戦とは別の入口から開始する。

        開始フラグ:
          0 開始直後／再挑戦選択後のリセット
          1 FIELD・緑床・BATTLEの再開画面確認
          2 緑床移動または通常90度の初期移動と、移動後の視点探索待機
          3 FIELD_Wの上入力（未確認FIELDは左入力で再確認）
          4 継続移動・ターゲット探索・再ロック・攻撃

        通常画面はAを常用し、B/X/YはC+確認時だけ技として使う。
        専用4技UIではC+に依存せず、ZL保持後にA/X/B/Yを入力する。
        共通関数へ渡す固定値をここへ集約し、mode 0～4とは混在させない。
        TESTMODE1の開始動作はMEGA_MODE5_TESTMODE1_MANUAL_SETTINGSで検索。
    """
    return self.ZA_mega_evolution_battle(
        usenum=usenum,
        Xaction=1, Aaction=1, Yaction=1, Baction=1,
        mode=0,
        dir1=20, dir2=90, dir3=40, dir4=90,
        see_r=0.24,
        escape_flag=0,
        endpicture="POKEMON_ZA_TEXT_WHITE_COMMENT",
        last_battle_mode=1,
        # 赤い被弾表示ではZLを外し、Yを6回送って回避時間を延ばす。
        # 実行前に共通helperが緑床を再確認し、床処理を優先する。
        red_edge_y_renda_seconds=0.2,
        red_edge_y_repeat=6,
        dir5=90,
        field_resume_dir5_seconds=(3.0 if movemode == 1 else 4.0),
        attack_unavailable_y_dodge=0,
        movemode=movemode,
        Z_Gaurd=Z_Gaurd,
        Cplus_attack=Cplus_attack,
        testmode1=testmode1)

def ZA_mega_mode5_transition(self, next_phase, reason):
    """mode 5の現在フェーズを更新し、変化した理由を1行で記録する。"""
    previous=getattr(self, "_za_mega_mode5_phase", "WAIT_RESUME")
    self._za_mega_mode5_phase=next_phase
    if previous != next_phase:
        print(
            "[MEGA_MODE5] {} -> {} :: {}".format(
                previous, next_phase, reason))

def ZA_mega_mode5_trace(self, detection, action, force=False):
    """mode 5の開始フラグ・検知・実行内容をCommandsログへ記録する。"""
    if not getattr(self, "_za_mega_last_battle_mode", False):
        return False
    start_flag=int(getattr(self, "_za_mega_mode5_start_flag", 0))
    phase=str(getattr(self, "_za_mega_mode5_phase", "WAIT_RESUME"))
    detection=str(detection or "NONE")
    action=str(action or "NONE")
    trace_key=(start_flag, phase, detection, action)
    now=time.monotonic()
    if (not force
            and trace_key == getattr(
                self, "_za_mega_mode5_trace_key", None)
            and now < float(getattr(
                self, "_za_mega_mode5_trace_retry_at", 0.0))):
        return False
    self._za_mega_mode5_trace_key=trace_key
    self._za_mega_mode5_trace_retry_at=now + 5.0
    self._za_mega_mode5_last_detection=detection
    self._za_mega_mode5_last_action=action
    testmode1=int(bool(getattr(
        self, "_za_mega_testmode1_enabled", False)))
    resume_hp=str(getattr(
        self, "_za_mega_testmode1_resume_hp", "LEGACY"))
    hp_color=str(getattr(
        self, "_za_mega_testmode1_hp_color", "NONE"))
    hp_ratio=float(getattr(
        self, "_za_mega_testmode1_hp_fill_ratio", 0.0))
    test_phase=str(getattr(
        self, "_za_mega_testmode1_phase", "DISABLED"))
    print(
        "[STATE_MAIN_FUNCTION][MEGA_MODE5] "
        "TESTMODE1={} RESUME_HP={} HP_COLOR={} HP_RATIO={:.3f} "
        "TEST_PHASE={} "
        "START_FLAG={} PHASE={} DETECT={} ACTION={}".format(
            testmode1, resume_hp, hp_color, hp_ratio, test_phase,
            start_flag, phase, detection, action))
    # mode 5戦闘関数は完了まで外側のZA_story_mainへ戻らないため、
    # 外側だけに任せるとCommandsの状態表示が戦闘中に更新されない。
    # 状態変化／5秒間隔のtrace時に、同じステータス欄を直接更新する。
    status_builder=getattr(self, "ZA_story_status_text", None)
    status_printer=getattr(self, "print_t", None)
    status_clear=getattr(self, "print_tb", None)
    if callable(status_builder) and callable(status_printer):
        try:
            self.out_str=status_builder()
            if callable(status_clear):
                status_clear("d")
            status_printer(self.out_str)
        except Exception as error:
            print(
                "[MEGA_MODE5_STATUS] display update failed: {}".format(
                    error))
    return True

def ZA_mega_mode5_set_start_flag(
        self, start_flag, detection, action):
    """mode 5開始フラグを0～4へ制限して更新する。"""
    if not getattr(self, "_za_mega_last_battle_mode", False):
        return int(start_flag)
    next_flag=max(0, min(4, int(start_flag)))
    previous=int(getattr(self, "_za_mega_mode5_start_flag", 0))
    self._za_mega_mode5_start_flag=next_flag
    self.ZA_mega_mode5_trace(
        detection, action, force=(previous != next_flag))
    return next_flag

def ZA_mega_mode5_event_attack_blocked(self):
    """最終戦の技入力を止める会話・選択・終了画面を返す。"""
    if not getattr(self, "_za_mega_last_battle_mode", False):
        return ""
    return next((
        picture for picture in (
            "POKEMON_ZA_TEXT_BLACK_COMMENT",
            "POKEMON_ZA_TEXT_WHITE_COMMENT",
            "POKEMON_ZA_TEXT_GREEN_COMMENT",
            "POKEMON_ZA_3_SELECT_TUTORIAL",
            "POKEMON_ZA_3_SELECT",
            "POKEMON_ZA_4_SELECT",
            "POKEMON_ZA_X_MENU_OPEN",
            "POKEMON_ZA_REWORD",
            "POKEMON_ZA_REWORD_END",
            "POKEMON_ZA_REWORD_LOSE",
        ) if self.image_check(picture)), "")

def ZA_mega_mode5_event_attack_picture(self, check_blockers=True):
    """C+が出ない最終戦の4技表示をmode 5だけで確認する。"""
    if not getattr(self, "_za_mega_last_battle_mode", False):
        return ""
    picture="POKEMON_ZA_LAST_BATTLE_MOVE_UI"
    if not self.image_check(picture):
        return ""
    if check_blockers and self.ZA_mega_mode5_event_attack_blocked():
        return ""
    return picture

def ZA_mega_mode5_event_attack_axby(self, detected_picture=""):
    """最終戦4技UIではC+に依存せずZL保持後A/X/B/Yを送る。"""
    if (not getattr(self, "_za_mega_last_battle_mode", False)
            or int(getattr(
                self, "_za_mega_mode5_start_flag", 0)) != 4
            or not getattr(
                self, "_za_mega_mode5_battle_active", False)):
        return False
    detected_picture=(
        detected_picture or self.ZA_mega_mode5_event_attack_picture())
    if not detected_picture:
        return False

    # この画面にはC+表示がない。PLUS判定／入力を通さず、右視点を
    # 止めてZLを保持してから4技を直接入力する。左移動は止めない。
    self.ZA_mega_mode5_marker_search_view_stop(relock=False)
    self.ZA_MOVE_SEE(action="END")
    self.ZA_ZL_ACTION("")
    self.wait(0.1)
    self.ZA_mega_mode5_trace(
        detected_picture,
        "ZL lockon + A/X/B/Y (C+ unavailable)", force=True)

    pressed=[]
    for button in (Button.A, Button.X, Button.B, Button.Y):
        self.checkIfAlive()
        if not self.ZA_mega_mode5_event_attack_picture(
                check_blockers=False):
            print(
                "[MEGA_MODE5_EVENT_ATTACK] move UI cleared after {} -> "
                "stop remaining attack input".format(
                    "/".join(pressed) if pressed else "ZL"))
            break
        self.pressRep(
            button, repeat=1, duration=0.04,
            wait=0.1, interval=0.1)
        pressed.append(button.name)
    if pressed:
        now=time.monotonic()
        self._za_mega_mode5_lockon_confirmed_until=now + 0.8
        self._za_mega_mode5_visual_lockon_until=now + 0.8
    return bool(pressed)

def ZA_mega_mode5_detect_screen_state(self, nofiled):
    """mode 5のFIELD・緑床・4技UI・BATTLE・選択画面を返す。"""
    field_w_detected=self.image_check("POKEMON_ZA_FIELD_W")
    field_back_w_detected=self.image_check("POKEMON_ZA_FIELD_BACK_W")
    field_screen_detected=bool(
        field_w_detected or field_back_w_detected)

    green_resume_detected=False
    if (nofiled==1 and not field_screen_detected
            and self._za_mega_z_guard_enabled):
        on_green,green_direction,_=(
            self.ZA_mega_green_safe_floor_direction())
        green_resume_detected=bool(
            on_green or isinstance(green_direction, Direction))

    start_flag=int(getattr(
        self, "_za_mega_mode5_start_flag", 0))
    event_attack_picture=self.ZA_mega_mode5_event_attack_picture()
    battle_screen_detected=bool(
        (nofiled==1 or start_flag < 4)
        and not field_screen_detected
        and not green_resume_detected
        and (event_attack_picture
             or self.image_check("POKEMON_ZA_BATTLE")))
    resume_screen_detected=bool(
        field_screen_detected
        or green_resume_detected
        or battle_screen_detected)
    choice_input_guard=(
        False if resume_screen_detected
        else self.ZA_mega_choice_input_guard())
    if field_screen_detected:
        resume_reason="field"
    elif green_resume_detected:
        resume_reason="green-floor"
    elif event_attack_picture:
        resume_reason="event-attack-ui"
    elif battle_screen_detected:
        resume_reason="battle"
    else:
        resume_reason="none"
    return {
        "field_w": field_w_detected,
        "field_back_w": field_back_w_detected,
        "field_screen": field_screen_detected,
        "green_resume": green_resume_detected,
        "battle_screen": battle_screen_detected,
        "event_attack_picture": event_attack_picture,
        "resume_screen": resume_screen_detected,
        "choice_guard": choice_input_guard,
        "resume_reason": resume_reason,
    }

def ZA_mega_mode5_low_yellow_hp(self, frame=None):
    """最終戦の黄色HPバーがおよそ1/4まで減った再開画面を返す。"""
    if not getattr(self, "_za_mega_last_battle_mode", False):
        return False
    if frame is None:
        camera=getattr(self, "camera", None)
        if camera is None:
            return False
        if hasattr(camera, "readFreshFrame"):
            frame=camera.readFreshFrame(timeout=0.75)
        else:
            frame=(camera.readFrame()
                   if hasattr(camera, "readFrame") else None)
    if frame is None or getattr(frame, "size", 0) == 0:
        return False

    height,width=frame.shape[:2]
    # Switch No2録画ではボスHPの全幅は画面幅の約34.5%、開始位置は
    # x=0.33付近。上部の名前や演出色を避け、バー本体だけを見る。
    x0,x1=int(width * 0.30),int(width * 0.71)
    y0,y1=int(height * 0.105),int(height * 0.16)
    region=frame[y0:y1, x0:x1]
    if region.size == 0:
        return False
    hsv=cv2.cvtColor(region, cv2.COLOR_BGR2HSV)
    yellow_mask=cv2.inRange(
        hsv, (18, 100, 140), (40, 255, 255))
    minimum_column_pixels=max(3, int(region.shape[0] * 0.08))
    yellow_columns=(yellow_mask > 0).sum(axis=0)

    longest_start=-1
    longest_end=-1
    run_start=-1
    for index,column_pixels in enumerate(yellow_columns):
        if int(column_pixels) >= minimum_column_pixels:
            if run_start < 0:
                run_start=index
            continue
        if run_start >= 0:
            if index - run_start > longest_end - longest_start:
                longest_start=run_start
                longest_end=index
            run_start=-1
    if run_start >= 0:
        end=len(yellow_columns)
        if end - run_start > longest_end - longest_start:
            longest_start=run_start
            longest_end=end
    if longest_start < 0 or longest_end <= longest_start:
        return False

    run_width=longest_end - longest_start
    global_start=x0 + longest_start
    global_end=x0 + longest_end - 1
    full_bar_width=max(1.0, float(width) * 0.345)
    fill_ratio=float(run_width) / full_bar_width
    matched=bool(
        float(width) * 0.31 <= global_start <= float(width) * 0.36
        and global_end <= float(width) * 0.52
        and 0.20 <= fill_ratio <= 0.42)
    self._za_mega_mode5_yellow_hp_fill_ratio=fill_ratio
    self.last_image_detection={
        "name": "POKEMON_ZA_LAST_BATTLE_YELLOW_LOW_HP",
        "matched": matched,
        "fill_ratio": fill_ratio,
        "yellow_run": [global_start, global_end],
        "position": (global_start, y0),
        "template_size": (run_width, y1 - y0),
    }
    return matched

def ZA_mega_mode5_hp_resume_mode(self, frame=None):
    """testmode1用に再開時HPをHP75／OTHER／UNKNOWNへ分類する。"""
    self._za_mega_testmode1_hp_fill_ratio=0.0
    self._za_mega_testmode1_hp_color="NONE"
    self._za_mega_testmode1_hp_frame=None
    if not getattr(self, "_za_mega_last_battle_mode", False):
        return "UNKNOWN"
    if frame is None:
        camera=getattr(self, "camera", None)
        if camera is None:
            return "UNKNOWN"
        if hasattr(camera, "readFreshFrame"):
            frame=camera.readFreshFrame(timeout=0.75)
        else:
            frame=(camera.readFrame()
                   if hasattr(camera, "readFrame") else None)
    if frame is None or getattr(frame, "size", 0) == 0:
        return "UNKNOWN"
    self._za_mega_testmode1_hp_frame=frame

    height,width=frame.shape[:2]
    x0,x1=int(width * 0.30),int(width * 0.71)
    y0,y1=int(height * 0.105),int(height * 0.16)
    region=frame[y0:y1, x0:x1]
    if region.size == 0:
        return "UNKNOWN"
    hsv=cv2.cvtColor(region, cv2.COLOR_BGR2HSV)
    color_masks=(
        ("GREEN", cv2.inRange(
            hsv, (35, 90, 100), (100, 255, 255))),
        ("YELLOW", cv2.inRange(
            hsv, (18, 100, 140), (40, 255, 255))),
    )
    minimum_column_pixels=max(3, int(region.shape[0] * 0.08))
    best_color="NONE"
    best_start=-1
    best_end=-1
    best_width=0
    for color_name,color_mask in color_masks:
        columns=(color_mask > 0).sum(axis=0)
        run_start=-1
        for index,column_pixels in enumerate(columns):
            if int(column_pixels) >= minimum_column_pixels:
                if run_start < 0:
                    run_start=index
                continue
            if run_start >= 0:
                if index - run_start > best_width:
                    best_color=color_name
                    best_start=run_start
                    best_end=index
                    best_width=index - run_start
                run_start=-1
        if run_start >= 0 and len(columns) - run_start > best_width:
            best_color=color_name
            best_start=run_start
            best_end=len(columns)
            best_width=len(columns) - run_start
    if best_start < 0 or best_end <= best_start:
        return "UNKNOWN"

    global_start=x0 + best_start
    global_end=x0 + best_end - 1
    full_bar_width=max(1.0, float(width) * 0.345)
    fill_ratio=float(best_width) / full_bar_width
    bar_position_valid=bool(
        float(width) * 0.31 <= global_start <= float(width) * 0.36
        and global_end <= float(width) * 0.71
        and 0.12 <= fill_ratio <= 1.10)
    if not bar_position_valid:
        return "UNKNOWN"
    resume_mode=(
        "HP75"
        if best_color == "GREEN" and 0.55 <= fill_ratio <= 0.80
        else "OTHER")
    self._za_mega_testmode1_hp_fill_ratio=fill_ratio
    self._za_mega_testmode1_hp_color=best_color
    self.last_image_detection={
        "name": "POKEMON_ZA_LAST_BATTLE_TESTMODE1_HP",
        "matched": True,
        "resume_mode": resume_mode,
        "hp_color": best_color,
        "fill_ratio": fill_ratio,
        "yellow_run": [global_start, global_end],
        "position": (global_start, y0),
        "template_size": (best_width, y1 - y0),
    }
    return resume_mode

def ZA_mega_mode5_testmode1_settings(self):
    """TESTMODE1の開始直後の手動調整値を1か所で返す。"""
    # [MEGA_MODE5_TESTMODE1_MANUAL_SETTINGS]
    # 手動調整はこのreturn内だけを変更する。
    # 順序: 緑床確認 -> 緑床なし初期移動 -> 待機 -> 障害物移動
    #       -> 青へ向き直し/L -> 障害物内攻撃・定期回避
    return {
        # 1. FIELD判定直後の緑床確認。現在の0は確認せず移動開始。
        #    有効化した場合もHP75だけがこの初期確認を使用する。
        "INITIAL_GREEN_CHECK_COUNT": 0,
        "INITIAL_GREEN_CHECK_SECONDS": 0.0,
        "INITIAL_GREEN_WAIT_SECONDS": 0.0,
        "HP75_INITIAL_GREEN_MOVE_ANGLE": 90.0,
        # 2. 緑床がない場合: 固定方向へ移動してから待機する。
        "INITIAL_NO_GREEN_MOVE_ANGLE": 90.0,
        "INITIAL_NO_GREEN_MOVE_SECONDS": 3.0,
        "INITIAL_POST_MOVE_WAIT_SECONDS": 4.5,
        # 3. HP75: 緑床位置から青側障害物へ入り、青側へ向く。
        "HP75_COVER_MOVE_ANGLE": 185.0,
        # 障害物の端ではなく少し内側へ入るため+0.5秒。
        "HP75_COVER_MOVE_SECONDS": 5.0,
        "HP75_FACE_ANGLE": 30.0,
        # 4. HP75以外: 緑床用90度移動を経由せず、再開地点から
        #    青側障害物へ直接移動する。HP75経路の
        #    90度3.0秒 + 185度4.5秒を1本に合成し、そこから
        #    障害物の内側へ入る分0.5秒を追加した値。
        "OTHER_COVER_MOVE_ANGLE": 150.0,
        "OTHER_COVER_MOVE_SECONDS": 5.7,
        "OTHER_FACE_ANGLE": 30.0,
        # 5. 障害物到達後: 向き直し、定期的にY回避する。
        "FACE_DIRECTION_SECONDS": 1.0,
        "COVER_DODGE_INTERVAL_SECONDS": 2.4,
        "COVER_DODGE_ANGLE": 90.0,
        "COVER_DODGE_REPEAT": 2,
        # 青側障害物から赤側へ移る直前だけ、障害物に
        # Yを3回当てて赤側移動の開始地点を固定する。
        "BLUE_TO_RED_ANCHOR_DODGE_ANGLE": 90.0,
        "BLUE_TO_RED_ANCHOR_DODGE_REPEAT": 3,
        # 青側で深く入ってロックオンが外れても、攻撃前に
        # 赤側と同じ270度へ移動して射線を戻す。
        "BLUE_ATTACK_PREMOVE_ANGLE": 270.0,
        "BLUE_ATTACK_PREMOVE_ANGLE_SECONDS": 0.5,
        # 6. 予兆を無視する回数。-1は既存の予兆回避へ移行せず、
        #    7の赤のみ判定または予兆セット間の青不在で赤側へ移る。
        "CHARGE_WARNING_SKIP_COUNT": -1,
        # 予兆1組目の終了から次の予兆開始まで青敵を確認できなければ、
        # 赤色を直接取れなくても青撃破・赤敵ありとして扱う。
        "WARNING_BLUE_FALLBACK_ENABLED": True,
        # 2組目の強い光が消えてから、青側でポケモンを
        # 戻す判定と赤側障害物への移動を始めるまでの待機。
        "WARNING_RED_COVER_DELAY_SECONDS": 5.0,
        # 7. 既存の確定赤継続判定。
        "RED_ONLY_FALLBACK_SECONDS": 3.0,
        "RED_ONLY_CHECK_INTERVAL_SECONDS": 0.30,
        "RED_ONLY_GAP_TOLERANCE_SECONDS": 10.0,
        "RED_ONLY_MIN_CONFIRMATIONS": 3,
        "BLUE_BURROW_GRACE_SECONDS": 12.0,
        # 既存判定が成立しない場合の保険。青側で青敵を最後に
        # 確認してから60秒検知できなければ赤側へ移る。
        "BLUE_ABSENCE_FALLBACK_SECONDS": 60.0,
        "BLUE_ABSENCE_CHECK_INTERVAL_SECONDS": 0.30,
        # 8. 青撃破後: 青側障害物から赤側障害物へ固定移動する試案値。
        #    実機調整はこの3値だけで行える。
        "RED_COVER_MOVE_ANGLE": 30.0,
        # 青側の深さを0.5秒増やした分、赤側経路も延長。
        "RED_COVER_MOVE_SECONDS": 6.5,
        "RED_FACE_ANGLE": 140.0,
        # 9. 赤側障害物から攻撃する直前の時間指定移動。
        #    力をためた～強い光の最終検知後7秒は入力しない。
        "RED_ATTACK_PREMOVE_ANGLE": 270.0,
        "RED_ATTACK_PREMOVE_ANGLE_SECONDS": 0.5,
        "RED_ATTACK_PREMOVE_BLOCK_SECONDS": 7.0,
        # 10. 赤側障害物で青を再確認した場合は通常mode5へ戻す。
        #     赤と青は同時に存在し得るため、途中の赤検知では青確認を
        #     取り消さず、確定青を複数回確認してから復帰する。
        "BLUE_RETURN_TO_LEGACY_ENABLED": True,
        "BLUE_RETURN_SECONDS": 1.0,
        "BLUE_RETURN_CHECK_INTERVAL_SECONDS": 0.30,
        "BLUE_RETURN_GAP_TOLERANCE_SECONDS": 10.0,
        "BLUE_RETURN_MIN_CONFIRMATIONS": 3,
        # 11. 赤側障害物で赤青とも長時間見えない場合の保険。
        #     障害物による一時遮蔽では戻さず、通常mode5へ戻して
        #     次のBLACK_COMMENT／SELECT後にTESTMODE1を再試行する。
        "RED_COVER_NO_ENEMY_RETURN_SECONDS": 20.0,
        "RED_COVER_NO_ENEMY_MIN_CONFIRMATIONS": 5,
    }

def ZA_mega_mode5_testmode1_warning_cycle_update(self, event):
    """連続する予兆セット間の青敵有無から赤側遷移を判定する。"""
    settings=self.ZA_mega_mode5_testmode1_settings()
    phase=str(getattr(
        self, "_za_mega_testmode1_phase", "DISABLED"))
    if (not getattr(self, "_za_mega_testmode1_enabled", False)
            or phase != "COVER_ATTACK"
            or not bool(settings.get(
                "WARNING_BLUE_FALLBACK_ENABLED", True))
            or int(settings.get("CHARGE_WARNING_SKIP_COUNT", -1)) >= 0):
        return False

    event=str(event or "").upper()
    if event == "BLUE":
        if getattr(
                self,
                "_za_mega_testmode1_warning_interval_active", False):
            if not getattr(
                    self,
                    "_za_mega_testmode1_warning_interval_blue_seen",
                    False):
                self.ZA_mega_mode5_trace(
                    "TESTMODE1_WARNING_BLUE_SEEN",
                    "blue confirmed between warning sets; keep blue cover",
                    force=True)
            self._za_mega_testmode1_warning_interval_blue_seen=True
        return False

    if event in {"CHARGE", "STRONG_LIGHT"}:
        cycle_active=bool(getattr(
            self, "_za_mega_testmode1_warning_cycle_active", False))
        if not cycle_active:
            self._za_mega_testmode1_warning_cycle_active=True
            self._za_mega_testmode1_warning_cycle_saw_strong=(
                event == "STRONG_LIGHT")
            if getattr(
                    self,
                    "_za_mega_testmode1_warning_interval_active", False):
                blue_seen=bool(getattr(
                    self,
                    "_za_mega_testmode1_warning_interval_blue_seen",
                    False))
                self._za_mega_testmode1_warning_interval_active=False
                self._za_mega_testmode1_warning_interval_blue_seen=False
                self._za_mega_testmode1_warning_red_pending=(
                    not blue_seen)
                self.ZA_mega_mode5_trace(
                    ("TESTMODE1_WARNING_BLUE_CONFIRMED"
                     if blue_seen else
                     "TESTMODE1_WARNING_RED_PENDING"),
                    ("blue was visible before next warning; keep blue cover"
                     if blue_seen else
                     "blue was absent until next warning; wait for strong "
                     "light to clear before red cover"),
                    force=True)
        elif event == "STRONG_LIGHT":
            self._za_mega_testmode1_warning_cycle_saw_strong=True
        return False

    if event != "CLEAR":
        return False
    if not getattr(
            self, "_za_mega_testmode1_warning_cycle_active", False):
        return False
    # 「力をためた」と「強い光」の間に通知が一時的に消えても、
    # 1組を2回と数えない。強い光が消えた時点だけをセット終了とする。
    if not getattr(
            self, "_za_mega_testmode1_warning_cycle_saw_strong", False):
        return False

    self._za_mega_testmode1_warning_cycle_active=False
    self._za_mega_testmode1_warning_cycle_saw_strong=False
    if getattr(
            self, "_za_mega_testmode1_warning_red_pending", False):
        self._za_mega_testmode1_warning_red_pending=False
        self._za_mega_testmode1_warning_interval_active=False
        self._za_mega_testmode1_warning_interval_blue_seen=False
        delay_seconds=max(0.0, float(settings.get(
            "WARNING_RED_COVER_DELAY_SECONDS", 5.0)))
        self._za_mega_testmode1_phase="WAIT_RED_COVER_DELAY"
        self._za_mega_testmode1_red_cover_move_not_before=(
            time.monotonic() + delay_seconds)
        self._za_mega_testmode1_red_only_since=0.0
        self._za_mega_testmode1_red_only_last_seen=0.0
        self._za_mega_testmode1_red_only_confirmations=0
        self._za_mega_testmode1_blue_last_seen_at=0.0
        self._za_mega_testmode1_enemy_check_retry_at=0.0
        self.ZA_mega_mode5_trace(
            "TESTMODE1_WARNING_RED_COVER_DELAY",
            "second strong light cleared; no blue in warning interval; "
            "wait {:.1f}s before red cover".format(delay_seconds),
            force=True)
        return True

    self._za_mega_testmode1_warning_interval_active=True
    self._za_mega_testmode1_warning_interval_blue_seen=False
    self.ZA_mega_mode5_trace(
        "TESTMODE1_WARNING_BLUE_WINDOW_START",
        "warning set complete; watch blue until next warning",
        force=True)
    return False

def ZA_mega_mode5_testmode1_enter_legacy(self, reason):
    """通常mode5をBLACK_COMMENT／SELECTまで維持する。"""
    if not getattr(self, "_za_mega_testmode1_enabled", False):
        return False
    already_latched=bool(getattr(
        self, "_za_mega_testmode1_legacy_until_reset", False))
    self._za_mega_testmode1_legacy_until_reset=True
    self._za_mega_testmode1_reinitialize_pending=False
    self._za_mega_testmode1_phase="LEGACY_COMBAT"
    self._za_mega_testmode1_resume_hp="LEGACY"
    self._za_mega_testmode1_enemy_check_retry_at=0.0
    self._za_mega_testmode1_red_only_since=0.0
    self._za_mega_testmode1_red_only_last_seen=0.0
    self._za_mega_testmode1_red_only_confirmations=0
    self._za_mega_testmode1_blue_last_seen_at=0.0
    self._za_mega_testmode1_red_premove_block_until=0.0
    self._za_mega_testmode1_red_premove_waiting_strong_light=False
    self._za_mega_testmode1_blue_return_since=0.0
    self._za_mega_testmode1_blue_return_last_seen=0.0
    self._za_mega_testmode1_blue_return_confirmations=0
    self._za_mega_testmode1_red_cover_no_enemy_since=0.0
    self._za_mega_testmode1_red_cover_no_enemy_confirmations=0
    self._za_mega_testmode1_existing_charge_latched=False
    self._za_mega_testmode1_warning_cycle_active=False
    self._za_mega_testmode1_warning_cycle_saw_strong=False
    self._za_mega_testmode1_warning_interval_active=False
    self._za_mega_testmode1_warning_interval_blue_seen=False
    self._za_mega_testmode1_warning_red_pending=False
    self._za_mega_testmode1_red_cover_move_not_before=0.0
    if not already_latched:
        self.ZA_mega_mode5_trace(
            "TESTMODE1_LEGACY_LATCH",
            "{}; use existing mode5 until BLACK_COMMENT/SELECT".format(
                reason),
            force=True)
    return True

def ZA_mega_mode5_testmode1_reset_for_selection(self, reason):
    """敗北Comment／選択肢で次ターゲット用TESTMODE1を再準備する。"""
    if not getattr(self, "_za_mega_testmode1_enabled", False):
        return False
    self._za_mega_testmode1_legacy_until_reset=False
    self._za_mega_testmode1_reinitialize_pending=True
    self._za_mega_testmode1_resume_hp="PENDING"
    self._za_mega_testmode1_phase="WAIT_RESUME"
    self._za_mega_testmode1_enemy_check_retry_at=0.0
    self._za_mega_testmode1_red_only_since=0.0
    self._za_mega_testmode1_red_only_last_seen=0.0
    self._za_mega_testmode1_red_only_confirmations=0
    self._za_mega_testmode1_blue_last_seen_at=0.0
    self._za_mega_testmode1_red_premove_block_until=0.0
    self._za_mega_testmode1_red_premove_waiting_strong_light=False
    self._za_mega_testmode1_blue_return_since=0.0
    self._za_mega_testmode1_blue_return_last_seen=0.0
    self._za_mega_testmode1_blue_return_confirmations=0
    self._za_mega_testmode1_red_cover_no_enemy_since=0.0
    self._za_mega_testmode1_red_cover_no_enemy_confirmations=0
    self._za_mega_testmode1_existing_charge_latched=False
    self._za_mega_testmode1_warning_cycle_active=False
    self._za_mega_testmode1_warning_cycle_saw_strong=False
    self._za_mega_testmode1_warning_interval_active=False
    self._za_mega_testmode1_warning_interval_blue_seen=False
    self._za_mega_testmode1_warning_red_pending=False
    self._za_mega_testmode1_red_cover_move_not_before=0.0
    self.ZA_mega_mode5_trace(
        "TESTMODE1_SELECTION_RESET",
        "{}; next FIELD may initialize TESTMODE1".format(reason),
        force=True)
    return True

def ZA_mega_mode5_testmode1_controls_cover(self):
    """試案の障害物待機が通常movemodeを置き換える区間を返す。"""
    return bool(
        getattr(self, "_za_mega_testmode1_enabled", False)
        and not getattr(
            self, "_za_mega_testmode1_legacy_until_reset", False)
        and not getattr(
            self, "_za_mega_testmode1_existing_charge_latched", False)
        and getattr(
            self, "_za_mega_testmode1_phase", "")
        in {"FACE_BLUE", "COVER_ATTACK", "WAIT_RED_COVER_DELAY",
            "MOVE_TO_RED_COVER",
            "FACE_RED", "RED_COVER_ATTACK"})

def ZA_mega_mode5_testmode1_red_only_fallback_update(self):
    """青を60秒検知できない時、赤側障害物移動へ進む。"""
    phase=str(getattr(
        self, "_za_mega_testmode1_phase", "DISABLED"))
    if (not getattr(self, "_za_mega_testmode1_enabled", False)
            or phase != "COVER_ATTACK"):
        self._za_mega_testmode1_red_only_since=0.0
        self._za_mega_testmode1_red_only_last_seen=0.0
        self._za_mega_testmode1_red_only_confirmations=0
        self._za_mega_testmode1_blue_last_seen_at=0.0
        return False

    settings=self.ZA_mega_mode5_testmode1_settings()
    now=time.monotonic()
    if now < float(getattr(
            self, "_za_mega_testmode1_enemy_check_retry_at", 0.0)):
        return False
    self._za_mega_testmode1_enemy_check_retry_at=(
        now + max(0.10, float(settings.get(
            "BLUE_ABSENCE_CHECK_INTERVAL_SECONDS", 0.30))))

    # refresh_frame=Trueで毎回新しいCameraフレームを取得する。
    # 赤や無色は青検知には含めず、青だけで60秒タイマーを戻す。
    direction=self.ZA_mega_mode5_colored_enemy_direction(
        allow_resume=True, refresh_frame=True)
    stable_color=(str(getattr(
        self, "_za_mega_colored_enemy_color", "") or "").lower()
        if isinstance(direction, Direction) else "")
    # 安定青だけでなく生の青候補も生存確認に使用する。
    observed_color=str(getattr(
        self, "_za_mega_colored_enemy_observed_color", "") or "").lower()
    if not stable_color and not observed_color:
        self.ZA_mega_mode5_trace(
            "TESTMODE1_ENEMY_OCCLUDED",
            "no red/blue in fresh frame; continue blue absence timer")
    if stable_color == "blue" or observed_color == "blue":
        previous_seen=float(getattr(
            self, "_za_mega_testmode1_blue_last_seen_at", 0.0))
        self._za_mega_testmode1_blue_last_seen_at=now
        self.ZA_mega_mode5_testmode1_warning_cycle_update("BLUE")
        had_red=bool(getattr(
            self, "_za_mega_testmode1_red_only_confirmations", 0))
        self._za_mega_testmode1_red_only_since=0.0
        self._za_mega_testmode1_red_only_last_seen=0.0
        self._za_mega_testmode1_red_only_confirmations=0
        self.ZA_mega_mode5_trace(
            "TESTMODE1_BLUE_ABSENCE_RESET",
            "blue enemy confirmed; reset absence timer after {:.1f}s".format(
                max(0.0, now - previous_seen)
                if previous_seen > 0.0 else 0.0))
        if had_red:
            self.ZA_mega_mode5_trace(
                "TESTMODE1_RED_ONLY_RESET",
                "blue enemy confirmed; reset red-only timer",
                force=True)
        return False

    blue_last_seen=float(getattr(
        self, "_za_mega_testmode1_blue_last_seen_at", 0.0))
    if blue_last_seen <= 0.0:
        blue_last_seen=now
        self._za_mega_testmode1_blue_last_seen_at=now
    required_seconds=max(0.0, float(settings.get(
        "BLUE_ABSENCE_FALLBACK_SECONDS", 60.0)))
    elapsed=max(0.0, now - blue_last_seen)
    self.ZA_mega_mode5_trace(
        "TESTMODE1_BLUE_ABSENCE_WAIT",
        "blue not detected {:.1f}/{:.1f}s; keep blue cover".format(
            elapsed, required_seconds))
    if elapsed >= required_seconds:
        # 既存2判定が成立しない場合も、60秒青が見えなければ
        # 赤色の成否に依存せず赤側の固定障害物経路へ移る。
        self._za_mega_testmode1_phase="MOVE_TO_RED_COVER"
        self._za_mega_testmode1_red_only_since=0.0
        self._za_mega_testmode1_red_only_last_seen=0.0
        self._za_mega_testmode1_red_only_confirmations=0
        self._za_mega_testmode1_blue_last_seen_at=0.0
        self._za_mega_testmode1_enemy_check_retry_at=0.0
        self._za_mega_testmode1_warning_cycle_active=False
        self._za_mega_testmode1_warning_cycle_saw_strong=False
        self._za_mega_testmode1_warning_interval_active=False
        self._za_mega_testmode1_warning_interval_blue_seen=False
        self._za_mega_testmode1_warning_red_pending=False
        self._za_mega_testmode1_red_cover_move_not_before=0.0
        self.ZA_mega_mode5_trace(
            "TESTMODE1_BLUE_ABSENCE_TIMEOUT",
            "blue not detected for {:.1f}s; move to red-side cover".format(
                elapsed),
            force=True)
        return True

    color=stable_color
    burrow_grace=max(0.0, float(settings.get(
        "BLUE_BURROW_GRACE_SECONDS", 12.0)))
    if now - blue_last_seen < burrow_grace:
        self._za_mega_testmode1_red_only_since=0.0
        self._za_mega_testmode1_red_only_last_seen=0.0
        self._za_mega_testmode1_red_only_confirmations=0
        if color == "red":
            self.ZA_mega_mode5_trace(
                "TESTMODE1_BLUE_BURROW_GRACE",
                "blue hidden {:.1f}/{:.1f}s; keep blue-side cover".format(
                    max(0.0, now - blue_last_seen), burrow_grace))
        return False

    last_seen=float(getattr(
        self, "_za_mega_testmode1_red_only_last_seen", 0.0))
    gap_limit=max(0.0, float(settings.get(
        "RED_ONLY_GAP_TOLERANCE_SECONDS", 10.0)))
    if color != "red":
        if last_seen <= 0.0 or now - last_seen > gap_limit:
            had_red=bool(getattr(
                self, "_za_mega_testmode1_red_only_confirmations", 0))
            self._za_mega_testmode1_red_only_since=0.0
            self._za_mega_testmode1_red_only_last_seen=0.0
            self._za_mega_testmode1_red_only_confirmations=0
            if had_red:
                self.ZA_mega_mode5_trace(
                    "TESTMODE1_RED_ONLY_RESET",
                    "red enemy missing for {:.1f}s; reset timer".format(
                        max(0.0, now - last_seen)),
                    force=True)
        return False

    red_since=float(getattr(
        self, "_za_mega_testmode1_red_only_since", 0.0))
    confirmations=int(getattr(
        self, "_za_mega_testmode1_red_only_confirmations", 0))
    if red_since <= 0.0 or last_seen <= 0.0 or now - last_seen > gap_limit:
        red_since=now
        confirmations=1
        self.ZA_mega_mode5_trace(
            "TESTMODE1_RED_ONLY_CHECK",
            "red enemy confirmed without blue; begin fallback timer",
            force=True)
    else:
        confirmations+=1
    self._za_mega_testmode1_red_only_since=red_since
    self._za_mega_testmode1_red_only_last_seen=now
    self._za_mega_testmode1_red_only_confirmations=confirmations

    red_required_seconds=max(0.0, float(settings.get(
        "RED_ONLY_FALLBACK_SECONDS", 3.0)))
    required_confirmations=max(1, int(settings.get(
        "RED_ONLY_MIN_CONFIRMATIONS", 3)))
    red_elapsed=max(0.0, now - red_since)
    self.ZA_mega_mode5_trace(
        "TESTMODE1_RED_ONLY_CHECK",
        "red only {:.1f}s; confirmation {}/{}".format(
            red_elapsed, confirmations, required_confirmations))
    if (red_elapsed < red_required_seconds
            or confirmations < required_confirmations):
        return False

    self._za_mega_testmode1_phase="MOVE_TO_RED_COVER"
    self._za_mega_testmode1_red_only_since=0.0
    self._za_mega_testmode1_red_only_last_seen=0.0
    self._za_mega_testmode1_red_only_confirmations=0
    self._za_mega_testmode1_blue_last_seen_at=0.0
    self._za_mega_testmode1_enemy_check_retry_at=0.0
    self._za_mega_testmode1_warning_cycle_active=False
    self._za_mega_testmode1_warning_cycle_saw_strong=False
    self._za_mega_testmode1_warning_interval_active=False
    self._za_mega_testmode1_warning_interval_blue_seen=False
    self._za_mega_testmode1_warning_red_pending=False
    self._za_mega_testmode1_red_cover_move_not_before=0.0
    self.ZA_mega_mode5_trace(
        "TESTMODE1_RED_COVER_READY",
        "red only {:.1f}s ({} checks); move to red-side cover".format(
            red_elapsed, confirmations),
        force=True)
    return True

def ZA_mega_mode5_testmode1_blue_return_update(self):
    """赤側で青の再出現または長時間の敵不在を確認して通常へ戻す。"""
    phase=str(getattr(
        self, "_za_mega_testmode1_phase", "DISABLED"))
    if (not getattr(self, "_za_mega_testmode1_enabled", False)
            or phase != "RED_COVER_ATTACK"):
        self._za_mega_testmode1_blue_return_since=0.0
        self._za_mega_testmode1_blue_return_last_seen=0.0
        self._za_mega_testmode1_blue_return_confirmations=0
        self._za_mega_testmode1_red_cover_no_enemy_since=0.0
        self._za_mega_testmode1_red_cover_no_enemy_confirmations=0
        return False

    settings=self.ZA_mega_mode5_testmode1_settings()
    if not bool(settings.get(
            "BLUE_RETURN_TO_LEGACY_ENABLED", False)):
        self._za_mega_testmode1_blue_return_since=0.0
        self._za_mega_testmode1_blue_return_last_seen=0.0
        self._za_mega_testmode1_blue_return_confirmations=0
        self._za_mega_testmode1_red_cover_no_enemy_since=0.0
        self._za_mega_testmode1_red_cover_no_enemy_confirmations=0
        return False
    now=time.monotonic()
    if now < float(getattr(
            self, "_za_mega_testmode1_enemy_check_retry_at", 0.0)):
        return False
    self._za_mega_testmode1_enemy_check_retry_at=(
        now + max(0.10, float(settings.get(
            "BLUE_RETURN_CHECK_INTERVAL_SECONDS", 0.30))))
    direction=self.ZA_mega_mode5_colored_enemy_direction(
        allow_resume=True, refresh_frame=True)
    stable_color=(str(getattr(
        self, "_za_mega_colored_enemy_color", "") or "").lower()
        if isinstance(direction, Direction) else "")
    observed_color=str(getattr(
        self, "_za_mega_colored_enemy_observed_color", "") or "").lower()
    # 生の青候補1回ではなく、色helperが位置・面積を連続確認した
    # 確定青だけを通常mode5への復帰条件に使用する。
    color=stable_color
    last_seen=float(getattr(
        self, "_za_mega_testmode1_blue_return_last_seen", 0.0))
    gap_limit=max(0.0, float(settings.get(
        "BLUE_RETURN_GAP_TOLERANCE_SECONDS", 10.0)))
    if color == "blue":
        # 赤と青は同時に存在するため、途中に確定赤が挟まっても
        # 青確認は取り消さない。最後の確定青からの時間だけを見る。
        blue_since=float(getattr(
            self, "_za_mega_testmode1_blue_return_since", 0.0))
        confirmations=int(getattr(
            self, "_za_mega_testmode1_blue_return_confirmations", 0))
        if (blue_since <= 0.0 or last_seen <= 0.0
                or now - last_seen > gap_limit):
            blue_since=now
            confirmations=1
        else:
            confirmations+=1
        self._za_mega_testmode1_blue_return_since=blue_since
        self._za_mega_testmode1_blue_return_last_seen=now
        self._za_mega_testmode1_blue_return_confirmations=confirmations
        self._za_mega_testmode1_red_cover_no_enemy_since=0.0
        self._za_mega_testmode1_red_cover_no_enemy_confirmations=0
        required_seconds=max(0.0, float(settings.get(
            "BLUE_RETURN_SECONDS", 1.0)))
        required_confirmations=max(1, int(settings.get(
            "BLUE_RETURN_MIN_CONFIRMATIONS", 3)))
        elapsed=max(0.0, now - blue_since)
        self.ZA_mega_mode5_trace(
            "TESTMODE1_BLUE_RETURN_CHECK",
            "blue {:.1f}s; confirmation {}/{}".format(
                elapsed, confirmations, required_confirmations))
        if (elapsed >= required_seconds
                and confirmations >= required_confirmations):
            self.ZA_mega_mode5_testmode1_enter_legacy(
                "BLUE_REAPPEARED")
            self.ZA_mega_mode5_trace(
                "TESTMODE1_BLUE_RETURN_LEGACY",
                "blue {:.1f}s ({} checks); resume existing mode5".format(
                    elapsed, confirmations),
                force=True)
            return True
        return False

    # 生候補を含めて赤か青が見えていれば、障害物による完全遮蔽では
    # ないので「両方見えない」保険だけを初期化する。確定赤は青の
    # 不在証明ではないため、上の青確認回数はここでは破棄しない。
    any_enemy_visible=(
        color in {"red", "blue"}
        or observed_color in {"red", "blue"})
    if any_enemy_visible:
        self._za_mega_testmode1_red_cover_no_enemy_since=0.0
        self._za_mega_testmode1_red_cover_no_enemy_confirmations=0
    else:
        no_enemy_since=float(getattr(
            self, "_za_mega_testmode1_red_cover_no_enemy_since", 0.0))
        no_enemy_confirmations=int(getattr(
            self,
            "_za_mega_testmode1_red_cover_no_enemy_confirmations", 0))
        if no_enemy_since <= 0.0:
            no_enemy_since=now
            no_enemy_confirmations=1
        else:
            no_enemy_confirmations+=1
        self._za_mega_testmode1_red_cover_no_enemy_since=no_enemy_since
        self._za_mega_testmode1_red_cover_no_enemy_confirmations=(
            no_enemy_confirmations)
        no_enemy_seconds=max(0.0, float(settings.get(
            "RED_COVER_NO_ENEMY_RETURN_SECONDS", 20.0)))
        no_enemy_min=max(1, int(settings.get(
            "RED_COVER_NO_ENEMY_MIN_CONFIRMATIONS", 5)))
        no_enemy_elapsed=max(0.0, now - no_enemy_since)
        self.ZA_mega_mode5_trace(
            "TESTMODE1_RED_COVER_NO_ENEMY_CHECK",
            "no red/blue {:.1f}s; confirmation {}/{}".format(
                no_enemy_elapsed, no_enemy_confirmations, no_enemy_min))
        if (no_enemy_elapsed >= no_enemy_seconds
                and no_enemy_confirmations >= no_enemy_min):
            self.ZA_mega_mode5_testmode1_enter_legacy(
                "RED_COVER_NO_ENEMY")
            self.ZA_mega_mode5_trace(
                "TESTMODE1_RED_COVER_NO_ENEMY_LEGACY",
                "no red/blue {:.1f}s ({} checks); retry existing mode5".format(
                    no_enemy_elapsed, no_enemy_confirmations),
                force=True)
            return True

    if last_seen <= 0.0 or now - last_seen > gap_limit:
        self._za_mega_testmode1_blue_return_since=0.0
        self._za_mega_testmode1_blue_return_last_seen=0.0
        self._za_mega_testmode1_blue_return_confirmations=0
    return False

def ZA_mega_mode5_testmode1_resume_update(
        self, dir1, dir2, dir3, dir4, see_r):
    """再開経路の準備完了後、青敵側の障害物へ移動する試案。"""
    if not getattr(self, "_za_mega_testmode1_enabled", False):
        return None
    settings=self.ZA_mega_mode5_testmode1_settings()
    phase=str(getattr(
        self, "_za_mega_testmode1_phase", "DISABLED"))
    if phase == "HP75_EXISTING":
        return None
    now=time.monotonic()
    if phase == "CLASSIFY_HP":
        if now < float(getattr(
                self, "_za_mega_testmode1_hp_retry_at", 0.0)):
            self.wait(0.1)
            return True
        resume_hp=self.ZA_mega_mode5_hp_resume_mode()
        remaining=max(0, int(getattr(
            self, "_za_mega_testmode1_hp_checks_remaining", 0)) - 1)
        self._za_mega_testmode1_hp_checks_remaining=remaining
        self._za_mega_testmode1_hp_retry_at=now + 0.25
        if resume_hp == "UNKNOWN" and remaining > 0:
            self.ZA_mega_mode5_trace(
                "HP_UNKNOWN",
                "testmode1 wait for visible HP bar ({}/4)".format(
                    4 - remaining))
            self.wait(0.1)
            return True
        if resume_hp == "UNKNOWN":
            # 判定不能のまま棒立ちにせず、試案側のOTHERとして進める。
            resume_hp="OTHER"
        self._za_mega_testmode1_resume_hp=resume_hp
        if resume_hp == "HP75":
            self._za_mega_testmode1_phase="HP75_EXISTING"
            self._za_mega_mode5_green_priority_checks_remaining=(
                max(0, int(settings["INITIAL_GREEN_CHECK_COUNT"]))
                if self._za_mega_z_guard_enabled else 0)
            self.ZA_mega_mode5_trace(
                "HP75",
                "testmode1 start fixed 90deg resume without green check",
                force=True)
            return None
        self._za_mega_testmode1_phase="MOVE_TO_COVER"
        self.ZA_mega_mode5_trace(
            "HP_OTHER",
            "testmode1 skip green/90deg leg; direct fixed cover route",
            force=True)
        phase="MOVE_TO_COVER"

    if phase != "MOVE_TO_COVER":
        return True
    self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
    self.ZA_ZL_ACTION("END")
    self.ZA_mega_mode5_marker_search_view_stop(relock=False)
    self.ZA_MOVE_SEE(action="END", in_see_r=see_r)
    resume_hp=str(getattr(
        self, "_za_mega_testmode1_resume_hp", "OTHER"))
    if resume_hp == "HP75":
        # HP75は先に90度の固定初期移動を行うため、その終了位置から
        # 手動設定の固定角度で青側障害物へ回る。
        # 移動後も手動設定角度へ向き、障害物を挟んで攻撃を開始する。
        blue_direction=0
        blue_found=False
        cover_angle=float(settings["HP75_COVER_MOVE_ANGLE"])
        face_angle=float(settings["HP75_FACE_ANGLE"])
        cover_seconds=float(settings["HP75_COVER_MOVE_SECONDS"])
        cover_detection="HP75_BLUE_COVER_FIXED"
    else:
        # HP75以外も青色の画面位置では角度を変えない。再開地点から
        # 青側障害物へ到達するための固定経路をそのまま実行する。
        cover_angle=float(settings["OTHER_COVER_MOVE_ANGLE"])
        face_angle=float(settings["OTHER_FACE_ANGLE"])
        cover_seconds=float(settings["OTHER_COVER_MOVE_SECONDS"])
        cover_detection="OTHER_BLUE_COVER_FIXED"

    self._za_mega_testmode1_cover_angle=cover_angle
    self._za_mega_testmode1_face_angle=face_angle
    self.ZA_mega_mode5_marker_search_view_stop(relock=False)
    self.ZA_MOVE_SEE(action="END", in_see_r=see_r)
    self.press(
        Direction(Stick.LEFT, cover_angle, 1.0),
        duration=cover_seconds, wait=0.0)
    self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
    self._za_mega_mode5_initial_phase_active=False
    self._za_mega_mode5_green_priority_checks_remaining=0
    self._za_mega_testmode1_phase="FACE_BLUE"
    self.ZA_mega_mode5_set_start_flag(
        3,
        cover_detection,
        "testmode1 cover move angle={:.0f} {:.1f}s; "
        "face={:.0f}; FIELD input next".format(
            cover_angle, cover_seconds, face_angle))
    return True

def ZA_mega_mode5_testmode1_combat_update(
        self, dir1, dir2, dir3, dir4, see_r):
    """障害物から青敵へL正面化し、攻撃間に非ロックオンYを行う。"""
    settings=self.ZA_mega_mode5_testmode1_settings()
    if not self.ZA_mega_mode5_testmode1_controls_cover():
        if (getattr(self, "_za_mega_testmode1_enabled", False)
                and getattr(
                    self, "_za_mega_testmode1_phase", "")
                == "EXISTING_GREEN"):
            if self.ZA_mega_z_guard_update(dir1,dir2,dir3,dir4):
                self.ZA_mega_mode5_trace(
                    "GREEN_FLOOR",
                    "testmode1 temporarily use existing green action")
                return "handled"
            self._za_mega_testmode1_phase="WAIT_RESUME"
            self._za_mega_testmode1_resume_hp="PENDING"
            self.ZA_mega_mode5_set_start_flag(
                0, "GREEN_FLOOR_COMPLETE",
                "testmode1 restart from HP classification",
            )
            return "restart"
        return "none"

    phase=str(getattr(
        self, "_za_mega_testmode1_phase", "FACE_BLUE"))
    now=time.monotonic()
    if phase == "WAIT_RED_COVER_DELAY":
        # 2組目の強い光が消えても5秒は青側障害物に留まる。
        # 期限後は追加の上下入力を行わず、赤側障害物へ移動する。
        self.ZA_mega_mode5_marker_search_view_stop(relock=False)
        self.ZA_MOVE_SEE(action="END", in_see_r=see_r)
        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
        self.ZA_ZL_ACTION("END")
        move_not_before=float(getattr(
            self, "_za_mega_testmode1_red_cover_move_not_before", 0.0))
        if now < move_not_before:
            self.ZA_mega_mode5_trace(
                "TESTMODE1_WARNING_RED_COVER_WAIT",
                "wait {:.1f}s at blue cover".format(
                    max(0.0, move_not_before - now)))
            return "handled"
        self._za_mega_testmode1_red_cover_move_not_before=0.0
        self._za_mega_testmode1_phase="MOVE_TO_RED_COVER"
        phase="MOVE_TO_RED_COVER"
        self.ZA_mega_mode5_trace(
            "TESTMODE1_WARNING_RED_COVER_READY",
            "5.0s delay complete; begin fixed red-cover move",
            force=True)
    if phase == "MOVE_TO_RED_COVER":
        # 青撃破後は通常探索へ戻さず、現在の青側障害物から
        # Yを3回障害物に当てて開始点を揃え、赤側障害物へ
        # 手動設定の固定経路で一度だけ移動する。
        cover_angle=float(settings["RED_COVER_MOVE_ANGLE"])
        cover_seconds=float(settings["RED_COVER_MOVE_SECONDS"])
        face_angle=float(settings["RED_FACE_ANGLE"])
        anchor_angle=float(settings[
            "BLUE_TO_RED_ANCHOR_DODGE_ANGLE"])
        anchor_repeat=max(1, int(settings[
            "BLUE_TO_RED_ANCHOR_DODGE_REPEAT"]))
        self.ZA_mega_mode5_marker_search_view_stop(relock=False)
        self.ZA_MOVE_SEE(action="END", in_see_r=see_r)
        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
        self.ZA_ZL_ACTION("END")
        self.ZA_MOVE_LStick(
            dir1,dir2,dir3,dir4,
            Direction(Stick.LEFT, anchor_angle, 1.0),
            "RELOAD", force_direction=True)
        self.pressRep(
            Button.Y, repeat=anchor_repeat, duration=0.04,
            wait=0.0, interval=0.12)
        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
        self.ZA_mega_mode5_trace(
            "TESTMODE1_BLUE_COVER_ANCHOR",
            "unlock; Y x{} at {:.0f}deg to fix red-route start".format(
                anchor_repeat, anchor_angle),
            force=True)
        self.press(
            Direction(Stick.LEFT, cover_angle, 1.0),
            duration=cover_seconds, wait=0.0)
        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
        self._za_mega_testmode1_cover_angle=cover_angle
        self._za_mega_testmode1_face_angle=face_angle
        self._za_mega_testmode1_phase="FACE_RED"
        self.ZA_mega_mode5_trace(
            "TESTMODE1_RED_COVER_MOVE",
            "fixed move {:.0f}deg {:.1f}s; face red {:.0f}deg".format(
                cover_angle, cover_seconds, face_angle),
            force=True)
        return "handled"

    if phase in {"FACE_BLUE", "FACE_RED"}:
        # 障害物へ入った後も一時的な色位置で固定角度を上書きせず、
        # 青側／赤側それぞれの保存角度へ向いてからLを入力する。
        resume_hp=str(getattr(
            self, "_za_mega_testmode1_resume_hp", "OTHER"))
        face_angle=float(getattr(
            self, "_za_mega_testmode1_face_angle", 90.0))
        self._za_mega_testmode1_face_angle=face_angle
        self.ZA_mega_mode5_marker_search_view_stop(relock=False)
        self.ZA_ZL_ACTION("END")
        self.ZA_MOVE_LStick(
            dir1,dir2,dir3,dir4,
            Direction(Stick.LEFT, face_angle, 1.0),
            "RELOAD", force_direction=True)
        self.wait(max(
            0.0, float(settings["FACE_DIRECTION_SECONDS"])))
        self.pressRep(
            Button.L, repeat=1, duration=0.04,
            wait=0.0, interval=0.1)
        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
        self.ZA_ZL_ACTION("")
        red_cover=phase == "FACE_RED"
        self._za_mega_testmode1_phase=(
            "RED_COVER_ATTACK" if red_cover else "COVER_ATTACK")
        if not red_cover:
            # 青側へ向いてLを入れた時点を潜行猶予の起点にする。
            # 色が最初の数周で取れなくても即赤側へ切り替えない。
            self._za_mega_testmode1_blue_last_seen_at=time.monotonic()
        self._za_mega_testmode1_next_dodge_at=(
            time.monotonic()
            + max(0.0, float(
                settings["COVER_DODGE_INTERVAL_SECONDS"])))
        self.ZA_mega_mode5_trace(
            ("RED_FIXED_FACE" if red_cover
             else "HP75_FIXED_FACE" if resume_hp == "HP75"
             else "OTHER_FIXED_FACE"),
            "testmode1 move {:.0f}deg then Button.L; lockon attack".format(
                face_angle),
            force=True)
        return "handled"

    if (phase == "RED_COVER_ATTACK"
            and self.ZA_mega_mode5_testmode1_blue_return_update()):
        # 設定で明示的に自動復帰を有効化した場合だけ到達する。
        return "fallback"

    # 障害物位置から通常movemodeへ戻ると敵へ接近して遮蔽物を離れる。
    # 「力をためた／強い光」通知までは視点と通常左入力を止め、
    # 障害物内から攻撃する。通常時の緑床はここへ割り込ませず、
    # 予兆検知後のcharge処理だけが緑床探索・移動を開始する。
    # 2.4秒ごとだけ前方90度へYを2回送り、直後に再ロックオンする。
    self.ZA_mega_mode5_marker_search_view_stop(relock=False)
    self.ZA_MOVE_SEE(action="END", in_see_r=see_r)
    if now < float(getattr(
            self, "_za_mega_testmode1_next_dodge_at", 0.0)):
        block_until=float(getattr(
            self,
            "_za_mega_testmode1_red_premove_block_until", 0.0))
        waiting_strong_light=bool(getattr(
            self,
            "_za_mega_testmode1_red_premove_waiting_strong_light",
            False))
        premove_blocked=(
            phase in {"COVER_ATTACK", "RED_COVER_ATTACK"}
            and (waiting_strong_light or now < block_until))
        if premove_blocked:
            self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
            self.ZA_mega_mode5_trace(
                ("TESTMODE1_RED_ATTACK_PREMOVE_SKIP"
                 if phase == "RED_COVER_ATTACK" else
                 "TESTMODE1_BLUE_ATTACK_PREMOVE_SKIP"),
                ("wait for strong light before 7s cooldown"
                 if waiting_strong_light else
                 "strong-light cooldown {:.1f}s remaining".format(
                     max(0.0, block_until - now))))
        elif phase == "RED_COVER_ATTACK":
            move_angle=float(settings[
                "RED_ATTACK_PREMOVE_ANGLE"])
            move_angle_seconds=float(settings[
                "RED_ATTACK_PREMOVE_ANGLE_SECONDS"])
            self.press(
                Direction(Stick.LEFT, move_angle, 1.0),
                duration=move_angle_seconds, wait=0.5)
            self.ZA_mega_mode5_trace(
                "TESTMODE1_RED_ATTACK_PREMOVE",
                "move {:.0f}deg for {:.1f}s before attack".format(
                    move_angle, move_angle_seconds))
        elif phase == "COVER_ATTACK":
            move_angle=float(settings[
                "BLUE_ATTACK_PREMOVE_ANGLE"])
            move_angle_seconds=float(settings[
                "BLUE_ATTACK_PREMOVE_ANGLE_SECONDS"])
            self.press(
                Direction(Stick.LEFT, move_angle, 1.0),
                duration=move_angle_seconds, wait=0.5)
            self.ZA_mega_mode5_trace(
                "TESTMODE1_BLUE_ATTACK_PREMOVE",
                "move {:.0f}deg for {:.1f}s before attack".format(
                    move_angle, move_angle_seconds))
            # 障害物内では敵本体が隠れるため、存在確認を先に行うと
            # 青の生存／赤だけの状態を判定できない。270度移動後の
            # 視界が開いた最新フレームで判定し、両方見えない場合は
            # red_only helper側で青側を維持する。
            if self.ZA_mega_mode5_testmode1_red_only_fallback_update():
                return "handled"
        else:
            self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
        if getattr(self, "ZL_state", 0) == 0:
            self.ZA_ZL_ACTION("")
        return "attack"

    self.ZA_mega_mode5_marker_search_view_stop(relock=False)
    self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
    self.ZA_ZL_ACTION("END")
    self.ZA_MOVE_LStick(
        dir1,dir2,dir3,dir4,
        Direction(
            Stick.LEFT,
            float(settings["COVER_DODGE_ANGLE"]), 1.0),
        "RELOAD", force_direction=True)
    self.pressRep(
        Button.Y,
        repeat=max(1, int(settings["COVER_DODGE_REPEAT"])),
        duration=0.04,
        wait=0.0, interval=0.12)
    self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
    self.ZA_ZL_ACTION("")
    self._za_mega_testmode1_next_dodge_at=(
        time.monotonic()
        + max(0.0, float(
            settings["COVER_DODGE_INTERVAL_SECONDS"])))
    self.ZA_mega_mode5_trace(
        ("TESTMODE1_RED_COVER" if phase == "RED_COVER_ATTACK"
         else "TESTMODE1_BLUE_COVER"),
        "unlock; Y x{} toward obstacle; relock".format(
            max(1, int(settings["COVER_DODGE_REPEAT"]))),
        force=True)
    return "handled"

def ZA_mega_mode5_testmode1_finish_hp75_initial(self, detection):
    """HP75専用の初期回避後、青側障害物経路へ合流する。"""
    if not (getattr(self, "_za_mega_testmode1_enabled", False)
            and not getattr(
                self, "_za_mega_testmode1_legacy_until_reset", False)
            and getattr(
                self, "_za_mega_testmode1_resume_hp", "") == "HP75"):
        return False
    self._za_mega_testmode1_phase="MOVE_TO_COVER"
    self._za_mega_testmode1_blue_scan_attempts=0
    self._za_mega_mode5_initial_phase_active=False
    self._za_mega_mode5_green_priority_checks_remaining=0
    self._za_mega_mode5_post_move_wait_until=0.0
    self.ZA_mega_mode5_marker_search_view_stop(relock=False)
    cover_angle=float(self.ZA_mega_mode5_testmode1_settings()[
        "HP75_COVER_MOVE_ANGLE"])
    self.ZA_mega_mode5_transition(
        "BLUE_COVER_SEARCH",
        "HP75 90deg initial movement complete; "
        "fixed {:.0f}deg cover route".format(cover_angle))
    self.ZA_mega_mode5_trace(
        detection,
        "HP75 initial movement complete; "
        "move {:.0f}deg to blue-side cover".format(cover_angle),
        force=True)
    return True

def ZA_mega_mode5_begin_resume(
        self, z_guard_enabled, initial_approach_seconds, see_r,
        resume_reason):
    """戦闘再開時に前ターゲット状態を破棄し、HP別開始経路へ遷移する。"""
    self.ZA_mega_mode5_marker_search_view_stop(relock=False)
    self.ZA_MOVE_SEE(action="END", in_see_r=see_r)
    testmode1_configured=bool(getattr(
        self, "_za_mega_testmode1_enabled", False))
    legacy_latched=bool(getattr(
        self, "_za_mega_testmode1_legacy_until_reset", False))
    reinitialize_pending=bool(getattr(
        self, "_za_mega_testmode1_reinitialize_pending", True))
    testmode1_enabled=bool(
        testmode1_configured and reinitialize_pending
        and not legacy_latched)
    retained_testmode=bool(
        testmode1_configured and not reinitialize_pending
        and not legacy_latched)
    retained_phase=str(getattr(
        self, "_za_mega_testmode1_phase", "COVER_ATTACK"))
    if retained_phase in {"WAIT_RESUME", "EXISTING_CHARGE"}:
        retained_phase=str(getattr(
            self, "_za_mega_testmode1_phase_before_charge",
            "COVER_ATTACK"))
    if retained_phase not in {
            "MOVE_TO_COVER", "FACE_BLUE", "COVER_ATTACK",
            "WAIT_RED_COVER_DELAY", "MOVE_TO_RED_COVER",
            "FACE_RED", "RED_COVER_ATTACK"}:
        retained_phase="COVER_ATTACK"
    settings=(self.ZA_mega_mode5_testmode1_settings()
              if testmode1_enabled else None)
    resume_hp=(
        self.ZA_mega_mode5_hp_resume_mode()
        if testmode1_enabled else
        str(getattr(self, "_za_mega_testmode1_resume_hp", "OTHER"))
        if retained_testmode else "LEGACY")
    hp_frame=getattr(self, "_za_mega_testmode1_hp_frame", None)
    yellow_low_hp=self.ZA_mega_mode5_low_yellow_hp(frame=hp_frame)
    self._za_mega_mode5_low_yellow_hp_active=bool(yellow_low_hp)
    # 再開検知の瞬間は暗転や選択肢からの切替中で、
    # HPバーがまだ出ていない場合がある。初回失敗だけで
    # 通常HPに固定せず、初期移動後の待機中まで再確認する。
    self._za_mega_mode5_low_yellow_hp_checks_remaining=(
        0 if yellow_low_hp else 4)
    self._za_mega_mode5_low_yellow_hp_retry_at=(
        time.monotonic() + 0.25)
    self._za_mega_mode5_low_yellow_hp_lock_seen=False
    self._za_mega_mode5_lockon_retreating=False
    self._za_mega_testmode1_resume_hp=resume_hp
    self._za_mega_testmode1_hp_checks_remaining=(
        4 if resume_hp == "UNKNOWN" else 0)
    self._za_mega_testmode1_hp_retry_at=time.monotonic() + 0.25
    self._za_mega_testmode1_blue_scan_attempts=0
    self._za_mega_testmode1_face_attempts=0
    self._za_mega_testmode1_next_dodge_at=0.0
    self._za_mega_testmode1_enemy_check_retry_at=0.0
    self._za_mega_testmode1_red_only_since=0.0
    self._za_mega_testmode1_red_only_last_seen=0.0
    self._za_mega_testmode1_red_only_confirmations=0
    self._za_mega_testmode1_blue_last_seen_at=0.0
    self._za_mega_testmode1_red_premove_block_until=0.0
    self._za_mega_testmode1_red_premove_waiting_strong_light=False
    self._za_mega_testmode1_blue_return_since=0.0
    self._za_mega_testmode1_blue_return_last_seen=0.0
    self._za_mega_testmode1_blue_return_confirmations=0
    self._za_mega_testmode1_red_cover_no_enemy_since=0.0
    self._za_mega_testmode1_red_cover_no_enemy_confirmations=0
    self._za_mega_testmode1_existing_charge_latched=False
    self._za_mega_testmode1_warning_cycle_active=False
    self._za_mega_testmode1_warning_cycle_saw_strong=False
    self._za_mega_testmode1_warning_interval_active=False
    self._za_mega_testmode1_warning_interval_blue_seen=False
    self._za_mega_testmode1_warning_red_pending=False
    self._za_mega_testmode1_red_cover_move_not_before=0.0
    if testmode1_enabled:
        # TESTMODE1の固定移動はBLACK_COMMENT／SELECTの後の
        # 最初のFIELDでだけ1度初期化する。
        self._za_mega_testmode1_reinitialize_pending=False
    if not testmode1_configured:
        self._za_mega_testmode1_phase="DISABLED"
    elif legacy_latched:
        self._za_mega_testmode1_phase="LEGACY_COMBAT"
        self._za_mega_testmode1_resume_hp="LEGACY"
    elif retained_testmode:
        self._za_mega_testmode1_phase=retained_phase
        if retained_phase == "COVER_ATTACK":
            # FIELD再開で試案を初期化し直さないが、青が再び出た
            # 直後として潜行猶予だけは取り直す。
            self._za_mega_testmode1_blue_last_seen_at=time.monotonic()
    elif resume_hp == "HP75":
        self._za_mega_testmode1_phase="HP75_EXISTING"
    elif resume_hp == "OTHER":
        self._za_mega_testmode1_phase="MOVE_TO_COVER"
    else:
        self._za_mega_testmode1_phase="CLASSIFY_HP"
    # 黄色HPは初期移動角度ではなく、ロックオン後の距離維持へ使う。
    self._za_mega_mode5_initial_approach_angle=90
    if yellow_low_hp:
        print(
            "[MEGA_MODE5_HP] yellow low HP detected ratio={:.3f}; "
            "enable lockon standoff; initial move remains 90deg".format(
                float(getattr(
                    self, "_za_mega_mode5_yellow_hp_fill_ratio", 0.0))))
    self._za_mega_mode5_view_search_block_until=0.0
    self._za_mega_mode5_view_search_block_logged=False
    use_existing_resume=bool(
        not testmode1_configured
        or (testmode1_enabled and resume_hp == "HP75"))
    self._za_mega_mode5_green_priority_checks_remaining=(
        (max(0, int(settings["INITIAL_GREEN_CHECK_COUNT"]))
         if settings is not None else 8)
        if z_guard_enabled and use_existing_resume else 0)
    direct_other_cover=bool(
        testmode1_enabled and resume_hp == "OTHER")
    self._za_mega_mode5_initial_phase_active=bool(
        (not testmode1_configured or testmode1_enabled)
        and not direct_other_cover)
    self._za_mega_mode5_initial_green_handled=False
    # OTHERは専用のMOVE_TO_COVERだけで進める。汎用の
    # 緑床判定／90度初期移動へのフォールスルーを防ぐ。
    self._za_mega_mode5_initial_approach_started=direct_other_cover
    self._za_mega_mode5_initial_approach_seconds=max(
        0.0, float(
            settings["INITIAL_NO_GREEN_MOVE_SECONDS"]
            if settings is not None else initial_approach_seconds))
    self._za_mega_mode5_initial_approach_angle=float(
        settings["INITIAL_NO_GREEN_MOVE_ANGLE"]
        if settings is not None else 90.0)
    self._za_mega_mode5_post_move_wait_until=0.0
    self._za_mega_mode5_lockon_confirmed_until=0.0
    self._za_mega_mode5_visual_lockon_until=0.0
    self._za_mega_mode5_color_field_until=0.0
    self._za_mega_colored_enemy_track_position=None
    self._za_mega_colored_enemy_track_seen_at=0.0
    self._za_mega_colored_enemy_candidate_position=None
    self._za_mega_colored_enemy_candidate_color=None
    self._za_mega_colored_enemy_candidate_pixels=0.0
    self._za_mega_colored_enemy_candidate_seen_at=0.0
    self._za_mega_colored_enemy_candidate_hits=0
    self._za_mega_mode5_battle_active=True
    self._za_mega_last_charge_state="IDLE"
    self._za_mega_last_charge_check_retry_at=0.0
    self._za_mega_last_charge_search_deadline=0.0
    self._za_mega_last_charge_cooldown_until=0.0
    self._za_mega_last_charge_skip_count=0
    self._za_mega_last_charge_attack_suspended=False

    self._za_mega_movemode_direction=None
    self._za_mega_movemode_direction_until=0.0
    self._za_mega_movemode_orbit_sign=1
    self._za_mega_movemode_orbit_until=0.0
    self._za_mega_movemode_searching=False
    self._za_mega_movemode_missing_move_retry_at=0.0
    self._za_mega_z_guard_active=False
    self._za_mega_z_guard_holding=False
    self._za_mega_z_guard_last_seen=0.0
    self._za_mega_z_guard_hold_until=0.0
    self._za_mega_z_guard_hold_until_disappears=False
    self._za_mega_z_guard_normal_hold_completed=False
    self._za_mega_z_guard_on_green_count=0
    self._za_mega_z_guard_skip_current_floor=False
    self._za_mega_z_guard_skip_last_seen=0.0
    self._za_mega_z_guard_direction=None
    self._za_mega_z_guard_direction_until=0.0
    if testmode1_configured and not testmode1_enabled:
        # FIELD再開だけでTESTMODE1の固定障害物移動を
        # やり直さない。緑床後は通常mode5、それ以外は
        # 直前の青／赤障害物phaseを維持する。
        resume_action=(
            "green-floor legacy latch; wait for BLACK_COMMENT/SELECT"
            if legacy_latched else
            "retain testmode1 phase without fixed cover replay")
        self.ZA_mega_mode5_transition(
            "FIELD_W_INPUT",
            "{} detected; {}".format(resume_reason, resume_action))
        self.ZA_mega_mode5_set_start_flag(
            3, resume_reason,
            "phase={}; {}".format(
                self._za_mega_testmode1_phase, resume_action))
        return
    if testmode1_enabled and resume_hp == "HP75":
        resume_phase="INITIAL_APPROACH"
        resume_action=(
            "FIELD resume; skip green check; move {:.0f}deg for {:.1f}s, "
            "then cover".format(
                self._za_mega_mode5_initial_approach_angle,
                self._za_mega_mode5_initial_approach_seconds))
    elif testmode1_enabled and resume_hp == "OTHER":
        resume_phase="BLUE_COVER_SEARCH"
        resume_action=(
            "FIELD resume; skip green/initial 90deg; move directly "
            "{:.0f}deg for {:.1f}s to cover".format(
                float(settings["OTHER_COVER_MOVE_ANGLE"]),
                float(settings["OTHER_COVER_MOVE_SECONDS"])))
    elif testmode1_enabled:
        resume_phase="HP_CLASSIFY"
        resume_action="FIELD resume; classify HP before fixed movement"
    else:
        resume_phase="GREEN_PRIORITY"
        resume_action="FIELD resume; existing green/fixed movement"
    self.ZA_mega_mode5_transition(
        resume_phase,
        "{} detected; testmode1 HP={} ratio={:.3f}".format(
            resume_reason, resume_hp, float(getattr(
                self, "_za_mega_testmode1_hp_fill_ratio", 0.0))))
    self.ZA_mega_mode5_set_start_flag(
        2, resume_reason, "resume HP={}; test phase={}; {}".format(
            resume_hp, self._za_mega_testmode1_phase, resume_action))
def ZA_mega_mode5_begin_post_move_wait(
        self, detection, wait_seconds=2.0):
    """開始移動後の待機を開始する。HP75試案中は視点も止める。"""
    now=time.monotonic()
    if float(getattr(
            self, "_za_mega_mode5_post_move_wait_until", 0.0)) <= 0.0:
        self._za_mega_mode5_post_move_wait_until=(
            now + max(0.0, float(wait_seconds)))
        self.ZA_mega_mode5_transition(
            "POST_MOVE_WAIT",
            "{}; wait {:.1f}s before FIELD_W input".format(
                detection, max(0.0, float(wait_seconds))))
        testmode1_hp75=bool(
            getattr(self, "_za_mega_testmode1_enabled", False)
            and getattr(
                self, "_za_mega_testmode1_resume_hp", "") == "HP75")
        self.ZA_mega_mode5_trace(
            detection,
            "wait after movement; {}".format(
                "testmode1 view stopped" if testmode1_hp75
                else "view rotation allowed"),
            force=True)

def ZA_mega_mode5_green_and_initial_update(
        self, dir1, dir2, dir3, dir4, see_r,
        field_resume_dir5_seconds):
    """緑床優先と、床がない場合の初期接近を処理する。

        Trueはこの周回を終了して画面を取り直す、Falseは攻撃へ進める状態。
        """
    testmode1_enabled=bool(getattr(
        self, "_za_mega_testmode1_enabled", False))
    settings=(self.ZA_mega_mode5_testmode1_settings()
              if testmode1_enabled else None)
    green_wait_seconds=float(
        settings["INITIAL_GREEN_WAIT_SECONDS"]
        if settings is not None else 2.5)
    green_check_seconds=float(
        settings["INITIAL_GREEN_CHECK_SECONDS"]
        if settings is not None else 1.0)
    post_move_wait_seconds=float(
        settings["INITIAL_POST_MOVE_WAIT_SECONDS"]
        if settings is not None else 2.0)
    if testmode1_enabled:
        testmode1_result=self.ZA_mega_mode5_testmode1_resume_update(
            dir1,dir2,dir3,dir4,see_r)
        if testmode1_result is not None:
            return bool(testmode1_result)

    post_move_wait_until=float(getattr(
        self, "_za_mega_mode5_post_move_wait_until", 0.0))
    yellow_retry_phase=bool(
        getattr(self, "_za_mega_mode5_initial_phase_active", False)
        or post_move_wait_until > 0.0)
    yellow_retry_remaining=int(getattr(
        self, "_za_mega_mode5_low_yellow_hp_checks_remaining", 0))
    if (yellow_retry_phase
            and not getattr(
                self, "_za_mega_mode5_low_yellow_hp_active", False)
            and yellow_retry_remaining > 0
            and time.monotonic() >= float(getattr(
                self, "_za_mega_mode5_low_yellow_hp_retry_at", 0.0))):
        yellow_retry_remaining-=1
        self._za_mega_mode5_low_yellow_hp_checks_remaining=(
            yellow_retry_remaining)
        yellow_low_hp=self.ZA_mega_mode5_low_yellow_hp()
        self._za_mega_mode5_low_yellow_hp_retry_at=(
            time.monotonic() + 0.25)
        if yellow_low_hp:
            self._za_mega_mode5_low_yellow_hp_active=True
            self._za_mega_mode5_low_yellow_hp_checks_remaining=0
            self._za_mega_mode5_low_yellow_hp_lock_seen=False
            self._za_mega_mode5_lockon_retreating=False
            print(
                "[MEGA_MODE5_HP] yellow low HP detected on retry "
                "ratio={:.3f}; enable lockon standoff".format(
                    float(getattr(
                        self,
                        "_za_mega_mode5_yellow_hp_fill_ratio",
                        0.0))))
        elif yellow_retry_remaining == 0:
            print(
                "[MEGA_MODE5_HP] yellow low HP not detected after "
                "resume retries; use normal movement")
    if post_move_wait_until > 0.0:
        now=time.monotonic()
        if now < post_move_wait_until:
            # 左スティックは初期移動の終了位置で止める。HP75の
            # TESTMODE1は青側障害物へ移るまで右視点も停止する。
            self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
            testmode1_hp75=bool(
                getattr(self, "_za_mega_testmode1_enabled", False)
                and getattr(
                    self, "_za_mega_testmode1_resume_hp", "") == "HP75")
            if testmode1_hp75:
                self.ZA_mega_mode5_marker_search_view_stop(relock=False)
                self.ZA_MOVE_SEE(action="END", in_see_r=see_r)
            else:
                self.ZA_mega_mode5_marker_search_view()
            self.wait(0.1)
            return True
        self._za_mega_mode5_post_move_wait_until=0.0
        self.ZA_mega_mode5_marker_search_view_stop(relock=False)
        finish_hp75=getattr(
            self, "ZA_mega_mode5_testmode1_finish_hp75_initial", None)
        if (callable(finish_hp75) and finish_hp75(
                "HP75_POST_MOVE_WAIT_COMPLETE")):
            return True
        self.ZA_mega_mode5_transition(
            "FIELD_W_INPUT", "post-movement wait complete")
        self.ZA_mega_mode5_set_start_flag(
            3, "POST_MOVE_WAIT_COMPLETE", "check FIELD_W and press up")
        return False

    z_guard_active=False
    initial_green_checks=max(0, int(getattr(
        self,
        "_za_mega_mode5_green_priority_checks_remaining",
        0)))
    if self._za_mega_z_guard_enabled and initial_green_checks > 0:
        # 1回の画像判定が重い環境で8回を一括実行すると、
        # 再開直後に数秒間棒立ちになる。緑床優先は維持しつつ、
        # この周回の初期確認は実時間1秒までにする。
        green_check_deadline=(
            time.monotonic() + max(0.0, green_check_seconds))
        for green_check_index in range(initial_green_checks):
            z_guard_active=self.ZA_mega_z_guard_update(
                dir1,dir2,dir3,dir4,
                wait_seconds=green_wait_seconds)
            remaining=int(getattr(
                self,
                "_za_mega_mode5_green_priority_checks_remaining",
                0))
            if remaining > 0:
                remaining=max(0, remaining - 1)
                self._za_mega_mode5_green_priority_checks_remaining=(
                    remaining)
                if remaining == 0:
                    print(
                        "[MEGA_GREEN_PRIORITY] checks complete; "
                        "allow target search")
            if z_guard_active:
                self.ZA_mega_mode5_trace(
                    "GREEN_FLOOR",
                    "hold" if getattr(
                        self, "_za_mega_z_guard_holding", False)
                    else "move to green floor")
                self.ZA_mega_mode5_transition(
                    "GREEN_HOLD" if getattr(
                        self, "_za_mega_z_guard_holding", False)
                    else "GREEN_MOVE",
                    "green floor controls movement")
                break
            if time.monotonic() >= green_check_deadline:
                self._za_mega_mode5_green_priority_checks_remaining=0
                print(
                    "[MEGA_GREEN_PRIORITY] {:.1f}s check budget complete; "
                    "start initial movement".format(
                        max(0.0, green_check_seconds)))
                break
            if green_check_index + 1 < initial_green_checks:
                self.wait(0.1)

        if getattr(
                self, "_za_mega_mode5_initial_phase_active", False):
            green_processed=bool(
                z_guard_active
                or getattr(self, "_za_mega_z_guard_holding", False)
                or getattr(
                    self, "_za_mega_z_guard_skip_current_floor", False))
            if green_processed:
                self._za_mega_mode5_initial_green_handled=True
                self._za_mega_field_dir5_until=0.0
                self._za_mega_mode5_view_search_block_until=0.0
            if (getattr(
                    self, "_za_mega_mode5_initial_green_handled", False)
                    and not z_guard_active):
                self._za_mega_mode5_initial_phase_active=False
                self._za_mega_mode5_green_priority_checks_remaining=0
                if getattr(
                        self,
                        "_za_mega_z_guard_normal_hold_completed",
                        False):
                    # 緑床移動後は設定時間だけZ_Guard内で待機済み。
                    # さらに移動後待機を足さず、FIELD_W確認へ進む。
                    finish_hp75=getattr(
                        self,
                        "ZA_mega_mode5_testmode1_finish_hp75_initial",
                        None)
                    if (callable(finish_hp75) and finish_hp75(
                            "HP75_GREEN_FLOOR_WAIT_COMPLETE")):
                        return True
                    else:
                        self.ZA_mega_mode5_transition(
                            "FIELD_W_INPUT",
                            "green-floor {:.1f}s wait complete".format(
                                green_wait_seconds))
                        self.ZA_mega_mode5_set_start_flag(
                            3, "GREEN_FLOOR_WAIT_COMPLETE",
                            "check FIELD_W and press up")
                else:
                    self.ZA_mega_mode5_begin_post_move_wait(
                        "GREEN_FLOOR_COMPLETE",
                        wait_seconds=post_move_wait_seconds)
        if z_guard_active:
            self.wait(0.1)
            return True
        if float(getattr(
                self, "_za_mega_mode5_post_move_wait_until", 0.0)) > 0.0:
            return True

    if (getattr(self, "_za_mega_mode5_initial_phase_active", False)
            and not getattr(
                self, "_za_mega_mode5_initial_green_handled", False)
            and not getattr(
                self, "_za_mega_mode5_initial_approach_started", False)):
        approach_seconds=max(0.0, float(getattr(
            self,
            "_za_mega_mode5_initial_approach_seconds",
            field_resume_dir5_seconds)))
        approach_angle=float(getattr(
            self, "_za_mega_mode5_initial_approach_angle",
            getattr(self, "_za_mega_dir5", 90)))
        self._za_mega_mode5_initial_approach_started=True
        self._za_mega_field_dir5_until=(
            time.monotonic() + approach_seconds)
        self._za_mega_mode5_view_search_block_until=(
            self._za_mega_field_dir5_until)
        self.ZA_mega_mode5_transition(
            "INITIAL_APPROACH",
            "no green floor; move {:.0f}deg for {:.1f}s".format(
                approach_angle, approach_seconds))
        # 有限入力として完了させ、重い画像判定中に壁へ押し続けない。
        self.ZA_MOVE_LStick(dir1,dir2,dir3,dir4,1,"END")
        self.ZA_MOVE_SEE(action="END", in_see_r=see_r)
        # 初期接近はロックオン横移動で減速させず、最大強度で進む。
        self.ZA_ZL_ACTION("END")
        self.press(
            Direction(
                Stick.LEFT,
                approach_angle,
                1.0),
            duration=approach_seconds,
            wait=0.0)
        self._za_mega_field_dir5_until=0.0
        self._za_mega_mode5_initial_phase_active=False
        self._za_mega_mode5_green_priority_checks_remaining=0
        self._za_mega_mode5_view_search_block_until=0.0
        self.ZA_mega_mode5_begin_post_move_wait(
            "FIXED_{:.0f}DEG_MOVE_COMPLETE".format(
                approach_angle),
            wait_seconds=post_move_wait_seconds)
        return True
    elif (not getattr(
            self, "_za_mega_mode5_initial_phase_active", False)
            and getattr(self, "_za_mega_mode5_phase", "")
            in {"GREEN_MOVE", "GREEN_HOLD"}):
        self.ZA_mega_mode5_begin_post_move_wait(
            "GREEN_FLOOR_COMPLETE",
            wait_seconds=post_move_wait_seconds)
        return True
    return False

def ZA_mega_a_attack_ready(self, choice_guard_checked=False):
    """C+画像を取れない時も、安全な戦闘FIELDならA攻撃を許可する。"""
    if getattr(self, "_za_mega_last_battle_mode", False):
        return self.ZA_mega_mode5_a_attack_ready(
            choice_guard_checked=choice_guard_checked)
    if self.ZA_mega_attack_ready():
        return True
    # 通常MEGA戦ではC+画像欠落時のフォールバックをAだけへ限定する。
    # B/X/YまでFIELDだけで送ると、非ロックオン時の回避入力になり得る。
    if (choice_guard_checked
            or not self.ZA_mega_choice_input_guard()):
        if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK"):
            print("[MEGA_A] C+ missed; use FIELD-confirmed A fallback")
            return True
    return False
