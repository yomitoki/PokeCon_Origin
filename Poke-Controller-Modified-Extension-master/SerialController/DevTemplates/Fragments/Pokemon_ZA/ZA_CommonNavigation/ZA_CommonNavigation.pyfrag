def ZA_Common_start(self):
    #dummy
    return "COMMON_MAP_OPEN"
def ZA_Common_map_open(
        self, check_pic1="POKEMON_ZA_FALSE_RETURN",
        check_pic2="POKEMON_ZA_FALSE_RETURN",
        othermap="POKEMON_ZA_FALSE_RETURN", use_text_box2=True):
    self.map_cursor_reset=0
    self.ZA_ZL_ACTION("END")
    self.wait(0.1)#self.wait(self.SLEEPLIST[8][2])
    # 想定外の話しかけ用
    if self.image_check("POKEMON_ZA_TEXT_BOX"):
        self.pressRep(Button.B, repeat=5, duration=0.15, wait=0.01, interval=0.1)
        self.wait(0.1)
    if use_text_box2 and self.image_check("POKEMON_ZA_TEXT_BOX2"):
        self.pressRep(Button.A, repeat=5, duration=0.15, wait=0.01, interval=0.1)
        self.wait(0.1)         
    elif self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK") or self.image_check("POKEMON_ZA_DEAD") or self.image_check(check_pic1) or self.image_check(check_pic2): #FIELDから変更
        self.pressRep(Button.PLUS, repeat=1, duration=0.15, wait=0.3, interval=0.1)
        self.wait(0.1)
        return "COMMON_GOTO_SELECT1"
    # ステップ遷移ミス用
    elif self.image_check("POKEMON_ZA_MAP"):
        return "COMMON_GOTO_SELECT1"
    elif self.image_check("POKEMON_ZA_MAP2") or self.image_check(othermap):
        return "COMMON_GOTO_SELECT1"
    #elif self.image_check("MORNING"):  
    #    return "CHECK_TIME"
    #elif self.image_check("NIGHT"):
    #    return "CHECK_TIME"

    return "COMMON_MAP_OPEN"
def ZA_Common_goto_select1(self,position,othermap="POKEMON_ZA_FALSE_RETURN",select_position0_direct=0):
    if getattr(getattr(getattr(self, "_native_image_collection", None), "options", None), "supplemental", False):
        result = self.ZA_story_supplemental_filter(position, "COMMON_GOTO_SELECT1", "COMMON_GOTO_SELECT2", othermap)
        if result is not None:
            return result
    # position:0 すべて
    # position:1 施設
    # position:2 ポケセン
    # position:3 カフェ
    # position:4 ゾーン
    # position:5 やめる
    self.wait(0.1)#self.wait(self.SLEEPLIST[7][2])
    if self.image_check("POKEMON_ZA_MAP2") or self.image_check(othermap):      
        self.wait(0.1)
        if self.image_check("POKEMON_ZA_MOVESPOT_TAB"):
            # position=0（すべて）はマップの種類にかかわらず、左タブの
            # リセット移動を行わず、MINUSでフィルターを開いて現在の
            # 0番目をそのままAで選択する。select_position0_directは
            # 旧生成ソースとの呼出し互換のため引数として残す。
            if position == 0:
                # フィルターを開いた後も背景側のTAB_FILTERが一致する
                # 場合があるため、開いた状態を先に判定する。
                if self.image_check("POKEMON_ZA_SELECT_ALL"):
                    print(
                        "[COMMON_GOTO_SELECT1] position=0 "
                        "action=A filter=SELECT_ALL")
                    self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.3, interval=0.1)
                    return "COMMON_GOTO_SELECT2"

                # TAB_FILTERの画像を取りこぼしても、MOVESPOT_TAB上で
                # SELECT_ALLが未表示なら必ずMINUSを送る。直前のMINUSが
                # 遅れて反映される場合に備え、入力直前にもう一度だけ
                # 開いた状態を確認する。
                self.wait(0.3)
                if self.image_check("POKEMON_ZA_SELECT_ALL"):
                    print(
                        "[COMMON_GOTO_SELECT1] position=0 "
                        "action=A filter=SELECT_ALL delayed")
                    self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.3, interval=0.1)
                    return "COMMON_GOTO_SELECT2"
                print(
                    "[COMMON_GOTO_SELECT1] position=0 "
                    "action=MINUS filter=SELECT_ALL_not_visible")
                self.pressRep(Button.MINUS, repeat=1, duration=0.2, wait=0.5, interval=0.1)
            elif self.map_cursor_reset==0:
                if self.image_check("POKEMON_ZA_SIDE_SELECT_TOP_MAP"):
                    self.map_cursor_reset=1
                else:
                    self.etc_sendCommand("Lbutton_left")
                self.wait(0.5)
                return "COMMON_GOTO_SELECT1"
            else:
                # 開いたフィルターでも背景側のTAB_FILTERが一致するため、
                # SELECT_ALLを先に処理しないとMINUSで閉じ直してしまう。
                if self.image_check("POKEMON_ZA_SELECT_ALL"):
                    # SELECT
                    for i in range(position):
                        self.etc_sendCommand("Lbutton_down")
                        #self.wait(0.1)#回数が多い場合に移動が足りない場合は必要

                    self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.01, interval=0.1)
                    return "COMMON_GOTO_SELECT2"
                elif self.image_check("POKEMON_ZA_TAB_FILTER"):
                    self.pressRep(Button.MINUS, repeat=1, duration=0.15, wait=0.01, interval=0.1)
        else:
                self.pressRep(Button.Y, repeat=1, duration=0.15, wait=0.1, interval=0.1)
    
    # ステップ遷移ミス用
    #elif self.image_check("MORNING"):  
    #    return "CHECK_TIME"
    #elif self.image_check("NIGHT"):
    #    return "CHECK_TIME"
    elif self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK") or self.image_check("POKEMON_ZA_DEAD"): #FIELDから変更
        for i in range(5):
            if self.image_check("POKEMON_ZA_MAP2") or self.image_check(othermap):
                return "COMMON_GOTO_SELECT1"
            self.wait(0.1)
        print("W_select1")
        self.pressRep(Button.PLUS, repeat=1, duration=0.15, wait=0.3, interval=0.1)
        self.wait(0.1)
        return "COMMON_GOTO_SELECT1"
    elif not self.image_check("POKEMON_ZA_MAP2"):
        # マップ開きミス用
        for i in range(5):
            if self.image_check("POKEMON_ZA_MAP2"):
                return "COMMON_GOTO_SELECT1"
            self.wait(0.1)
        self.pressRep(Button.PLUS, repeat=1, duration=0.15, wait=0.3, interval=0.1)
        self.wait(0.1)
        return "COMMON_GOTO_SELECT1"
    return "COMMON_GOTO_SELECT1"
def ZA_Common_goto_select2(
        self, positionright, positiondown, movepoint_check,
        othermap="POKEMON_ZA_FALSE_RETURN",
        battle_recovery_mode=0,
        force_filter_navigation=False):
    self.wait(0.1)#self.wait(self.SLEEPLIST[7][2])
    if self.image_check("POKEMON_ZA_MAP2") or self.image_check(othermap):        
        if self.image_check("POKEMON_ZA_MOVESPOT_TAB"):         
            # フィルター確定直後はTAB_FILTERを一時的に取りこぼすことが
            # ある。SELECT1完了済みの専用経路では明示的に移動する。
            if (force_filter_navigation
                    or self.image_check("POKEMON_ZA_TAB_FILTER")):
                # FILTER
                for i in range(positionright):
                    self.etc_sendCommand("Lbutton_right")
                    self.wait(0.1)#回数が多い場合に移動が足りない場合は必要
                if positiondown > -1:
                    for i in range(positiondown):
                        self.etc_sendCommand("Lbutton_down")
                        self.wait(0.1)#回数が多い場合に移動が足りない場合は必要
                else:
                    for i in range(positiondown*-1):
                        self.etc_sendCommand("Lbutton_up")
                        self.wait(0.1)#回数が多い場合に移動が足りない場合は必要
                if movepoint_check == 0:
                    ret = self.ZA_Common_goto_jump(
                        othermap=othermap,
                        battle_recovery_mode=battle_recovery_mode)#移動
                    return ret
                else:
                    return "COMMON_GOTO_JUMP"
                    
    return "COMMON_GOTO_SELECT2"
def _ZA_furadari_screen_is_dark(self, log_detection=True):
    """Return True for a sustained dark view or unavailable live input."""
    missing_frames = 0
    brightness = None
    dark_ratio = None
    for sample_index in range(3):
        frame = self._read_camera_frame()
        if frame is None:
            missing_frames += 1
        else:
            try:
                height, width = frame.shape[:2]
                # HUDや黒帯の影響を避け、実際の正面視界だけを確認する。
                region = frame[
                    max(0, int(height * 0.10)):max(1, int(height * 0.85)),
                    max(0, int(width * 0.10)):max(1, int(width * 0.90)),
                ]
                if region.size == 0:
                    return False
                if len(region.shape) >= 3:
                    gray = cv2.cvtColor(region, cv2.COLOR_BGR2GRAY)
                else:
                    gray = region
                brightness = float(gray.mean())
                dark_ratio = float((gray <= 32).mean())
            except (AttributeError, TypeError, ValueError, cv2.error):
                return False
            # Window側の暗転安全監視（brightness <= 28）と判定を
            # 揃える。正面視界にはHUDが重なるため黒画素率は80%以上。
            if brightness > 28.0 or dark_ratio < 0.80:
                return False
        if sample_index < 2:
            self.wait(0.1)

    if missing_frames == 3:
        self._za_furadari_dark_detection_reason = "camera_stalled"
        message = (
            "[FURADARI_MAP_DARK_RECOVERY] live camera frame "
            "unavailable for 3 checks; start bounded B/FIELD recovery")
    else:
        self._za_furadari_dark_detection_reason = "dark"
        message = (
            "[FURADARI_MAP_DARK_RECOVERY] sustained dark view detected "
            "brightness={:.2f} dark_ratio={:.3f} missing_frames={}".format(
                brightness, dark_ratio, missing_frames))
    if log_detection:
        print(message)
        logger = getattr(self, "_logger", None)
        log_method = getattr(logger, "warning", None)
        if callable(log_method):
            log_method(message)
    return True

def ZA_Common_goto_jump(
        self, othermap="POKEMON_ZA_FALSE_RETURN",
        battle_recovery_mode=0, require_confirmation=False):
    self.wait(0.1)#self.wait(self.SLEEPLIST[7][2])

    self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.1, interval=0.1)
    furadari_battle_recovery = (
        battle_recovery_mode == 1
        and othermap == "POKEMON_ZA_FURADARI_MAP")

    def start_furadari_battle_recovery(reason, recovery_kind="battle"):
        self.inactioncount += 1
        self.pressRep(
            Button.B, repeat=1, duration=0.15,
            wait=0.1, interval=0.1)
        self._za_furadari_map_recovery_kind = recovery_kind
        self._za_furadari_map_b_count = 1
        self._za_furadari_map_b_limit_logged = False
        self._za_furadari_map_field_started = False
        self._za_furadari_map_view_active = False
        self._za_furadari_map_eye_seen = False
        self._za_furadari_map_eye_acquire_count = 0
        self._za_furadari_map_eye_miss_count = 0
        self._za_furadari_dark_recovery_phase = "ALTERNATE_GOTO"
        self._za_furadari_dark_map_state = "COMMON_MAP_OPEN"
        self._za_furadari_dark_in_miss_count = 0
        self._za_furadari_dark_entry_a_count = 0
        print(
            "[FURADARI_MAP_RECOVERY] "
            "{} mode=1 kind={} -> press B up to 30 until FIELD".format(
                reason, recovery_kind))
        return "COMMON_FURADARI_MAP_BATTLE_RECOVERY"

    supplemental_mode = getattr(getattr(getattr(self, "_native_image_collection", None), "options", None), "supplemental", False)
    if supplemental_mode:
        if self.ZA_story_map_confirmation_ready():
            self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.1, interval=0.1)
            self.sleepcount = 0
            self._za_common_goto_retry_pending = False
            return "COMMON_CHANGE_TIME"
        require_confirmation = True
    for i in ([] if supplemental_mode else range(1,10)):
        self.wait(0.1)#self.wait(self.SLEEPLIST[10][2])
        # バトル警告は通常の移動確認と似ているため、補助モード1では
        # 先に判定しないと通常移動成功として次Stepへ進む場合がある。
        if (furadari_battle_recovery
                and self.image_check("POKEMON_ZA_MOVE_COMMENT_BATTLE")):
            return start_furadari_battle_recovery(
                "battle warning detected")

        # 通常gotoも警告を先に確認する。通常確認との重複一致で
        # 移動成功にしない。Bは復帰処理で画面を見ながら1回ずつ送る。
        if (not furadari_battle_recovery
                and self.image_check("POKEMON_ZA_MOVE_COMMENT_BATTLE")):
            self.inactioncount += 1
            self.battle_step_return = 1
            # movepoint確認後の直接呼出しは従来のB回数を維持する。
            # 復帰処理の上限にも、この入力回数を含める。
            direct_b_count = (
                10 if getattr(self, "Common_current_state", None)
                == "COMMON_START" else 0)
            if direct_b_count:
                self.pressRep(
                    Button.B, repeat=direct_b_count, duration=0.15,
                    wait=0.1, interval=0.1)
            self._za_common_goto_retry_pending = True
            self._za_common_goto_recovery = {
                "b_count": direct_b_count, "clear_count": 0}
            return "COMMON_BATTLE_RETURN"

        if self.image_check("POKEMON_ZA_MOVE_COMMENT"): 
            self.pressRep(Button.A, repeat=15, duration=0.15, wait=0.1, interval=0.1)
            self.sleepcount=0
            if not furadari_battle_recovery:
                self._za_common_goto_retry_pending = False
            return "COMMON_CHANGE_TIME"

        elif i == 1:
            if self.image_check("POKEMON_ZA_MOVE_COMMENT"): 
                self.pressRep(Button.A, repeat=15, duration=0.15, wait=0.1, interval=0.1)
                self.sleepcount=0
                if not furadari_battle_recovery:
                    self._za_common_goto_retry_pending = False
                return "COMMON_CHANGE_TIME"
            self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.2, interval=0.1)
    print("MOVE_COM_ELSE")
    if furadari_battle_recovery:
        # 実録画では両方の移動確認を取り逃がし、従来のA5回から
        # COMMON_CHANGE_TIMEへ進んでGURI_92へ抜けていた。補助モード1
        # のタイムアウトはFIELD復帰・戦闘経路へ必ず引き渡す。
        if self._ZA_furadari_screen_is_dark():
            return start_furadari_battle_recovery(
                "dark view after move confirmation timeout",
                recovery_kind="dark")
        return start_furadari_battle_recovery(
            "move confirmation timed out")
    if (self.battlecheck == 1 or require_confirmation
            or getattr(self, "_za_common_goto_retry_pending", False)):
        self.inactioncount+=1
        self.battle_step_return=1
        direct_b_count = (
            20 if (self.battlecheck == 1
                   and getattr(self, "Common_current_state", None)
                   == "COMMON_START") else 0)
        if direct_b_count:
            self.pressRep(
                Button.B, repeat=direct_b_count, duration=0.15,
                wait=0.1, interval=0.1)
        self._za_common_goto_retry_pending = True
        self._za_common_goto_recovery = {
            "b_count": direct_b_count, "clear_count": 0}
        return "COMMON_BATTLE_RETURN"
    self.sleepcount=0
    self.pressRep(Button.A, repeat=5, duration=0.15, wait=0.1, interval=0.1)
    return "COMMON_CHANGE_TIME"
def ZA_Common_furadari_map_dark_recovery(self):
    """Reset a dark FURADARI view through a safe alternate travel spot."""
    recovery_state = "COMMON_FURADARI_MAP_BATTLE_RECOVERY"
    othermap = "POKEMON_ZA_FURADARI_MAP"
    field_picture = "POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK_0"
    phase = getattr(
        self, "_za_furadari_dark_recovery_phase", "ALTERNATE_GOTO")

    if phase == "ALTERNATE_GOTO":
        common_state = getattr(
            self, "_za_furadari_dark_map_state", "COMMON_MAP_OPEN")
        if common_state == "COMMON_MAP_OPEN":
            next_state = self.ZA_Common_map_open(othermap=othermap)
        elif common_state == "COMMON_GOTO_SELECT1":
            # MINUSのフィルターで「すべて」から下へ1つ移動する。
            next_state = self.ZA_Common_goto_select1(
                1, othermap=othermap)
        elif common_state == "COMMON_GOTO_SELECT2":
            # 退避スポットは現在位置から右1・下1。
            next_state = self.ZA_Common_goto_select2(
                1, 1, 0, othermap=othermap,
                battle_recovery_mode=0)
        elif common_state in {
                "COMMON_CHANGE_TIME", "COMMON_CHECK_TIME"}:
            next_state = common_state
        else:
            next_state = self.STATE_COMMON_FUNCTION[common_state]()
        self._za_furadari_dark_map_state = next_state
        if next_state in {"COMMON_CHANGE_TIME", "COMMON_CHECK_TIME"}:
            self._za_furadari_dark_recovery_phase = "APPROACH_ENTRY"
            self._za_furadari_dark_map_state = "COMMON_START"
            print(
                "[FURADARI_MAP_DARK_RECOVERY] alternate goto complete "
                "filter_down=1 spot_right=1 spot_down=1")
        return recovery_state

    if phase == "APPROACH_ENTRY":
        if not self.image_check(field_picture):
            self.wait(0.1)
            return recovery_state
        self.press(
            Direction(Stick.LEFT, 90), duration=0.5, wait=0.1)
        self._za_furadari_dark_recovery_phase = "WAIT_ENTRY_ICON"
        self._za_furadari_dark_in_miss_count = 0
        print(
            "[FURADARI_MAP_DARK_RECOVERY] FIELD -> move 90deg 0.5s; "
            "wait for IN_ICON")
        return recovery_state

    if phase == "WAIT_ENTRY_ICON":
        if (self.image_check(field_picture)
                and self.image_check("POKEMON_ZA_IN_ICON")
                and self.ZA_story_wait_movement_a(("POKEMON_ZA_IN_MARKER",), timeout=3.0)):
            self.pressRep(
                Button.A, repeat=1, duration=0.15,
                wait=0.5, interval=0.1)
            self._za_furadari_dark_entry_a_count = 1
            self._za_furadari_dark_recovery_phase = "WAIT_ENTRY_FIELD"
            print(
                "[FURADARI_MAP_DARK_RECOVERY] IN_ICON -> A; "
                "wait for destination FIELD")
            return recovery_state
        miss_count = int(getattr(
            self, "_za_furadari_dark_in_miss_count", 0)) + 1
        self._za_furadari_dark_in_miss_count = miss_count
        if miss_count >= 30:
            # 入口を外した場合は歩き続けず、退避スポットからやり直す。
            self._za_furadari_dark_recovery_phase = "ALTERNATE_GOTO"
            self._za_furadari_dark_map_state = "COMMON_MAP_OPEN"
            self._za_furadari_dark_in_miss_count = 0
            self.map_cursor_reset = 0
            print(
                "[FURADARI_MAP_DARK_RECOVERY] IN_ICON not found "
                "after 30 checks -> retry alternate goto")
        self.wait(0.1)
        return recovery_state

    # Aがロード前に取りこぼされた場合はIN_ICONが残っている間だけ再送する。
    if (self.image_check(field_picture)
            and self.image_check("POKEMON_ZA_IN_ICON")):
        entry_a_count = int(getattr(
            self, "_za_furadari_dark_entry_a_count", 0))
        if (entry_a_count < 10
                and self.ZA_story_wait_movement_a(("POKEMON_ZA_IN_MARKER",), timeout=3.0)):
            self.pressRep(
                Button.A, repeat=1, duration=0.15,
                wait=0.5, interval=0.1)
            self._za_furadari_dark_entry_a_count = entry_a_count + 1
        return recovery_state
    if not self.image_check(field_picture):
        self.wait(0.1)
        return recovery_state

    self.press(Direction(Stick.LEFT, 90), duration=1.5, wait=0.1)
    self._za_furadari_map_recovery_kind = ""
    self._za_furadari_map_b_count = 0
    self._za_furadari_map_field_started = False
    self._za_furadari_dark_recovery_phase = "ALTERNATE_GOTO"
    self._za_furadari_dark_map_state = "COMMON_MAP_OPEN"
    self._za_furadari_dark_in_miss_count = 0
    self._za_furadari_dark_entry_a_count = 0
    self.inactioncount = 0
    self.battlecheck = 0
    self.battle_step_return = 0
    self.map_cursor_reset = 0
    print(
        "[FURADARI_MAP_DARK_RECOVERY] destination FIELD -> "
        "move 90deg 1.5s; retry last POKEMON_ZA_FURADARI_MAP goto")
    return "COMMON_MAP_OPEN"

def ZA_Common_furadari_map_battle_recovery(self):
    recovery_state = "COMMON_FURADARI_MAP_BATTLE_RECOVERY"
    self.checkIfAlive()

    # 警告／マップ画面では攻撃せず、FIELDが出るまでBを送る。
    # 1回目はZA_Common_goto_jump側で送信済み。合計30回を上限にする。
    b_count = int(getattr(self, "_za_furadari_map_b_count", 0))
    if not getattr(self, "_za_furadari_map_field_started", False):
        field_picture = "POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK_0"
        field_visible = self.image_check(field_picture)
        while not field_visible and b_count < 30:
            self.checkIfAlive()
            self.pressRep(
                Button.B, repeat=1, duration=0.15,
                wait=0.1, interval=0.1)
            b_count += 1
            self._za_furadari_map_b_count = b_count
            field_visible = self.image_check(field_picture)

        if not field_visible:
            if not getattr(
                    self, "_za_furadari_map_b_limit_logged", False):
                print(
                    "[FURADARI_MAP_RECOVERY] "
                    "FIELD not detected after B x30; "
                    "wait without input")
                self._za_furadari_map_b_limit_logged = True
            self._za_furadari_map_eye_miss_count = 0
            self.wait(0.1)
            return recovery_state

        self._za_furadari_map_field_started = True
        self._za_furadari_map_b_limit_logged = False
        self._za_furadari_map_eye_seen = False
        self._za_furadari_map_eye_acquire_count = 0
        self._za_furadari_map_eye_miss_count = 0
        print(
            "[FURADARI_MAP_RECOVERY] "
            "FIELD restored after B count={} -> "
            "{}".format(
                b_count,
                "run dark-view reset route"
                if getattr(
                    self, "_za_furadari_map_recovery_kind", "battle")
                == "dark" else "rotate, lock on and attack"))

    if getattr(
            self, "_za_furadari_map_recovery_kind", "battle") == "dark":
        return self.ZA_Common_furadari_map_dark_recovery()

    # バトル中の選択位置が下へ動いている場合は、攻撃より先に上へ
    # 戻す。生コマンドで保持入力が解除されるため、視点・ZLより前に
    # 送り、この周期内でロックオンと保持移動を改めて設定する。
    if self.image_check("POKEMON_ZA_FIELD_W"):
        self.etc_sendCommand("Lbutton_up")
        print(
            "[FURADARI_MAP_RECOVERY] FIELD_W detected -> Lbutton_up")

    # no_Cplus等の通常戦闘設定に抑止されない専用の視点回転。
    # 右スティック180度・押し幅0.6をEYE解決まで保持する。
    if not getattr(self, "_za_furadari_map_view_active", False):
        if getattr(self, "Rstick_state", 0) == 1:
            self.holdEnd(Direction(Stick.RIGHT, 180))
            self.wait(0.1)
        self.hold(Direction(Stick.RIGHT, 180, 0.6))
        self.Rstick_state = 1
        self._za_furadari_map_view_active = True
    self.ZA_ZL_ACTION("")

    eye_visible = (
        self.image_check("POKEMON_ZA_EYE_CHECK_HIGH")
        or self.image_check("POKEMON_ZA_EYE_CHECK"))
    eye_seen = bool(getattr(
        self, "_za_furadari_map_eye_seen", False))
    if eye_visible:
        eye_seen = True
        self._za_furadari_map_eye_seen = True
        self._za_furadari_map_eye_acquire_count = 0
        self._za_furadari_map_eye_miss_count = 0
    elif eye_seen:
        self._za_furadari_map_eye_miss_count = int(getattr(
            self, "_za_furadari_map_eye_miss_count", 0)) + 1
    else:
        self._za_furadari_map_eye_acquire_count = int(getattr(
            self, "_za_furadari_map_eye_acquire_count", 0)) + 1

    marker_direction = self.ZA_infi_target_marker_direction()
    if marker_direction:
        self.hold(marker_direction)
    try:
        # 一度見えたEYEが消えた後は追加攻撃せず、連続消失だけを確認する。
        if ((eye_visible or not eye_seen)
                and self.ZA_infi_attack_ready()):
            # C+が表示中の技だけを、ロックオン側へ
            # 移動を保持したまま順に入力する。Y回避は行わない。
            for button in (Button.X, Button.A, Button.B):
                self.pressRep(
                    button, repeat=1, duration=0.04,
                    wait=0.0, interval=0.1)
    finally:
        if marker_direction:
            self.holdEnd(marker_direction)
    self.wait(0.1)

    if eye_visible:
        return recovery_state
    if eye_seen:
        if self._za_furadari_map_eye_miss_count < 3:
            return recovery_state
        completion_reason = "eye_cleared"
    else:
        # FIELD復帰直後の未検知だけで終了せず、視点回転と攻撃を
        # 10周期行っても一度もEYEが見えない場合に限り再試行する。
        if self._za_furadari_map_eye_acquire_count < 10:
            return recovery_state
        completion_reason = "eye_not_acquired_after_grace"

    if getattr(self, "_za_furadari_map_view_active", False):
        self.holdEnd(Direction(Stick.RIGHT, 180))
        self.Rstick_state = 0
        self._za_furadari_map_view_active = False
    self.ZA_ZL_ACTION("END")
    self._za_furadari_map_b_count = 0
    self._za_furadari_map_field_started = False
    self._za_furadari_map_eye_seen = False
    self._za_furadari_map_eye_acquire_count = 0
    self._za_furadari_map_eye_miss_count = 0
    self.inactioncount = 0
    self.battlecheck = 0
    self.battle_step_return = 0
    self.map_cursor_reset = 0
    print(
        "[FURADARI_MAP_RECOVERY] {} -> retry goto "
        "POKEMON_ZA_FURADARI_MAP".format(completion_reason))
    return "COMMON_MAP_OPEN"
def ZA_Common_change_time(self):
    recover=getattr(self,"ZA_story_movement_a_local_recovery",None)
    if callable(recover):
        recovered=recover(('ZA_Benchi',),'COMMON_MAP_OPEN')
        if recovered is not None:
            return recovered

    if self.ZA_story_movement_a_pending("ZA_Benchi"):
        if self.ZA_Benchi() is False:
            return "COMMON_CHANGE_TIME"
        return "COMMON_CHECK_TIME"

    #マップコメントの捕捉失敗用
    #if self.image_check("ESCAPE"):
    #    self.battlecheck=1
    #    return "GOTO_SELECT1"

    #ポケモンセンター用
    #elif self.image_check("DEAD"):
    #    self.press(Direction(Stick.LEFT, 90), duration=2.0, wait=0.1)
    #    self.pressRep(Button.A, repeat=10, duration=0.15, wait=0.2, interval=0.1)
    #    self.pressRep(Button.B, repeat=50, duration=0.15, wait=0.2, interval=0.1)
    #    if self.chicketmaxflag == 1:
    #        self.chicketmaxflag = 2
    #        return "QUASAR_MAP_OPEN"
    #    else:
    #        return "BENCH_MAP_OPEN"
    #el
    if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK"): #FIELDから変更
        if self.ZA_Benchi() is False:
            return "COMMON_CHANGE_TIME"
        return "COMMON_CHECK_TIME"

    else:
        self.etc_sendCommand("Lbutton_left")
        self.wait(0.1)#self.wait(self.SLEEPLIST[0][2])
    return "COMMON_CHANGE_TIME"
def ZA_Common_check_time(self,check_timing):

    # (時間切り替わりの補足ができない？その場合は朝扱いで一度抜ける(夜だった場合再度、朝・夜の切り替えを行う))
    #必ずMORNING、NIGHT判定できる時間以上のカウント数にしてください。

    if self.image_check("POKEMON_ZA_MORNING") or (check_timing != "POKEMON_ZA_MORNING" and self.timecount > 200):
        print("朝")
        self.timecount=0
        while True:
            self.checkIfAlive()
            recovery_deadline = getattr(
                self, "_za_story_timechange_recovery_deadline", None)
            if (recovery_deadline is not None
                    and time.monotonic() >= float(recovery_deadline)):
                # Return to the shared pre-action handler for its cleanup/failure.
                return "COMMON_CHECK_TIME"
            #ジャスティス会への話しかけが発生する可能性があるので、ループしてしまう場合はBボタンが必要になる場合がある                
            self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.5, interval=0.1)
            if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK_1") or self.image_check("POKEMON_ZA_DEAD"): #FIELDから変更
                self.timecount=0
                self.changetimecount+=1
                if check_timing not in (
                        "POKEMON_ZA_MORNING", "POKEMON_ZA_OTHER"):
                    self.sleepcount=1
                    return "COMMON_CHANGE_TIME"
                else:
                    return "COMMON_START"

    elif self.image_check("POKEMON_ZA_NIGHT") or (check_timing != "POKEMON_ZA_NIGHT" and self.timecount > 200):
        #1ループの戦闘中移動失敗カウンタの初期化
        self.inactioncount=0
        print("夜")
        while True:
            self.checkIfAlive()
            recovery_deadline = getattr(
                self, "_za_story_timechange_recovery_deadline", None)
            if (recovery_deadline is not None
                    and time.monotonic() >= float(recovery_deadline)):
                # Return to the shared pre-action handler for its cleanup/failure.
                return "COMMON_CHECK_TIME"
            #ジャスティス会への話しかけが発生する可能性があるので、ループしてしまう場合はBボタンが必要になる場合がある       
            self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.5, interval=0.1)
            if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK_1") or self.image_check("POKEMON_ZA_DEAD"): #FIELDから変更
                self.timecount=0
                self.changetimecount+=1
                if check_timing not in (
                        "POKEMON_ZA_NIGHT", "POKEMON_ZA_OTHER"):
                    self.sleepcount=1
                    return "COMMON_CHANGE_TIME"
                else:
                    return "COMMON_START"

    self.wait(0.1)#self.wait(self.SLEEPLIST[6][2])
    #抜けミス用カウント
    self.timecount+=1
    return "COMMON_CHECK_TIME"
def ZA_Common_change_time_set(
        self, check_timing,
        check_pic1="POKEMON_ZA_FALSE_RETURN",
        check_pic2="POKEMON_ZA_FALSE_RETURN", use_text_box2=True):
    #type=0:ポケセンブルーにて実施(バトルゾーンに影響あり)
    if self.Common_current_state == "COMMON_CHECK_TIME":  
        self.Common_current_state = self.ZA_Common_check_time(check_timing)
    elif self.Common_current_state == "COMMON_CHANGE_TIME":  
        self.Common_current_state = self.ZA_Common_change_time()
    else:
        ret = self.ZA_Common_goto(
            2, 0, 1, check_pic1=check_pic1, check_pic2=check_pic2,
            use_text_box2=use_text_box2)
        
        if ret == "START":
            self.Common_current_state = "COMMON_CHANGE_TIME"
            
    if self.Common_current_state == "COMMON_START":
        return "START"
    else:
        return "EXEC"
def ZA_Common_event_marker_check(self,othermap="POKEMON_ZA_FALSE_RETURN",markertype=0):
    self.wait(1.0)#self.wait(self.SLEEPLIST[7][2])
    if self.image_check("POKEMON_ZA_MAP2") or self.image_check(othermap):      
        self.wait(1.0)
        for i in range(5):
            self.press(Direction(Stick.RIGHT,270,2.0), duration=0.01, wait=0.0)
        
        self.wait(1.0)
        #EVENTMARKER_CHECK
        if markertype==0 and self.image_check("POKEMON_ZA_EVENT_MARKER_RANGE"):
            self.ZA_renda_button(rendabutton="B",endpicture="POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK") #FIELDから変更
            return "COMMON_START"
        
    self.ZA_renda_button(rendabutton="B",endpicture="POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK") #FIELDから変更
    return "COMMON_FALSE_RETURN"
def ZA_Common_false_return(self,othermap="POKEMON_ZA_FALSE_RETURN"):#dummy
    return "COMMON_FALSE_RETURN"
def ZA_Common_goto_defeat_recovery(self, recovery):
    """Handle the two defeat comments before allowing a goto retry."""
    phase = recovery.get("defeat_phase")
    black_comment = self.image_check("POKEMON_ZA_TEXT_BLACK_COMMENT")
    if phase is None:
        # 黒背景／通常会話だけでは敗北としない。専用文言を一度確認
        # した後は、文言が消えても黒Commentが続く間ラッチを保持する。
        if not black_comment:
            recovery.pop("defeat_started", None)
            return False
        if "defeat_started" not in recovery:
            if not self.image_check("POKEMON_ZA_FURADARI_EYES_DARK_COMMENT"):
                return False
            recovery["defeat_started"] = time.monotonic()
            self.ZA_MOVE_SEE("END")
            self.ZA_ZL_ACTION("END")
        recovery["clear_count"] = 0
        # 既存フラダリ専用復帰と同じ30秒確認。通常Stepは進めない。
        if time.monotonic() - recovery["defeat_started"] < 30.0:
            self.wait(0.1)
            return True
        self.checkIfAlive()
        self.pressRep(
            Button.B, repeat=1, duration=0.15, wait=0.1, interval=0.1)
        recovery["defeat_phase"] = "WAIT_INITIAL_BLACK_CLEAR"
        print("[COMMON_GOTO_DEFEAT] initial B; wait for load")
        return True

    recovery["clear_count"] = 0
    if phase == "WAIT_INITIAL_BLACK_CLEAR":
        if not black_comment:
            recovery["defeat_phase"] = "WAIT_POST_LOAD_BLACK_COMMENT"
        self.wait(0.1)
        return True
    if phase == "WAIT_POST_LOAD_BLACK_COMMENT":
        if not black_comment:
            self.wait(0.1)
            return True
        recovery["defeat_phase"] = "CLOSE_POST_LOAD_COMMENT"
        recovery["defeat_b_count"] = 0
        phase = "CLOSE_POST_LOAD_COMMENT"
        print("[COMMON_GOTO_DEFEAT] post-load comment detected")

    if phase == "CLOSE_POST_LOAD_COMMENT":
        def restored_field():
            return (
                not self.image_check("POKEMON_ZA_TEXT_BLACK_COMMENT")
                and self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK_0"))

        # 2回目のComment検知後だけ、最大70回・1秒間隔のBでFIELDへ。
        # 1周期1入力とし、毎回FIELDを再確認してから次の入力を判断する。
        field_visible = restored_field()
        if not field_visible and recovery["defeat_b_count"] < 70:
            self.checkIfAlive()
            self.pressRep(
                Button.B, repeat=1, duration=0.15,
                wait=0.85, interval=1.0)
            recovery["defeat_b_count"] += 1
            field_visible = restored_field()
        if field_visible:
            for key in ("defeat_phase", "defeat_started", "defeat_b_count"):
                recovery.pop(key, None)
            print("[COMMON_GOTO_DEFEAT] FIELD restored; verify before retry")
            return False
    self.wait(0.1)
    return True

def ZA_Common_battle_return(self):
    """Clear a blocked ordinary goto, then retry the same destination."""
    recovery_state = "COMMON_BATTLE_RETURN"
    self.checkIfAlive()
    recovery = getattr(self, "_za_common_goto_recovery", None)
    if not isinstance(recovery, dict):
        recovery = {"b_count": 0, "clear_count": 0}
        self._za_common_goto_recovery = recovery
    self._za_common_goto_retry_pending = True

    if self.ZA_Common_goto_defeat_recovery(recovery):
        return recovery_state

    # 通常goto専用。FURADARIの復旧状態やその移動先は変更しない。
    # 警告／マップが残る場合だけBを最大30回、毎周期1回ずつ送る。
    if any(self.image_check(picture) for picture in (
            "POKEMON_ZA_MOVE_COMMENT_BATTLE", "POKEMON_ZA_MAP",
            "POKEMON_ZA_MAP2", "POKEMON_ZA_MOVE_COMMENT")):
        recovery["clear_count"] = 0
        if recovery["b_count"] < 30:
            self.pressRep(
                Button.B, repeat=1, duration=0.15,
                wait=0.1, interval=0.1)
            recovery["b_count"] += 1
        self.wait(0.1)
        return recovery_state

    def field_ready():
        # 背景にFIELDが見える会話・選択肢では攻撃しない。
        return (
            not any(self.image_check(picture) for picture in (
                "POKEMON_ZA_X_MENU_OPEN", "POKEMON_ZA_HELP_MARKER",
                "POKEMON_ZA_TEXT_BLACK_COMMENT",
                "POKEMON_ZA_TEXT_WHITE_COMMENT",
                "POKEMON_ZA_TEXT_GREEN_COMMENT",
                "POKEMON_ZA_1_SELECT", "POKEMON_ZA_2_SELECT",
                "POKEMON_ZA_3_SELECT", "POKEMON_ZA_4_SELECT"))
            and self.image_check("POKEMON_ZA_FILED_HARD_CHECK_0"))

    def threat_visible():
        return any(self.image_check(picture) for picture in (
            "POKEMON_ZA_EYE_CHECK_HIGH", "POKEMON_ZA_EYE_CHECK",
            "POKEMON_ZA_EYE_CHECK_HIGH_POKE",
            "POKEMON_ZA_BATTLE_BALL_CHECK", "POKEMON_ZA_ESCAPE"))

    if not field_ready():
        recovery["clear_count"] = 0
        self.wait(0.1)
        return recovery_state

    if not threat_visible():
        if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK"):
            recovery["clear_count"] += 1
        else:
            recovery["clear_count"] = 0
        if recovery["clear_count"] >= 3:
            self.ZA_MOVE_SEE("END")
            self.ZA_ZL_ACTION("END")
            self.battlecheck = 0
            self.battle_step_return = 0
            self.inactioncount = 0
            self.map_cursor_reset = 0
            self.sleepcount = 0
            self._za_common_goto_recovery = None
            print(
                "[COMMON_GOTO_RECOVERY] threat cleared; "
                "retry the same destination")
            # 移動成功ではない。呼出元は同じStepに留まり、再度gotoする。
            return "COMMON_MAP_OPEN"
        self.wait(0.1)
        return recovery_state

    recovery["clear_count"] = 0
    # 既存の警告復旧と同じ視点方向・ロックオン先・X/A/Bを使用する。
    # 通常gotoでは各周期で必ず保持を解放し、未知画面へ持ち越さない。
    self.ZA_MOVE_SEE("END")
    self.ZA_ZL_ACTION("END")
    if self.image_check("POKEMON_ZA_FIELD_W"):
        self.etc_sendCommand("Lbutton_up")
    self.press(
        Direction(Stick.RIGHT, 180, 0.6), duration=0.2, wait=0.1)
    marker_direction = None
    try:
        if not field_ready() or not threat_visible():
            return recovery_state
        self.ZA_ZL_ACTION("")
        self.wait(0.1)
        marker_direction = self.ZA_infi_target_marker_direction()
        if marker_direction:
            self.hold(marker_direction)
        for button in (Button.X, Button.A, Button.B):
            self.checkIfAlive()
            if (not field_ready() or not threat_visible()
                    or not self.ZA_infi_attack_ready()):
                break
            self.pressRep(
                button, repeat=1, duration=0.04,
                wait=0.0, interval=0.1)
        self.wait(0.1)
    finally:
        if marker_direction:
            self.holdEnd(marker_direction)
        self.ZA_ZL_ACTION("END")
    return recovery_state

def ZA_Common_goto(
        self, position1, position2left, position2down,
        movepoint_check=0,
        check_pic1="POKEMON_ZA_FALSE_RETURN",
        check_pic2="POKEMON_ZA_FALSE_RETURN",
        othermap="POKEMON_ZA_FALSE_RETURN",
        select1_position0_direct=0,
        battle_recovery_mode=0,
        use_text_box2=True):
    #type=0:ポケセンブルーにて実施(バトルゾーンに影響あり)
    mapping_goto_black_recovery = getattr(
        self, "ZA_Common_mapping_goto_black_recovery", None)
    if (self.Common_current_state != "COMMON_BATTLE_RETURN"
            and callable(mapping_goto_black_recovery)
            and mapping_goto_black_recovery(
                movepoint_check=movepoint_check)):
        return "EXEC"
    if self.Common_current_state == "COMMON_MAP_OPEN":
        self.Common_current_state = self.ZA_Common_map_open(
            check_pic1=check_pic1, check_pic2=check_pic2,
            othermap=othermap, use_text_box2=use_text_box2)
    elif self.Common_current_state == "COMMON_GOTO_SELECT1":
        self.Common_current_state = self.ZA_Common_goto_select1(
            position1,othermap=othermap,
            select_position0_direct=select1_position0_direct)
    elif self.Common_current_state == "COMMON_GOTO_SELECT2":
        self.Common_current_state = self.ZA_Common_goto_select2(
            position2left, position2down, movepoint_check,
            othermap=othermap,
            battle_recovery_mode=battle_recovery_mode)
    elif self.Common_current_state == "COMMON_FURADARI_MAP_BATTLE_RECOVERY":
        self.Common_current_state = self.ZA_Common_furadari_map_battle_recovery()
    else:
        self.Common_current_state = self.STATE_COMMON_FUNCTION[self.Common_current_state]()

    if movepoint_check==1 and self.Common_current_state == "COMMON_GOTO_JUMP":#移動先画像チェック用
        self.Common_current_state = "COMMON_START"#画像位置で停止するが、移動するかは確定出ないためstartに戻す。(移動の際は移動関数を直接叩く)
        return "MOVEPOINT_PIC"
    elif ((self.Common_current_state == "COMMON_CHANGE_TIME") or (self.Common_current_state == "COMMON_CHECK_TIME")):
        self.Common_current_state = "COMMON_START"
        return "START"
    else:
        return "EXEC"
def ZA_Common_pokemon_recovery(self,timeout_seconds=0.0,require_entry_picture=False):  
    # A待ちの再入場では、済んだ方向移動を繰り返さない。
    if self.ZA_story_movement_a_pending('ZA_Common_pokemon_recovery'):
        return self.ZA_story_resume_movement_a('ZA_Common_pokemon_recovery')
    renda_options = {}
    if float(timeout_seconds) > 0.0:
        renda_options["timeout_seconds"] = float(timeout_seconds)
    if require_entry_picture:
        renda_options["require_entry_picture"] = True
    if self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK"): #FIELDから変更
        self.press(Direction(Stick.LEFT, 90), duration=2.0, wait=0.1)
        def _after_checked_a_1():
            self.pressRep(Button.A, repeat=10, duration=0.15, wait=0.2, interval=0.1)
            if self.ZA_renda_button(rendabutton="B",endpicture="POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK",sub_button="A",sub_picture="POKEMON_ZA_TEXT_BLACK_COMMENT",sub2_button="A",sub2_picture="POKEMON_ZA_HELP_MARKER",**renda_options): #FIELDから変更
                return True
            if renda_options:
                return False
            return False
        return self.ZA_story_checked_movement_action(
            'ZA_Common_pokemon_recovery', ('POKEMON_ZA_CHAT_MARKER',),
            _after_checked_a_1, False, allow_recenter=False)
    else:
        return False
def ZA_story_wait_movement_a(self, pictures=("POKEMON_ZA_IN_MARKER",), timeout=3.0):
    """Fixed endpoints may wait; timeout=0 performs exactly one immediate check."""
    timeout=max(0.0,float(timeout))
    self.checkIfAlive()
    if timeout == 0.0:
        if bool(getattr(self, "Debug_A_Check", False)):
            try:
                from Commands.PythonCommands.LocalFunction import ActionPromptCheck as action_prompt
            except ModuleNotFoundError as error:
                if error.name not in ("Commands", "Commands.PythonCommands",
                                      "Commands.PythonCommands.LocalFunction",
                                      "Commands.PythonCommands.LocalFunction.ActionPromptCheck"):
                    raise
                from LocalFunction import ActionPromptCheck as action_prompt
            return action_prompt.check_action_prompt(self, pictures, count_attempt=True)
        return self.ZA_story_movement_a_check(pictures)
    context_getter=getattr(self,"ZA_story_movement_a_context",None)
    context=(context_getter() if callable(context_getter) else
             (getattr(self,"_za_story_pre_step_gate_last_dispatch_state",None),))
    key=(context,tuple(pictures))
    timers=getattr(self,"_za_movement_a_wait_timers",{})
    # A previous Step/endpoint must never supply the next endpoint's timeout.
    timers={k:v for k,v in timers.items() if k[0]==context}
    self._za_movement_a_wait_timers=timers
    started=timers.setdefault(key,time.monotonic())
    deadline=time.monotonic()+timeout
    while True:
        self.checkIfAlive()
        if self.ZA_story_movement_a_check(pictures):
            self.checkIfAlive()
            if time.monotonic() <= deadline:
                timers.pop(key,None)
                self._za_movement_a_failure=None
                return True
        remaining=deadline-time.monotonic()
        if remaining<=0.0:
            break
        self.wait(min(.1,remaining))
    debug_ready = True
    if bool(getattr(self, "Debug_A_Check", False)):
        try:
            from Commands.PythonCommands.LocalFunction import ActionPromptCheck as action_prompt
        except ModuleNotFoundError as error:
            if error.name not in ("Commands", "Commands.PythonCommands",
                                  "Commands.PythonCommands.LocalFunction",
                                  "Commands.PythonCommands.LocalFunction.ActionPromptCheck"):
                raise
            from LocalFunction import ActionPromptCheck as action_prompt
        if action_prompt.check_action_prompt(self, pictures, count_attempt=True):
            timers.pop(key, None)
            self._za_movement_a_failure = None
            return True
        # Finish the third logical trial before scheduling ordinary recovery.
        detail = getattr(self, "last_action_prompt_detection", {})
        debug_ready = detail.get("attempt", 0) >= 3
    if (time.monotonic()-started>=12.0 and debug_ready
            and not getattr(self,"_za_movement_a_failure",None)):
        self._za_movement_a_failure={
            "dispatch":getattr(self,"_za_story_pre_step_gate_last_dispatch_state",None),
            "context":context,"pictures":tuple(pictures)}
    return False

def ZA_story_movement_a_check(self, pictures):
    """Compare A+word references on one fresh frame without glyph substitution."""
    try:
        from Commands.PythonCommands.LocalFunction import ActionPromptCheck as action_prompt
    except ModuleNotFoundError as error:
        if error.name not in ("Commands", "Commands.PythonCommands",
                              "Commands.PythonCommands.LocalFunction",
                              "Commands.PythonCommands.LocalFunction.ActionPromptCheck"):
            raise
        from LocalFunction import ActionPromptCheck as action_prompt
    return action_prompt.check_action_prompt(self, pictures, count_attempt=False)

def ZA_story_note_mapping_a(self, state, pic1, pic2):
    """Record one verified A route for its matching registration check only."""
    session = getattr(self, "_native_image_collection", None)
    options = getattr(session, "options", None)
    if not getattr(options, "supplemental", False):
        self._za_mapping_a_proof = None
        return
    self._za_mapping_a_proof = {
        "state": str(state), "pictures": (str(pic1), str(pic2)),
        "session": session, "expires": time.monotonic() + 180.0,
    }

def ZA_story_mapping_a_succeeded(self, pic1, pic2):
    """A proof does not bypass map opening, travel confirmation, or battle guards."""
    proof = getattr(self, "_za_mapping_a_proof", None)
    session = getattr(self, "_native_image_collection", None)
    if (not isinstance(proof, dict)
            or not getattr(getattr(session, "options", None), "supplemental", False)):
        return False
    state = getattr(self, "_za_story_pre_step_gate_last_dispatch_state", None)
    if (proof.get("session") is not session
            or time.monotonic() > proof.get("expires", 0.0)
            or proof.get("state") != state):
        self._za_mapping_a_proof = None
        return False
    if proof.get("pictures") != (str(pic1), str(pic2)):
        return False
    print("[MAPPING_A_CONFIRMED] {}: 日本語の場所名・プレビュー確認を代用".format(state))
    return True

def ZA_story_movement_a_context(self):
    return tuple(getattr(self, name, None) for name in (
        "_za_story_pre_step_gate_last_dispatch_state", "Common_current_state",
        "za_infi_main_current_state", "bench_current_state", "quasar_current_state"))

def ZA_story_movement_a_pending(self, key):
    """Only resume the action belonging to this movement endpoint."""
    pending = getattr(self, "_za_movement_a_pending", None)
    if not isinstance(pending, dict) or pending.get("key") != key:
        return False
    if pending.get("context") != self.ZA_story_movement_a_context():
        self._za_movement_a_pending = None
        return False
    return True

def ZA_story_resume_movement_a(self, key):
    """Recheck at the endpoint; do not replay the movement or earlier A inputs."""
    if not self.ZA_story_movement_a_pending(key):
        raise RuntimeError("Movement A continuation is no longer valid: " + key)
    pending = self._za_movement_a_pending
    if not self.ZA_story_wait_movement_a(pending["pictures"], timeout=3.0):
        # Only callers whose existing next step handles this white dialogue opt
        # in. This is not an A success and never creates map registration proof.
        if (pending.get("dialogue_state")
                and self.image_check("POKEMON_ZA_TEXT_WHITE_COMMENT")):
            self._za_movement_a_pending = None
            print("[MOVEMENT_A_DIALOGUE] {}: 会話開始済み。入口Aを省略".format(key))
            return pending["dialogue_state"]
        # The ZIP videos also show a wall/player obscuring a ladder or doorway.
        # Recenter only once, only on a confirmed non-battle field. Never move,
        # reset the game, or recenter during a dialogue/battle while awaiting A.
        if (pending.get("allow_recenter", True) and not pending.get("recentered")
                and self.image_check("POKEMON_ZA_NO_BATTLE_FIELD_HARD_CHECK")):
            self.checkIfAlive()
            pending["recentered"] = True
            self.pressRep(Button.L, repeat=1, duration=0.15, wait=0.5, interval=0.1)
        if not pending.get("reported"):
            print("[MOVEMENT_A_WAIT] {}: A表示未検知。移動を繰り返さず到着位置で再確認".format(key))
            pending["reported"] = True
        return pending["waiting_result"]
    self.checkIfAlive()
    # Clear before invoking: the continuation may reach another guarded endpoint.
    self._za_movement_a_pending = None
    return pending["action"]()

def ZA_story_checked_movement_action(self, key, pictures, action, waiting_result,
                                    dialogue_state=None, allow_recenter=True):
    """Guard an explicit fixed-movement action, never a dialogue/search loop."""
    try:
        from Commands.PythonCommands.LocalFunction import ActionPromptCheck as action_prompt
    except ModuleNotFoundError as error:
        if error.name not in ("Commands", "Commands.PythonCommands",
                              "Commands.PythonCommands.LocalFunction",
                              "Commands.PythonCommands.LocalFunction.ActionPromptCheck"):
            raise
        from LocalFunction import ActionPromptCheck as action_prompt
    source = action_prompt.capture_action_prompt_source(self, pictures, key, action)
    self._za_movement_a_wait_timers = {}
    self._za_movement_a_failure = None
    self._za_movement_a_pending = {
        "_action_prompt_source": source,
        "key": key, "pictures": tuple(pictures), "action": action,
        "waiting_result": waiting_result,
        "dispatch": getattr(self, "_za_story_pre_step_gate_last_dispatch_state", None),
        "context": self.ZA_story_movement_a_context(),
        "dialogue_state": dialogue_state,
        "allow_recenter": allow_recenter,
    }
    return self.ZA_story_resume_movement_a(key)

def ZA_story_map_confirmation_ready(self):
    session = getattr(self, "_native_image_collection", None)
    if not getattr(getattr(session, "options", None), "supplemental", False):
        return self.image_check("POKEMON_ZA_MOVE_COMMENT")
    self._za_supplemental_map_confirmation = "UNKNOWN"
    warning = getattr(session, "map_warning_observation", None)
    deadline = time.monotonic() + 3.0
    while time.monotonic() < deadline:
        self.checkIfAlive()
        menu = session.choice_observation(self, read_command_frame, "map")
        if menu and menu["rows"] == 2:
            if menu["selected"] == 0:
                # Go through image_check for same-frame capture/diagnostics.
                if self.image_check("POKEMON_ZA_MOVE_COMMENT"):
                    self._za_supplemental_map_confirmation = "CONFIRM"
                    return True
            else:
                self.etc_sendCommand("Lbutton_up")
                self.wait(0.2)
        if callable(warning):
            warning(self, read_command_frame)
        self.wait(0.1)
    if callable(warning) and warning(self, read_command_frame):
        self._za_supplemental_map_confirmation = "BLOCKED"
        print("[SUPPLEMENTAL_MAP] map comment without 2_SELECT for 3s; blocked travel")
    return False

def ZA_Common_mappic_check(self,pic1="NULL",pic2="NULL"):
    supplemental = getattr(self, "_native_image_collection", None)
    if getattr(getattr(supplemental, "options", None), "supplemental", False):
        # 指定goto直後・歩行なしで15番内にいることを呼出し側で保証。
        if (pic1, pic2) == ("POKEMON_ZA_MOVEPOINT_TARGET_W_ZONE15", "POKEMON_ZA_MOVEPOINT_PIC_W_ZONE15"):
            return True
        # Cafe Batailleは場所名を使わず、引き続きプレビューで確認する。
        if pic1 == "POKEMON_ZA_MOVEPOINT_TARGET_CAFE_BATAILLE":
            pic1 = "NULL"
    substitute = getattr(self, "ZA_story_mapping_a_succeeded", None)
    if callable(substitute) and substitute(pic1, pic2):
        return True
    for i in range(1,10):
        if ((pic1=="NULL" or self.image_check(pic1)) and (pic2=="NULL" or self.image_check(pic2))):
            return True
        self.wait(0.1)
    return False
def ZA_Common_Event_check(self,othermap="POKEMON_ZA_FALSE_RETURN",markertype=0):
    if self.Common_current_state == "COMMON_EVENT_MARKER_CHECK":
        self.Common_current_state = self.ZA_Common_event_marker_check(othermap=othermap,markertype=markertype)
    elif self.Common_current_state == "COMMON_START":   
        self.Common_current_state = self.STATE_COMMON_FUNCTION[self.Common_current_state]()
    else:
        self.Common_current_state = self.STATE_COMMON_FUNCTION[self.Common_current_state](othermap=othermap)

    if self.Common_current_state == "COMMON_GOTO_SELECT1":
        self.Common_current_state = "COMMON_EVENT_MARKER_CHECK"
    
    if self.Common_current_state == "COMMON_START":
        return "START"
    elif self.Common_current_state == "COMMON_FALSE_RETURN":
        self.Common_current_state = "COMMON_START"
        return "FALSE"
    else:
        return "EXEC"


######################################################
# ZA_battle_infi_Base
######################################################
######################################################
# BENCH FUNCTION
######################################################

def ZA_story_supplemental_filter(self, position, current_state, next_state, othermap="POKEMON_ZA_FALSE_RETURN"):
    """MAP_6_SELECT: observe, move one row, re-observe, then confirm."""
    session = self._native_image_collection
    if not (self.image_check("POKEMON_ZA_MAP2") or self.image_check(othermap)):
        return None
    menu = session.choice_observation(self, read_command_frame, "filter")
    if menu is not None and menu["rows"] == 6:
        if menu["selected"] == 0:
            self.image_check("POKEMON_ZA_SELECT_ALL")
        if menu["selected"] != position:
            self.etc_sendCommand("Lbutton_up" if menu["selected"] > position else "Lbutton_down")
            self.wait(0.2)
            return current_state
        self.checkIfAlive()
        fresh = session.choice_observation(self, read_command_frame, "filter")
        if fresh and fresh["rows"] == 6 and fresh["selected"] == position:
            self.pressRep(Button.A, repeat=1, duration=0.15, wait=0.3, interval=0.1)
            return next_state
        return current_state
    if self.image_check("POKEMON_ZA_MOVESPOT_TAB"):
        self.pressRep(Button.MINUS, repeat=1, duration=0.15, wait=0.5, interval=0.1)
    else:
        self.pressRep(Button.Y, repeat=1, duration=0.15, wait=0.3, interval=0.1)
    return current_state


def ZA_story_movement_a_timeout_recovery(self,current_state,normal_return):
    """Use reviewed recovery origins after A expiry, never execute the A action."""
    failure=getattr(self,"_za_movement_a_failure",None)
    if not isinstance(failure,dict):
        return None
    if (failure.get("dispatch")!=current_state or normal_return!=current_state
            or (failure.get("context") is not None
                and failure["context"] != self.ZA_story_movement_a_context())):
        self._za_movement_a_failure=None
        self._za_movement_a_wait_timers={}
        return None
    # Filled from existing validated checkpoints / adjacent teleport routes.
    route=self.ZA_story_movement_a_recovery_route(current_state)
    if route is None:
        if not failure.get("reported"):
            print("[MOVEMENT_A_RECOVERY_UNRESOLVED] {}: 復旧位置未検証。Aを送らず再確認".format(current_state))
            failure["reported"]=True
        return None
    target,action,reset_common,_checkpoint=route
    self._za_movement_a_pending=None
    self._za_movement_a_failure=None
    self._za_movement_a_wait_timers={}
    self._za_mapping_a_proof=None
    self._ZA_story_release_recovery_controls("movement_a:"+str(current_state))
    if reset_common:
        self._ZA_story_reset_common_navigation_state("movement_a:"+str(current_state))
    print("[MOVEMENT_A_RECOVERY] {} -> {} action={}".format(current_state,target,action))
    self._ZA_story_schedule_event_entry_recovery(
        current_state=current_state,recovery_target=target,
        recovery_kind="movement_a",recovery_action=action)
    return self._ZA_story_event_entry_pending_recovery_step(current_state)

def ZA_story_movement_a_local_recovery(self, keys, retry_state):
    """Restart local map navigation without mistaking it for time-change success."""
    pending=getattr(self,"_za_movement_a_pending",None)
    failure=getattr(self,"_za_movement_a_failure",None)
    if not isinstance(pending,dict) or not isinstance(failure,dict):
        return None
    if (pending.get("key") not in keys
            or pending.get("context") != self.ZA_story_movement_a_context()
            or failure.get("context") != pending.get("context")):
        return None
    self.checkIfAlive()
    self._za_movement_a_pending=None
    self._za_movement_a_failure=None
    self._za_movement_a_wait_timers={}
    self._za_mapping_a_proof=None
    release=getattr(self,"_ZA_story_release_recovery_controls",None)
    if callable(release):
        release("movement_a_local")
    reset=getattr(self,"_ZA_story_reset_common_navigation_state",None)
    if callable(reset):
        reset("movement_a_local")
    else:
        # Portable bench fragments do not contain the Story recovery helpers.
        # The fixed press movements have already released their controls.
        self.Common_current_state="COMMON_START"
        self.map_cursor_reset=0
        self.timecount=0
        self.changetimecount=0
        self.sleepcount=0
        self.battlecheck=0
        self.battle_step_return=0
        self.inactioncount=0
    print("[MOVEMENT_A_RECOVERY] {} -> {}".format(pending["key"],retry_state))
    return retry_state


